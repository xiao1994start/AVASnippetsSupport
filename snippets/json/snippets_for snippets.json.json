{
  "snippets.language 代码片段语言": {
    "prefix": ["language_"],
    "body": [
      "{",
      "  \"language\": \"${1|bat,python,renpy,typescript,javascript,vue,json,snippets|}\",",
      "  \"path\": \"./${0}\"",
      "},"
    ],
    "description": ["代码片段语言"]
  },
  "snippets.new 新建代码片段": {
    "prefix": ["new_snippets_"],
    "body": [
      "\"描述\": {",
      "  \"prefix\": [\"${2:钩子}\"],",
      "  \"body\": [",
      "    \"${0}\"",
      "  ],",
      "  \"description\": [\"描述\"]",
      "},"
    ],
    "description": ["snippets.new 新建代码片段"]
  },
  "snippets.插入": {
    "prefix": ["iii_$插入"],
    "body": ["${${1:1}:${2}}"],
    "description": ["插入"]
  },
  "snippets.选择": {
    "prefix": ["ccc_$选择"],
    "body": ["${${1:1}|${2:a},${3:b}|}"],
    "description": ["选择"]
  },
  "snippets.结束位置": {
    "prefix": ["eee_$结束位置"],
    "body": ["\\${0}"],
    "description": ["结束位置"]
  }
}
