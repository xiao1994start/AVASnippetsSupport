{
  "创建 class Config 单实例对象": {
    "prefix": ["class Config -class"],
    "body": [
      "class Config:",
      "    \"\"\"# 配置管理器（单例模式）",
      "    - 全局统一管理存储配置",
      "    - 确保在多模块、多脚本导入时数据保持一致",
      "    - 提供属性式访问和传统函数式访问两种方式",
      "    \"\"\"",
      "",
      "    # ==================== 单例相关 ====================",
      "    _instance = None  # 单例实例引用标识(静态类型检查)",
      "    # ==================== 全局状态存储 ====================",
      "    _cwd: Path = Path.cwd()  # 当前工作目录，默认初始化为程序启动时的 cwd",
      "    _game_root = Path()  # 游戏根目录，默认初始化为空路径",
      "",
      "    def __new__(cls):",
      "        \"\"\"# 控制实例创建，实现单例模式",
      "        **执行步骤：**",
      "        1. 检查是否已存在实例 (_instance) [静态类型检查]",
      "        2. 如果不存在，则通过 super().__new__ 创建新实例",
      "        3. 保存实例引用并返回",
      "        4. 后续所有调用均返回同一实例，保证全局数据一致性",
      "",
      "        Returns:",
      "            Self: 类自身实例",
      "        \"\"\"",
      "        if cls._instance is None:",
      "            # 首次调用时真正创建实例",
      "            cls._instance = super().__new__(cls)",
      "        # 返回已有的单例实例",
      "        return cls._instance",
      "",
      "    @property",
      "    def cwd(self):",
      "        \"\"\"# 获取当前工作目录",
      "",
      "        Returns:",
      "            Path: 当前设置的工作目录（已解析为绝对路径）",
      "        \"\"\"",
      "        return self._cwd",
      "",
      "    @cwd.setter",
      "    def cwd(self, new_path: Path):",
      "        \"\"\"# 设置当前工作目录",
      "        **执行步骤：**",
      "        1. 确保输入转换为 Path 对象",
      "        2. 调用 .resolve() 将路径转为绝对路径并解析符号链接",
      "        3. 更新内部存储 _cwd",
      "",
      "        Args:",
      "            new_path (Path): 新的工作目录路径",
      "        \"\"\"",
      "        self._cwd = new_path.resolve()",
      "",
      "    def reset(self):",
      "        \"\"\"# 重置路径管理器到初始状态",
      "        **执行步骤：**",
      "        - 将 cwd 重置为程序当前实际工作目录",
      "        - 将 game_root 重置为空路径",
      "        \"\"\"",
      "        self._cwd = Path.cwd()",
      "        self._game_root = Path()",
      "",
      "",
      "# ================ 全局便捷实例 ================",
      "config = Config()",
      "",
      "",
      "# ================ 兼容原有函数式调用接口 ================",
      "def get_cwd():",
      "    \"\"\"# 获取当前的全局 cwd\"\"\"",
      "    return config.cwd",
      "",
      "",
      "def set_cwd(new_path: Path):",
      "    \"\"\"# 设置当前的全局 cwd\"\"\"",
      "    config.cwd = new_path",
      "    return config.cwd",
      ""
    ],
    "description": ["创建 class 单实例对象"]
  },
