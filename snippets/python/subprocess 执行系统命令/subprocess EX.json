{
  "subprocess.run 调用 cURL 下载文件": {
    "prefix": ["subprocess run curl -cmd"],
    "body": ["subprocess.run(f'curl -SL {url} -o \"{save_file}\"')"],
    "description": ["subprocess.run 调用 cURL 下载文件"]
  },
  "subprocess.run 删除📂文件夹": {
    "prefix": ["subprocess run rd -cmd"],
    "body": ["subprocess.run(f'rd /S /Q \"{文件夹_路径}\"', shell=True)"],
    "description": ["subprocess.run 删除📂文件夹"]
  },
  "subprocess.run 删除📃文件": {
    "prefix": ["subprocess run del -cmd"],
    "body": ["subprocess.run(f'del /F /Q \"{文件_路径}\"', shell=True)"],
    "description": ["subprocess.run 删除📃文件"]
  },
  "subprocess.run 复制📃文件": {
    "prefix": ["subprocess run copy -cmd"],
    "body": ["subprocess.run(f'copy /V /Y \"{copy_from}\" \"{copy_to}\"', shell=True)"],
    "description": ["subprocess.run 复制📃文件"]
  },
  "subprocess.run 解压📃文件": {
    "prefix": ["subprocess run 7z x -cmd"],
    "body": ["subprocess.run(f'\"{7za_7zr}\" x \"{z_file}\" -o\"{out_file}\" -y')"],
    "description": ["subprocess.run 解压📃文件"]
  },
  "subprocess.run 压缩📃文件": {
    "prefix": ["subprocess run 7z a -cmd"],
    "body": ["subprocess.run(f'\"{7za_7zr}\" a \"{out_7z_file}\" \"{压缩的文件或目录}\" -r')"],
    "description": ["subprocess.run 压缩📃文件"]
  },
  "subprocess.run robocopy复制文件或文件夹": {
    "prefix": ["subprocess robocopy -cmd"],
    "body": ["subprocess.run(f'robocopy \"{copy_from}\" \"{copy_to}\" /E /MIR /MT:16', shell=True)"],
    "description": ["subprocess.run robocopy复制文件或文件夹"]
  }
}
