{
  "python 环境初始化 (嵌入式环境不能使用 Tk/Nuitka)": {
    "prefix": "py_uv =-python",
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "",
      "",
      "@REM ====================== 基础环境配置 ======================",
      "@REM ; 记录 嵌入式环境",
      "set is_embed=0",
      "@REM ! Tkinter/Nuitka：使用Sandboxie-Plus沙箱提取安装版",
      "@REM * Python解释器名称标准化",
      "for /D %%i in (\"*python*\") do ( ren \"%%i\" \"python\" )",
      "",
      "@REM * 初始化 .vscode 配置文件",
      "if not exist \"%~dp0.vscode\" ( ECHO 初始化 .vscode 配置文件 && md \"%~dp0.vscode\" )",
      "(   ECHO {",
      "    ECHO   \"python.defaultInterpreterPath\": \"\\${workspaceFolder}/python/python.exe\",",
      "    ECHO   \"terminal.integrated.env.windows\": { \"PYTHONPATH\": \"\\${workspaceFolder}\" },",
      "    ECHO   \"qtForPython.designer.path\": \"\\${workspaceFolder}/python/Scripts/pyside6-designer.exe\",",
      "    ECHO   \"qtForPython.uic.path\": \"\\${workspaceFolder}/python/Scripts/pyside6-uic.exe\",",
      "    ECHO   \"qtForPython.rcc.path\": \"\\${workspaceFolder}/python/Scripts/pyside6-rcc.exe\",",
      "    ECHO   \"qtForPython.qml.path\": \"\\${workspaceFolder}/python/Scripts/pyside6-qml.exe\",",
      "    ECHO   \"python-envs.workspaceSearchPaths\": [\".venv\", \"*/.venv\", \"python\"]",
      "    ECHO }",
      "    ECHO. )> \"%~dp0.vscode\\settings.json\"",
      "@REM * 初始化 ./python/.ruff.toml",
      "if not exist \"%~dp0python\\.ruff.toml\" ( ECHO 初始化 ./python/.ruff.toml && type nul >\"%~dp0python\\.ruff.toml\" )",
      "",
      "@REM * 配置 Python 环境变量",
      "ECHO 配置 Python 环境变量",
      "set \"SYSTEM_PATH=%PATH%\"",
      "set \"PYTHON_PATH=%~dp0python\\;%~dp0python\\Scripts\\;\"",
      "set \"PATH=%PYTHON_PATH%;%SYSTEM_PATH%;\"",
      "ECHO 设置 uv 镜像源环境变量",
      "set UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/",
      "",
      "@REM * 嵌入式环境判断初始化",
      "for %%i in (\"%~dp0python\\python*._pth\") do (",
      "    ECHO 嵌入式环境：%%i【%%~ni】【%%~xi】",
      "    set is_embed=1",
      "    (   ECHO %%~ni.zip",
      "        ECHO .",
      "        ECHO # Uncomment to run site.main(^) automatically",
      "        ECHO import site",
      "        ECHO Lib/site-packages",
      "        ECHO DLLs",
      "        ECHO libs",
      "        ECHO tcl ) > \"%~dp0python\\%%~ni%%~xi\"",
      "    if not exist \"%~dp0python\\get-pip.py\" (",
      "        @REM ; 进入 python 目录(pip documentation:https://pip.pypa.io/en/stable/installation/ ^| 下载get-pip.py: https://www.python.org/downloads/windows/)",
      "        ECHO 配置 pip 镜像",
      "        ECHO [global]> \"%~dp0python\\pip.ini\"",
      "        ECHO index-url = https://mirrors.aliyun.com/pypi/simple/>> \"%~dp0python\\pip.ini\"",
      "        ECHO [install]>> \"%~dp0python\\pip.ini\"",
      "        ECHO trusted-host=mirrors.aliyun.com>> \"%~dp0python\\pip.ini\"",
      "        ECHO 获取 get-pip.py",
      "        @REM * -sSL (组合命令) --silent(静默模式) --show-error(静默模式下显示错误) --location(自动跟随重定向)",
      "        @REM ?     -s / --silent        静默模式, 隐藏进度条和冗余信息",
      "        @REM ?     -S / --show-error    即使静默模式仍显示错误信息. 便于发现问题",
      "        @REM ?     -L / --location      自动跟随重定向. 确保获取到最终资源",
      "        @REM ? -# / --progress-bar      强制显示进度条 (覆盖 -s 的限制)",
      "        @REM ? -o / --output            输出到指定文件",
      "        call curl -SL https://bootstrap.pypa.io/get-pip.py -o \"%~dp0python\\get-pip.py\"",
      "    )",
      "    ECHO 初始化 pip 环境",
      "    call python \"%~dp0python\\get-pip.py\" -i https://mirrors.aliyun.com/pypi/simple/",
      ")",
      "",
      "@REM * 环境测试",
      "if is_embed==1 (",
      "    @REM ; 嵌入式环境",
      "    call pip install \"pip\" \"setuptools\" \"uv\" \"rich\" --upgrade -i https://mirrors.aliyun.com/pypi/simple/",
      "    call python --version",
      "    call pip --version",
      ") else (",
      "    call python -m pip install \"pip\" \"setuptools\" \"uv\" \"rich\" --upgrade -i https://mirrors.aliyun.com/pypi/simple/",
      "    call python --version",
      "    call python -m pip --version",
      ")",
      "",
      "",
      "",
      "@REM ====================== 项目结构构建 ======================",
      "@REM * 创建项目基础目录结构",
      "@REM if not exist \"%~dp0src\" ( md \"%~dp0src\" )",
      "@REM if not exist \"%~dp0src\\assets\" ( md \"%~dp0src\\assets\" )",
      "@REM if not exist \"%~dp0src\\bin\" ( md \"%~dp0src\\bin\" )",
      "@REM * 创建 临时测试文件",
      "if not exist \"%~dp0tempTest.py\" ( ECHO 创建 tempTest.py 临时测试文件 && type nul >\"%~dp0tempTest.py\" )",
      "@REM *  创建 config.py 文件",
      "if not exist \"%~dp0config.py\" ( ECHO 创建 config.py 文件 && type nul >\"%~dp0config.py\" )",
      "@REM *  创建 build.py 文件",
      "if not exist \"%~dp0build.py\" ( ECHO 创建 build.py 文件 && type nul >\"%~dp0build.py\" )",
      "@REM *  创建 setup.py 文件",
      "if not exist \"%~dp0setup.py\" ( ECHO 创建 setup.py 文件 && type nul >\"%~dp0setup.py\" )",
      "@REM * 创建 Tk_test.py tkinter 测试文件",
      "if not exist \"%~dp0Tk_test.py\" (",
      "    ECHO 创建 Tk_test.py tkinter 测试文件",
      "    (   ECHO import tkinter as tk",
      "        ECHO # * tk_test",
      "        ECHO tk._test(^) )> \"%~dp0Tk_test.py\"",
      ")",
      "",
      "",
      "",
      "@REM ====================== uv构建虚拟环境 ======================",
      "ECHO 清理并重新创建虚拟环境",
      "if exist \"%~dp0.venv\" ( rd /S /Q \"%~dp0.venv\" )",
      "if exist \"%~dp0pyproject.toml\" ( del /F /Q \"%~dp0pyproject.toml\" ) && if exist \"%~dp0.python-version\" ( del /F /Q \"%~dp0.python-version\" ) && if exist \"%~dp0uv.lock\" ( del /F /Q \"%~dp0uv.lock\" )",
      "call uv cache clean",
      "ECHO 初始化 uv 项目... [`.`：默认当前文件夹]",
      "call uv init .",
      "ECHO 创建 uv 虚拟环境...",
      "call uv venv",
      "@REM ; 安装依赖库：使用虚拟环境开发时 requirements.txt",
      "if exist \"%~dp0requirements.txt\" ( call uv pip install -r \"%~dp0requirements.txt\" -i https://mirrors.aliyun.com/pypi/simple/ )",
      "ECHO.",
      "ECHO ----------------------------------------------------------------------------------------------",
      "",
      "",
      "$0",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "ECHO ----------------------------------------------------------------------------------------------",
      "ECHO.",
      "ECHO 全量升级所有依赖 并 同步到本地虚拟环境",
      "@REM * 基于 pyproject.toml 把项目所有依赖（直接依赖+间接依赖）全部升级到当前允许的最新兼容版本",
      "call uv lock --upgrade && call uv sync",
      "ECHO 导出依赖库 requirements.txt",
      "if is_embed==1 (",
      "    @REM ; 嵌入式环境",
      "    call uv export --no-hashes --output-file \"%~dp0requirements.txt\"",
      ") else ( call python -m uv export --no-hashes --output-file \"%~dp0requirements.txt\" )",
      "ECHO.",
      "ECHO =================================",
      "ECHO.",
      "ECHO      █████╗ ██╗   ██╗ █████╗",
      "ECHO     ██╔══██╗██║   ██║██╔══██╗",
      "ECHO     ███████║██║   ██║███████║",
      "ECHO     ██╔══██║╚██╗ ██╔╝██╔══██║",
      "ECHO     ██║  ██║ ╚████╔╝ ██║  ██║",
      "ECHO     ╚═╝  ╚═╝  ╚═══╝  ╚═╝  ╚═╝",
      "ECHO.",
      "ECHO =================================",
      "ECHO.",
      "endlocal",
      "EXIT /B",
      "@REM **********************************************************************************************",
      "@REM ! 目录提示",
      "@REM * 文档说明 : docs",
      "@REM * 核心代码 : src",
      "@REM * 静态资源 : src/assets",
      "@REM * 数据仓库 : data",
      "@REM * 配置文件 : conf",
      "@REM * 工具辅助 : utils",
      "@REM * 日志文件 : logs",
      "@REM * 临时文件 : temp",
      "@REM **********************************************************************************************",
      "@REM ! 路径只能包含:  , -, _, . 和 字母 数字 字符",
      "配置 Ruff [ruff.toml] [pyproject.toml] 格式化规则 ",
      "# 帮助文档: https://docs.astral.sh/ruff/configuration/",
      "",
      "[lint]",
      "select = [\"E4\", \"E7\", \"E9\", \"F\"]",
      "ignore = [\"Q000\", \"Q001\", \"Q002\", \"F401\", \"F403\", \"F404\", \"F405\", \"E402\"]",
      "fixable = [\"ALL\"]",
      "unfixable = []",
      "dummy-variable-rgx = \"^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$\"",
      "",
      "[format]",
      "quote-style = \"single\"",
      "indent-style = \"space\"",
      "skip-magic-trailing-comma = false",
      "line-ending = \"auto\"",
      "docstring-code-line-length = \"dynamic\"",
      "@REM **********************************************************************************************",
      ""
    ],
    "description": "python 环境初始化 (嵌入式环境不能使用 Tk/Nuitka)"
  }
}
