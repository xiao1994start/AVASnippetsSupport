    "prefix": ["getenv to Path", "getenv 2 Path", "path to Path", "path 2 Path"],
    "body": [
      "_path = os.getenv('${1|SYSTEMDRIVE,HOMEDRIVE,PROGRAMFILES,COMMONPROGRAMFILES,PROGRAMFILES(X86),ALLUSERSPROFILE,PROGRAMDATA,WINDIR,SYSTEMROOT,USERPROFILE,APPDATA,LOCALAPPDATA,PUBLIC|}')",
      "if _path:",
      "    _PATH = Path(_path, os.sep) if _path.endswith(':') else Path(_path)",
      "else:",
      "    cmd_stdout = subprocess.run('ECHO %${1|SYSTEMDRIVE,HOMEDRIVE,PROGRAMFILES,COMMONPROGRAMFILES,PROGRAMFILES(X86),ALLUSERSPROFILE,PROGRAMDATA,WINDIR,SYSTEMROOT,USERPROFILE,APPDATA,LOCALAPPDATA,PUBLIC|}%', capture_output=True, text=True).stdout.strip()",
      "    _PATH = Path(cmd_stdout, os.sep) if cmd_stdout.endswith(':') else Path(cmd_stdout)",
      ""
    ],
    "description": ["获取系统环境变量路径并转换为Path类型"]
