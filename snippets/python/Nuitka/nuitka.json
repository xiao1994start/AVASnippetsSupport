{
  "Nuitka 编译": {
    "prefix": ["nuitka main_setup"],
    "body": [
      "import logging",
      "import os",
      "import re",
      "import subprocess  # * 执行系统命令模块",
      "import sys",
      "import zipfile",
      "from pathlib import Path",
      "from time import perf_counter",
      "",
      "import requests",
      "from rich import print",
      "from rich.logging import RichHandler  # * 引入 rich 模块 logging 日志记录处理程序",
      "",
      "logging.basicConfig(",
      "    level=logging.INFO,  # * 日志级别[默认:WARNING](NOTSET,DEBUG,INFO,WARNING,ERROR,CRITICAL)",
      "    format='%(message)s',",
      "    datefmt='[%X]',",
      "    handlers=[RichHandler(rich_tracebacks=True)],",
      ")",
      "",
      "",
      "# ====================== 获取系统环境变量，定义全局变量 ======================",
      "LOCALAPPDATA = Path(str(os.environ.get('LOCALAPPDATA')))",
      "cwd = Path.cwd()",
      "",
      "gh = 'https://gh-proxy.org'  # 代理地址",
      "",
      "headers = {'User-Agent': 'Mozilla/5.0'}",
      "",
      "",
      "# ====================== 配置 Nuitka - Dependency Walker 环境 ======================",
      "def set_depends():",
      "    \"\"\"# 配置 Nuitka - Dependency Walker 环境\"\"\"",
      "    depends_path = Path(LOCALAPPDATA, 'Nuitka/Nuitka/Cache/downloads/depends/x86_64/')",
      "",
      "    depends_HTML = requests.get(url='https://dependencywalker.com/', headers=headers).text",
      "    pattern = re.compile(r'<a href=\"([^\"]+)\">')  # 编译正则：类似 <a href=\"depends22_x86.zip\">",
      "    depends_a_href = pattern.findall(depends_HTML)",
      "    depends_a_href = list(set([i for i in depends_a_href if str(i).endswith('_x86.zip')]))",
      "",
      "    depends_version = depends_a_href[0]",
      "",
      "    if not depends_path.exists(follow_symlinks=False):",
      "        depends_path.mkdir(parents=True, exist_ok=True)",
      "    depends_x86_zip = Path(depends_path, f'{depends_version}')",
      "",
      "    if not depends_x86_zip.exists(follow_symlinks=False):",
      "        print('下载|配置 Dependency Walker 环境')",
      "        url = f'https://dependencywalker.com/{depends_version}'",
      "        subprocess.run(f'curl -SL {url} -o \"{depends_x86_zip}\"')",
      "",
      "    with zipfile.ZipFile(depends_x86_zip) as zf:",
      "        zf.extractall(depends_path)  # 解压到目录",
      "",
      "",
      "# ====================== 配置 Nuitka - Cache 环境 ======================",
      "def set_cache():",
      "    \"\"\"# 配置 Nuitka - Cache 环境\"\"\"",
      "    ccache_path = Path(LOCALAPPDATA, 'Nuitka/Nuitka/Cache/downloads/ccache')",
      "    ccache_HTML = requests.get(url='https://ccache.dev/', headers=headers).text",
      "    pattern = re.compile(r'<b>Version (\\d+\\.\\d+(?:\\.\\d+)*) has been released</b>')  # 编译正则：类似 <b>Version 4.13.6 has been released</b>",
      "    ccache_Versions = pattern.findall(ccache_HTML)",
      "",
      "    ccache_version = ccache_Versions[0]",
      "    ccache_windows_x86_64 = Path(ccache_path, f'v{ccache_version}')",
      "",
      "    if not ccache_windows_x86_64.exists(follow_symlinks=False):",
      "        ccache_windows_x86_64.mkdir(parents=True, exist_ok=True)",
      "",
      "    ccache_windows_x86_64_zip = Path(ccache_windows_x86_64, f'ccache-{ccache_version}-windows-x86_64.zip')",
      "",
      "    if not ccache_windows_x86_64_zip.exists(follow_symlinks=False):",
      "        url = f'{gh}/https://github.com/ccache/ccache/releases/download/v{ccache_version}/ccache-{ccache_version}-windows-x86_64.zip'",
      "        print('下载|配置 Cache 环境')",
      "        subprocess.run(f'curl -SL {url} -o \"{ccache_windows_x86_64_zip}\"')",
      "",
      "    with zipfile.ZipFile(ccache_windows_x86_64_zip) as zf:",
      "        zf.extractall(ccache_windows_x86_64)  # 解压到目录",
      "        for i in Path(ccache_windows_x86_64, f'ccache-{ccache_version}-windows-x86_64').glob('*'):",
      "            subprocess.run(f'move /Y \"{i}\" \"{ccache_windows_x86_64}\"', shell=True)",
      "        subprocess.run(f'rd /S /Q \"{Path(ccache_windows_x86_64, f\"ccache-{ccache_version}-windows-x86_64\")}\"', shell=True)",
      "",
      "",
      "# ====================== 运行 msvc-kit 配置 MSVC C编译环境 ======================",
      "def set_msvc(version: str | None = None):",
      "    \"\"\"# 运行 msvc-kit 配置 MSVC C编译环境",
      "",
      "    Args:",
      "        msvc_kit_version (str, optional): msvc-kit 版本号（默认最新版）.",
      "            Defaults to None.",
      "",
      "    Returns:",
      "        dict[str, list[str]]: msvc C编译环境变量配置信息",
      "    \"\"\"",
      "    if version:",
      "        msvc_kit_version = version",
      "    else:",
      "        # * 获取 Github 最新版本并下载",
      "        try:",
      "            msvc_kit_HTML = requests.get(url='https://github.com/loonghao/msvc-kit/releases', headers=headers).text",
      "        except Exception as e:",
      "            print(f'错误类型:{type(e)}')",
      "            print(f'错误信息:{e}')",
      "            msvc_kit_HTML = 'data-item-id=\"release-v0.2.15\"'",
      "        pattern = re.compile(r'data-item-id=\"release-(v\\d+\\.[\\d\\.]+)\"')  # 编译正则：类似 data-item-id=\"release-v0.2.15\"",
      "        msvc_kit_versions = pattern.findall(msvc_kit_HTML)",
      "        # print(msvc_kit_versions)",
      "        msvc_kit_version = msvc_kit_versions[0]",
      "",
      "    msvc_kit_path = Path(cwd, 'msvc_kit')",
      "    msvc_kit = Path(msvc_kit_path, 'msvc-kit-x86_64-windows.exe')",
      "",
      "    if not msvc_kit_path.exists(follow_symlinks=False):",
      "        msvc_kit_path.mkdir(parents=True, exist_ok=True)",
      "    if not msvc_kit.exists(follow_symlinks=False):",
      "        url = f'{gh}/https://github.com/loonghao/msvc-kit/releases/download/{msvc_kit_version}/msvc-kit-x86_64-windows.exe'",
      "        print('下载|配置 msvc-kit 环境')",
      "        subprocess.run(f'curl -SL {url} -o \"{msvc_kit}\"')",
      "",
      "    loonghao_path = Path(LOCALAPPDATA, 'loonghao')",
      "    setup_bat = Path(cwd, 'setup.bat')",
      "",
      "    if not loonghao_path.exists(follow_symlinks=False):",
      "        subprocess.run(f'call \"{msvc_kit}\" download', shell=True)",
      "",
      "    subprocess.run(f'call \"{msvc_kit}\" setup --script --shell cmd > \"{setup_bat}\"', shell=True)",
      "",
      "    # * 记录 环境变量字典",
      "    msvc_setup_dict: dict[str, list[str]] = {'PATH': []}",
      "",
      "    with open(setup_bat, 'r', encoding='utf-8') as f:",
      "        content = f.readline()",
      "        while 'End local and export variables' not in content:",
      "            if content.startswith(r'set \"') and content.endswith('\"\\n'):",
      "                content = content.strip('\\n')",
      "                content = re.sub(r'^set \"', r'', content, flags=re.DOTALL)",
      "                content = re.sub(r'\"$', r'', content, flags=re.DOTALL)",
      "                content_list = content.split('=')",
      "                if re.match(r'.*%(.*)%.*', content):",
      "                    # print(f'{content_list}')",
      "                    env_key = re.match(r'.*%(.*)%.*', content).group(1)  # type: ignore",
      "                    env_value = content_list[1].replace(';', '')",
      "                    env_value = re.sub(rf'%{env_key}%', r'', env_value, flags=re.DOTALL)",
      "                    if env_key in list(msvc_setup_dict.keys()):",
      "                        msvc_setup_dict[env_key] = [*msvc_setup_dict[env_key], env_value]",
      "                    elif env_key.upper() == 'PATH':",
      "                        msvc_setup_dict['PATH'] = [*msvc_setup_dict['PATH'], env_value]",
      "                    else:",
      "                        print(f'未知环境:{content_list}')",
      "                else:",
      "                    msvc_setup_dict[content_list[0]] = [content_list[1]]",
      "            content = f.readline()",
      "",
      "    return msvc_setup_dict",
      "",
      "",
      "# ====================== 配置 脚本运行系统环境变量 ======================",
      "def set_env():",
      "    \"\"\"# 配置 脚本运行系统环境变量\"\"\"",
      "    env_dict = set_msvc()",
      "",
      "    env_dict['PATH'] = [",
      "        f'{Path(cwd, \"python\")}',",
      "        f'{Path(cwd, \"python\", \"Scripts\")}',",
      "        *env_dict['PATH'],",
      "        *[i for i in os.getenv('PATH').split(';') if i],  # type: ignore",
      "    ]",
      "",
      "    for key in env_dict:",
      "        if key.upper() == 'PATH':",
      "            os.environ['PATH'] = f'{\";\".join(env_dict[key])};{os.getenv(\"PATH\")}'",
      "        else:",
      "            os.environ[key] = f'{\";\".join(env_dict[key])}'",
      "",
      "",
      "# ====================== 环境测试 ======================",
      "def test_env(plugin_ls: bool = False):",
      "    \"\"\"# 环境测试",
      "",
      "    Args:",
      "        plugin_ls (bool, optional): 查看所有Nuitka可用插件.",
      "            Defaults to False.",
      "    \"\"\"",
      "    subprocess.run('call python --version', shell=True)",
      "    subprocess.run('call python -m pip --version', shell=True)",
      "    subprocess.run('call cl', shell=True)",
      "",
      "    # * uv安装Nuitka",
      "    subprocess.run('call uv add \"Nuitka[all]\" --upgrade --index https://mirrors.aliyun.com/pypi/simple/', shell=True)",
      "",
      "    # * 激活 .venv 虚拟环境",
      "    subprocess.run('call \".venv\\\\Scripts\\\\activate\"', shell=True)",
      "    os.environ['PATH'] = f'{\";\".join([f\"{Path(cwd, '.venv', 'Scripts')}\"])};{os.getenv(\"PATH\")}'",
      "",
      "    if plugin_ls:",
      "        print('列出所有Nuitka可用插件')",
      "        subprocess.run('call python -m nuitka --plugin-list', shell=True)",
      "",
      "    # * Nuitka版本&环境测试",
      "    print('Nuitka环境')",
      "    subprocess.run('call python -m nuitka --version', shell=True)",
      "",
      "",
      "# ====================== 环境卸载 ======================",
      "def rm_env():",
      "    \"\"\"# 环境卸载\"\"\"",
      "    # * Nuitka 环境",
      "    nuitka_path = Path(LOCALAPPDATA, 'Nuitka')",
      "    if nuitka_path.exists():",
      "        try:",
      "            nuitka_path.unlink()",
      "        except PermissionError:",
      "            subprocess.run(f'rd /S /Q \"{nuitka_path}\"', shell=True)",
      "",
      "    # * msvc_kit 环境",
      "    msvc_kit_path = Path(cwd, 'msvc_kit')",
      "    msvc_kit = Path(msvc_kit_path, 'msvc-kit-x86_64-windows.exe')",
      "    loonghao_path = Path(LOCALAPPDATA, 'loonghao')",
      "    if loonghao_path.exists():",
      "        subprocess.run(f'call \"{msvc_kit}\" clean --all --cache', shell=True)",
      "    if loonghao_path.exists():",
      "        try:",
      "            loonghao_path.unlink()",
      "        except PermissionError:",
      "            subprocess.run(f'rd /S /Q \"{loonghao_path}\"', shell=True)",
      "    print('环境卸载完毕')",
      "",
      "",
      "# ====================== 编译参数 ======================",
      "def main_setup(",
      "    main_file: Path | str = './main.py',",
      "    windows_icon_from_ico: Path | str | None = None,",
      "    disabled_windows_console: bool = False,",
      "    output_filename: str = 'NuitkaApp',",
      "    output_path: Path | str = './__Nuitka.Dist__',",
      "    include_packages: list[str] = [],",
      "    include_data_dirs: dict[str, Path] | dict[str, str] | None = None,",
      "    plugins: list[str] = [],",
      "    jobs: int = 8,",
      "    onefile: bool | int = False,",
      "    onefile_no_compression: bool | int = True,",
      "    onefile_tempdir_spec: bool | str | None = None,",
      "    company_name: str | None = None,",
      "    product_name: str | None = None,",
      "):",
      "    \"\"\"# 编译参数配置 && 执行 Nuitka 编译命令",
      "",
      "    **HELP**: https://nuitka.net/user-documentation/use-cases.html",
      "",
      "    Args:",
      "        main_file (Path | str, optional): 编译入口文件.",
      "            Defaults to Path(CWD, 'main.py').",
      "        windows_icon_from_ico (Path | str | None, optional): 输出exe程序图标文件.",
      "            Defaults to None.",
      "        disabled_windows_console (bool, optional): 不显示Windows终端界面.",
      "            Defaults to False.",
      "        output_filename (str, optional): 编译输出exe文件名.",
      "            Defaults to 'mainApp'.",
      "        output_path (Path | str, optional): 输出文件目录.",
      "            Defaults to Path(CWD, '__Nuitka.Dist__').",
      "        include_package (list[str], optional): --include-package=包含整个包及其子模块 & --include-package-data=包含包内非DLL数据文件（支持通配符）。如：['flet'].",
      "            Defaults to [].",
      "        include_data_dir (_type_, optional): --include-data-dir=\"./src\"=\"src\"', 递归包含整个目录的数据文件（源目录=目标目录）。如：{'src': Path(CWD, 'src')}.",
      "            Defaults to None.",
      "        plugins (list[str], optional): --enable-plugin=需要启用的插进（使用'--plugin-list'查询完整列表），默认：空。如：pyqt6、pyside6.",
      "            Defaults to [].",
      "        jobs (int, optional): --jobs=并行C编译任务数（负值表示系统CPU减N），默认：8.",
      "            Defaults to 8.",
      "        onefile (bool | int, optional): --onefile在独立模式的基础上, 启用单文件模式。这意味着不是一个文件夹, 而是创建和使用一个压缩的可执行文件。默认：False（关闭）.",
      "            Defaults to False.",
      "        onefile_no_compression (bool | int, optional): --onefile-no-compression=无压缩单文件.",
      "            Defaults to True.",
      "        onefile_tempdir_spec (bool | str | None, optional): --onefile-tempdir-spec=单文件临时目录位置 [",
      "            ``None``:./_{PID} [临时目录，程序关闭时会被删除] (当前exe执行程序目录下的 ./_{PID})",
      "            ``True``:{CACHE_DIR}/{COMPANY}/{PRODUCT} [持久化] (固化解压文件，需要配置 ``company_name``--company-name=\"MyCompany\" 和 ``product_name``--product-name=\"MyApp\" ，路径:C:/Users/用户名/AppData/Local/MyCompany/MyApp)",
      "            ``False``:(默认值){TEMP}/onefile_{PID}_{TIME} [临时目录，程序关闭时会被删除] (即用户临时目录，并且是非静态的，程序关闭时会被删除)",
      "            ``str``:./{onefile_tempdir_spec} [持久化] (当前exe执行程序目录下的 ./{onefile_tempdir_spec})",
      "            ].",
      "            Defaults to None.",
      "        company_name (str | None, optional): --company-name=公司名称，配合`--onefile-tempdir-spec`使用，onefile_tempdir_spec_CACHE_DIR 为 ``LOCALAPPDATA`` 时必须设置.",
      "            Defaults to None.",
      "        product_name (str | None, optional): --product-name=产品名称，配合`--onefile-tempdir-spec`使用，onefile_tempdir_spec_CACHE_DIR 为 ``LOCALAPPDATA`` 时必须设置.",
      "            Defaults to None.",
      "    \"\"\"",
      "",
      "    # * 配置 Nuitka - Dependency Walker 环境",
      "    logging.info('🟡 配置 Nuitka - Dependency Walker 环境')",
      "    set_depends()",
      "    # * 配置 Nuitka - Cache 环境",
      "    logging.info('🟡 配置 Nuitka - Cache 环境')",
      "    set_cache()",
      "    # * 运行 msvc-kit 配置 MSVC C编译环境",
      "    logging.info('🟡 运行 msvc-kit 配置 MSVC C编译环境')",
      "    set_msvc()",
      "    # * 配置 脚本运行系统环境变量",
      "    logging.info('🟡 配置 脚本运行系统环境变量')",
      "    set_env()",
      "    # ! 嵌入式环境测试",
      "    python_pth = Path(cwd, 'python').glob('python*._pth')",
      "    if list(python_pth):",
      "        logging.error('🔴 检测到嵌入式Python环境，请使用Python安装环境后再继续尝试！')",
      "        sys.exit(1)",
      "        return",
      "    # * 环境测试",
      "    logging.info('🟢 环境测试')",
      "    test_env()",
      "",
      "    # * 构建 Nuitka编译参数 命令行 列表",
      "    commands = [",
      "        'call',",
      "        'python',",
      "        '-m',",
      "        'nuitka',",
      "        '--standalone',  # 独立文件夹",
      "        '--assume-yes-for-downloads',  # 自动下载依赖项",
      "        '--follow-imports',  # 跟随导入的模块",
      "        '--remove-output',  # 编译后删除临时构建目录",
      "        '--lto=yes',  # 启用链接时优化（LTO）默认：auto [yes/no/auto]",
      "        f'--main=\"{main_file}\"',  # ; 入口文件",
      "        f'--output-filename=\"{output_filename}\"',  # ; 指定输出可执行文件名",
      "        f'--output-dir=\"{Path(output_path)}\"',  # ; 指定输出目录",
      "        f'--jobs={jobs}',  # 并行C编译任务数（负值表示系统CPU减N）",
      "        # '--windows-console-mode=disable',  # Windows控制台模式（ force ：【默认】强制创建； disable ：禁用； attach ：附加现有）",
      "        # '--include-package=flet',  # ? 包含整个包及其子模块",
      "        # '--include-package-data=flet',  # ? 包含包内非DLL数据文件（支持通配符）",
      "        # '--include-data-dir=\"./src\"=\"src\"',  # ? 递归包含整个目录的数据文件（源目录=目标目录）",
      "    ]",
      "    # * 清理 旧版打包输出文件夹",
      "    if Path(output_path).exists(follow_symlinks=False):",
      "        subprocess.run(f'rd /S /Q \"{Path(output_path)}\"', shell=True)",
      "",
      "    # * Windows控制台模式",
      "    if disabled_windows_console:",
      "        commands.append('--windows-console-mode=disable')",
      "    # * 添加命令 include-package包含整个包及其子模块 & include-package-data包含包内非DLL数据文件（支持通配符）",
      "    for include_package in include_packages:",
      "        commands.append(f'--include-package={include_package}')",
      "        commands.append(f'--include-package-data={include_package}')",
      "    # * 添加命令 include-data-dir递归包含整个目录的数据文件",
      "    if include_data_dirs:",
      "        for include_data_dir in include_data_dirs:",
      "            commands.append(f'--include-data-dir=\"{include_data_dirs[include_data_dir]}\"=\"{include_data_dir}\"')",
      "    # * 添加命令 需要启用的插进（使用'--plugin-list'查询完整列表）",
      "    if plugins:",
      "        for plugin in plugins:",
      "            commands.append(f'--enable-plugin={plugin}')",
      "    # * 输出exe程序图标文件",
      "    if windows_icon_from_ico and Path(windows_icon_from_ico).exists(follow_symlinks=False):",
      "        commands.append(f'--windows-icon-from-ico=\"{windows_icon_from_ico}\"')  # ICON图标文件",
      "    # ! 单文件打包执行（单文件打包后执行程序，首次执行时需要解压，启动速度慢）",
      "    if bool(onefile):",
      "        commands.append('--onefile')",
      "",
      "        if bool(onefile_no_compression):",
      "            commands.append('--onefile-no-compression')",
      "",
      "        if onefile_tempdir_spec is None:",
      "            commands.append(r'--onefile-tempdir-spec=\"./_{PID}\"')",
      "        elif onefile_tempdir_spec is True:",
      "            if not company_name or not product_name:",
      "                logging.error(f'🔴 请先补全参数: company_name={company_name}, product_name={product_name}')",
      "                sys.exit(1)",
      "                return",
      "            commands.append(rf'--company-name=\"{company_name}\"')",
      "            commands.append(rf'--product-name=\"{product_name}\"')",
      "            commands.append(r'--onefile-tempdir-spec=\"{CACHE_DIR}/{COMPANY}/{PRODUCT}\"')",
      "        elif onefile_tempdir_spec is False:",
      "            commands.append(r'--onefile-tempdir-spec=\"{TEMP}/onefile_{PID}_{TIME}\"')",
      "        elif isinstance(onefile_tempdir_spec, str):",
      "            if not onefile_tempdir_spec or not onefile_tempdir_spec.strip():",
      "                logging.error(f'🔴 参数不能为空: onefile_tempdir_spec={onefile_tempdir_spec}')",
      "                sys.exit(1)",
      "                return",
      "            commands.append(rf'--onefile-tempdir-spec=\"./{onefile_tempdir_spec}\"')",
      "        else:",
      "            logging.error(f'🔴 未知参数: onefile_tempdir_spec={onefile_tempdir_spec}')",
      "            sys.exit(1)",
      "            return",
      "",
      "    # ; Nuitka 编译命令行",
      "    command = ' '.join(commands)",
      "    print(f'>>{command}')",
      "    # # ; 执行 Nuitka 编译命令行",
      "    subprocess.run(command, shell=True)",
      "    if Path(output_path).exists(follow_symlinks=False):",
      "        os.startfile(Path(output_path))  # 打开输出文件夹",
      "",
      "",
      "if __name__ == '__main__':",
      "    # * 运行入口 | 调试运行",
      "    start_time = perf_counter()",
      "",
      "    main_setup(",
      "        main_file='./main.py',  # * 编译入口文件",
      "        windows_icon_from_ico='./icon.ico',  # * 输出exe程序图标文件",
      "        disabled_windows_console=False,  # 不显示Windows终端界面",
      "        output_filename='main',  # * 编译输出exe文件名",
      "        output_path='./__Nuitka.Dist__',  # 输出文件目录",
      "        include_packages=['flet'],  # * 包含的包及其子模块",
      "        include_data_dirs={  # * 递归包含整个目录的数据文件（源目录=目标目录）",
      "            'src/assets': './src/assets',",
      "            'src/bin': './src/bin',",
      "        },",
      "        plugins=[],  # 需要启用的插进（使用'--plugin-list'查询完整列表），默认：空。如：pyqt6、pyside6",
      "        jobs=10,  # 并行C编译任务数（负值表示系统CPU减N）",
      "        onefile=False,  # ! 不建议编译单文件 ** 下方代码只有在 onefile = True 时生效 **",
      "        onefile_no_compression=True,  # 无压缩单文件",
      "        onefile_tempdir_spec=None,  # 单文件临时目录位置[None:./_{PID} True:{CACHE_DIR}/{COMPANY}/{PRODUCT} False:{TEMP}/onefile_{PID}_{TIME} str:./{str}]",
      "        company_name='_AvA_',  # 公司名称(onefile_tempdir_spec 为 True 时必须设置)",
      "        product_name='MyApp',  # 产品名称(onefile_tempdir_spec 为 True 时必须设置)",
      "    )",
      "",
      "    end_time = perf_counter()",
      "    cost_time = end_time - start_time",
      "    print(f'[bold green]>> 打包完成 (耗时:{int(cost_time // 60)}min{cost_time % 60:.2f}s) <<[/]')",
      "    rm_env() if input(f'\\n{\"=\" * 34}\\n是否卸载打包环境[0:卸载/其他:退出]\\n{\"=\" * 34}\\n') == '0' else sys.exit(0)  # * 0=无错误退出 | 1=有错误退出",
      "    ...",
      ""
    ],
    "description": ["Nuitka 编译"]
  }
}
