  "rich.progress.track 创建基本的Rich进度条显示": {
    "prefix": ["for_rich_track_=-rich", "rich_for_track_="],
    "body": ["for i in track(range(20), description='Processing...'):", "    # * 进度循环体", "    ..."],
    "description": ["创建基本的Rich进度条显示"]
  },
  "rich.progress.Progress 创建高级的Rich进度条显示": {
    "prefix": ["with_rich_Progress_=-rich"],
    "body": [
      "with Progress() as progress:",
      "    total = 100",
      "    # * 创建进度条任务",
      "    task = progress.add_task('[red]Processing...', total=total)",
      "",
      "    while not progress.finished:  # * 检查进度条是否完成",
      "        progress.update(task)  # * 模拟进度条的进度",
      "        # * 耗时任务执行",
      "",
      "        progress.advance(task)  # * 推进进度条",
      ""
    ],
    "description": ["创建高级的Rich进度条显示"]
  }
}
