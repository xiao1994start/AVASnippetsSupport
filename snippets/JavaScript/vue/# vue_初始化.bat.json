{
  "创建 Vue 项目": {
    "prefix": ["init vue"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "",
      "",
      "@REM ====================== 基础环境配置 ======================",
      "@REM * 标化 node 环境目录",
      "for /D %%i in (\"*node*\") do ( ren \"%%i\" \"_node\" )",
      "@REM * 定义 node 环境变量",
      "set \"local_node=%~dp0_node\"",
      "",
      "@REM * 添加临时系统环境变量",
      "set \"NODE_PATH=!local_node!\\;!local_node!\\node_modules\\;\"",
      "set \"PATH=!NODE_PATH!;%PATH%;\"",
      "",
      "@REM * node 环境测试",
      "ECHO node.js 版本号:",
      "call node -v",
      "ECHO NPM 版本号:",
      "call npm -v",
      "",
      "@REM * 替换 npm 国内镜像源（全局）",
      "ECHO npm 设置为淘宝镜像源",
      "call npm config set registry https://registry.npmmirror.com/",
      "",
      "",
      "@REM ====================== 创建 Vue 项目 ======================",
      "",
      "",
      "set \"vue_project_name=${1:app_vue_js}\"",
      "",
      "",
      "if not exist \"%~dp0!vue_project_name!\" (",
      "    ECHO 创建 Vue 项目",
      "    ECHO * 项目创建建议：",
      "    ECHO *   - 否使用 TypeScript 语法？   No",
      "    ECHO *   - 请选择要包含的功能：       Router（单页面应用开发）",
      "    ECHO *   - 选择要包含的试验特性：     none",
      "    ECHO *   - 跳过所有示例代码，创建一个空白的 Vue 项目？  Yes",
      "    call npm create vue@latest !vue_project_name!",
      "    @REM * 进入项目目录安装必备依赖",
      "    CD /D \"%~dp0!vue_project_name!\\\"",
      "    call npm install",
      "    @REM * 安装 Element Plus 组件库 【https://element-plus.org/zh-CN/guide/installation】",
      "    call npm install element-plus --save",
      "    @REM - 集成 Element Plus 组件库 【https://element-plus.org/zh-CN/guide/quickstart】",
      "    @REM * ./*/src/main.js 引入 Element Plus 组件库：",
      "    @REM   import { createApp } from 'vue'",
      "    @REM = import ElementPlus from 'element-plus'",
      "    @REM = import 'element-plus/dist/index.css'",
      "    @REM   import App from './App.vue'",
      "    @REM   const app = createApp(App)",
      "    @REM   app.use(router)",
      "    @REM = app.use(ElementPlus)  // 也可以链式写",
      "    @REM   app.mount('#app')",
      "",
      "    @REM ! (可选) 调试工具 vite-plugin-vue-devtools 卸载",
      "    call npm uninstall vite-plugin-vue-devtools",
      "    @REM 卸载后清除 ./*/jsconfig.json 中 *vueDevTools* 相关配置",
      "",
      "    @REM * 写入启动脚本",
      "    (  ECHO @ECHO OFF",
      "    ECHO setlocal EnableDelayedExpansion",
      "    ECHO.",
      "    ECHO @REM * 设置环境变量",
      "    ECHO set \"cwd=%%~dp0\"",
      "    ECHO if \"^!cwd:~-1^!\"==\"\\\" set \"cwd=^!cwd:~0,-1^!\"",
      "    ECHO.",
      "    ECHO CD /D \"^!cwd^!\\..\"",
      "    ECHO if not exist \"^!CD^!\\_node\" ECHO 请先配置node环境 ^&^& EXIT /B",
      "    ECHO set \"local_node=^!CD^!\\_node\"",
      "    ECHO.",
      "    ECHO @REM * 添加临时系统环境变量",
      "    ECHO set \"NODE_PATH=^!local_node^!\\;^!local_node^!\\node_modules\\;\"",
      "    ECHO set \"PATH=^!NODE_PATH^!;%%PATH%%;\"",
      "    ECHO.",
      "    ECHO @REM * dev 运行项目",
      "    ECHO CD /D \"%%~dp0\"",
      "    ECHO call npm run dev",
      "    ECHO.",
      "    ECHO endlocal)>\"%~dp0!vue_project_name!\\01_run_dev.cmd\"",
      ")",
      "",
      "",
      "ECHO 启动 Vue 项目",
      "call \"%~dp0!vue_project_name!\\01_run_dev.cmd\"",
      "",
      "",
      "",
      "endlocal",
      ""
    ],
    "description": ["创建 Vue 项目"]
  }
}
