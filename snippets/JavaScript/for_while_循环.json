{
  "for 循环语句": {
    "prefix": ["for "],
    "body": ["for (${1:初始化表达式}; ${2:条件表达式}; ${3:迭代表达式}) {$0}", ""],
    "description": ["for 循环语句"]
  },
  "for...in 循环遍历": {
    "prefix": ["for in "],
    "body": [
      "for (let index in array_数组) {",
      "  // * for...in 循环遍历数组时，获取到的是数组的索引，而不是数组的元素",
      "  $0",
      "}",
      ""
    ],
    "description": ["for...in 循环遍历"]
  },
  "for...of 循环遍历": {
    "prefix": ["for of "],
    "body": [
      "for (let element of array_数组) {",
      "  // * for...of 循环遍历数组时，可以直接获取到的是数组的元素",
      "  $0",
      "}",
      ""
    ],
    "description": ["for...of 循环遍历"]
  },
  "while 循环语句": {
    "prefix": "while ",
    "body": ["while (${1:条件表达式}) {", "  $0", "  // * 迭代表达式", "}", ""],
    "description": ["while 循环语句"]
  }
}
