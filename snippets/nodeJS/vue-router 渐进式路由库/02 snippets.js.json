      "   *   <!-- * 路由链接组件 -->",
      "   *   <RouterLink to=\"/路由地址\"> 标签 </RouterLink>",
      "   *   <!-- * 路由视图组件 -->",
      "   *   <RouterView></RouterView>",
      "   * </template>",
      "   */",
      ""
    ],
    "description": ["导入 vue-router.RouterLink, RouterView 类 路由组件类型 [ESM]"]
  }
}
