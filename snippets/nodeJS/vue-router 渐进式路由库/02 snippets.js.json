{
  "引入 vue-router.createRouter 模块 [ESM]": {
    "prefix": ["impt_createRouter"],
    "body": [
      "import { createRouter, createWebHistory, createWebHashHistory } from 'vue-router'",
      "/**",
      " * # 路由规则配置",
      " * * createRouter: 创建路由实例",
      " * * createWebHistory: 创建路由历史模式实例（自定服务器配置，需要后端配置Nginx配置路径解决刷新页面404问题）",
      " * * createWebHashHistory: 创建路由哈希模式实例（无需服务器配置，兼容性好，本地协议静态文件）",
      " * - src/main.ts 中使用路由实例 >>",
      " *   ...import router from './router/index.ts'...",
      " *   ...const app = createApp(App)...",
      " *   ...app.use(router)...",
      " *   app.mount('#app')",
      " */",
      "",
      "const router = createRouter({",
      "  // * 指定路由模式: history - 历史模式 || hash - 哈希模式",
      "  history: createWebHashHistory(),",
      "  routes: [",
      "    {",
      "      // name: 'name', // * 调用方法: <RouterLink :to=\"{ name: 'name' }\">",
      "      path: '/',",
      "      component: () => import('${1:vue组件路径}'),",
      "      // redirect: '/路由地址path', // - 重定向 (与 component 不能同时使用),",
      "      // children: [{name: '子路由名称', path: '子路由路径（不要加`/`开头）', component: () => import(vue组件路径)}]",
      "      // * 子路由调用: <router-link to=\"/根路由path/子路由path\">标签</router-link>",
      "    },",
      "  ],",
      "})",
      "",
      "// = 默认导出路由实例",
      "export default router",
      ""
    ],
    "description": ["引入 vue-router.createRouter 模块 [ESM]"]
  },
  "导入 vue-router.RouterLink 路由组件类型 [ESM]": {
    "prefix": ["impt_RouterLink"],
    "body": [
      "import type { RouterLink } from 'vue-router'",
      "/**",
      " * # 导入 vue-router 路由组件类型",
      " * = ./src/router/index.ts => 创建路由实例时，需要指定路由规则配置",
      " * <template>",
      " *   <aside>",
      " *     <nav>",
      " *       <!-- * 路由链接组件 -->",
      " *       <RouterLink to=\"/路由\">标签</RouterLink>",
      " *       <router-link to=\"/路由\">标签</router-link>",
      " *       <!-- = 属性 replace : 替换当前路由，不保留历史记录 -->",
      " *     </nav>",
      " *   </aside>",
      " *   <main>",
      " *     <RouterView></RouterView>",
      " *     <router-view></router-view>",
      " *     <!-- * 路由参数查询组件 -->",
      " *   </main>",
      " * </template>",
      " * <style scoped>",
      " *   .router-link { RouterLink常规样式 }",
      " *   .router-link:hover { RouterLink悬停样式 }",
      " *   .router-link.router-link-active { RouterLink激活样式 (router-link-active 是vue-router自带路由激活高亮类名) }",
      " * </style>",
      " */",
      ""
    ],
    "description": ["导入 vue-router.RouterLink 路由组件类型 [ESM]"]
  },
  "导入 vue-router.useRoute 路由参数查询组件 [ESM]": {
    "prefix": ["impt_useRoute"],
    "body": [
      "import { useRoute } from 'vue-router' // * 获取路由参数",
      "// ? <RouterLink||router-link :to=\"/url?查询参数=\\${查询参数值}&...\">",
      "const route = useRoute()",
      "const querys = route.query",
      "// - querys = route.query => 查询参数：使用解构赋值获取查询参数",
      ""
    ],
    "description": ["导入 vue-router.useRoute 路由参数查询组件 [ESM]"]
  }
}
