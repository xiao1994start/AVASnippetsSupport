{
  "样式：禁止选取": {
    "prefix": ["**select_none_"],
    "body": [
      "* {",
      "  /* 为 Electron/Chrome 等 WebKit 内核兼容 */",
      "  -webkit-user-select: none;",
      "  /* 为 Firefox 兼容 */",
      "  -moz-user-select: none;",
      "  /* 为 IE/Edge 兼容 */",
      "  -ms-user-select: none;",
      "  /* 标准属性 */",
      "  user-select: none;${0}",
      "}",
      ""
    ],
    "description": ["样式：禁止选取"]
  }
}
