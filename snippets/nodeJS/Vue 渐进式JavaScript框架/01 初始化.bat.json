{
  "创建 Vue 项目(建议使用 Vite)": {
    "prefix": ["init_vue"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "",
      "",
      "@REM ====================== 基础环境配置 ======================",
      "@REM * 标化 node 环境目录",
      "if not exist \".\\node\" ( for /D %%i in (\"*node*\") do ( if /I \"%%~nxi\" NEQ \"node_modules\" ( ren \"%%i\" \"node\" ) ) )",
      "@REM * 定义 node 环境变量",
      "set \"local_node=.\\node\"",
      "",
      "@REM * 设置临时系统环境变量",
      "set \"NODE_PATH=!local_node!;!local_node!\\node_modules;.\\node_modules\\.bin;\"",
      "set \"XPATH=%PATH%\"",
      "set \"PATH=!NODE_PATH!;%XPATH%;\"",
      "",
      "ECHO.= node 版本号:",
      "call node -v",
      "ECHO.= npm 版本号:",
      "call npm -v",
      "ECHO.",
      "",
      "ECHO.- 清理 npm 缓存（禁用：推荐的保护功能）",
      "call npm cache clean --force",
      "ECHO.+ 升级 npm",
      "call npm i npm -g --registry https://registry.npmmirror.com/",
      "ECHO.= 检查 软件仓库位置:",
      "call npm root -g",
      "",
      "@REM * 替换 npm 国内镜像源（全局）",
      "ECHO.npm 设置为淘宝镜像源",
      "call npm config set registry https://registry.npmmirror.com/",
      "ECHO.+ 【本地开发必装】安装 @types/node 类型定义",
      "call npm i -D @types/node --registry https://registry.npmmirror.com/",
      "",
      "",
      "@REM ====================== 创建 Vue 项目 ======================",
      "",
      "",
      "set \"project_name=${1:vue-project}\"",
      "",
      "",
      "if not exist \".\\!project_name!\" (",
      "    ECHO.创建 Vue 项目",
      "    ECHO.* 项目创建建议：",
      "    ECHO.*   - 否使用 TypeScript 语法？   No",
      "    ECHO.*   - 请选择要包含的功能：       Router（单页面应用开发）",
      "    ECHO.*   - 选择要包含的试验特性：     none",
      "    ECHO.*   - 跳过所有示例代码，创建一个空白的 Vue 项目？  Yes",
      "    call npm create vue@latest !project_name!",
      "    @REM * 进入项目目录安装必备依赖",
      "    CD \".\\!project_name!\"",
      "    set \"NODE_PATH=.\\..\\node;.\\..\\node\\node_modules;.\\node_modules;.\\node_modules\\.bin;\"",
      "    set \"XPATH=%PATH%\"",
      "    set \"PATH=!NODE_PATH!;%XPATH%;\"",
      "    ECHO.* 安装 项目依赖",
      "    call npm i --registry https://registry.npmmirror.com/",
      "",
      "    ECHO.* 安装 axios 请求库 :: https://www.axios-http.cn/",
      "    call npm i axios --registry https://registry.npmmirror.com/",
      "",
      "    ECHO.* 安装 vue-router 渐进式路由库 :: https://router.vuejs.org/zh/",
      "    call npm i vue-router --registry https://registry.npmmirror.com/",
      "    @REM  # 配置方法",
      "    @REM  - src/main.ts 中使用路由实例 >>",
      "    @REM    ...import router from './router/index.ts'...",
      "    @REM    ...const app = createApp(App)...",
      "    @REM    ...app.use(router)...",
      "    @REM    app.mount('#app')",
      "",
      "    ECHO.* 安装 pinia 全局数据存储集中管理库 :: https://pinia.vuejs.ac.cn/",
      "    call npm i pinia --registry https://registry.npmmirror.com/",
      "",
      "    ECHO.* 安装 Element Plus 组件库 :: https://element-plus.org/zh-CN/guide/installation",
      "    call npm i element-plus --registry https://registry.npmmirror.com/",
      "",
      "    goto :set_ElementPlus_for_js",
      "    ECHO.* 【JavaScript】配置集成 ElementPlus 组件库 :: https://element-plus.org/zh-CN/guide/quickstart",
      "    ./[project_name]/src/main.js 引入 ElementPlus 组件库：",
      "        import { createApp } from 'vue'",
      "        import App from './App.vue'",
      "        // * 引入 ElementPlus 组件库",
      "        import ElementPlus from 'element-plus'",
      "        import 'element-plus/dist/index.css'",
      "        const app = createApp(App)",
      "        app.use(router)",
      "        // = 使用 .use(ElementPlus) 配置 ElementPlus 组件库",
      "        app.use(ElementPlus)",
      "        app.mount('#app')",
      "    :set_ElementPlus_for_js",
      "",
      "    ECHO.* 写入启动脚本",
      "    (  ECHO.@ECHO OFF",
      "    ECHO.setlocal EnableDelayedExpansion",
      "    ECHO.CD /D \"%%~dp0\"",
      "    ECHO.@REM * 设置环境变量",
      "    ECHO.if not exist \".\\..\\node\" ECHO.请先配置 nodeJS 环境 ^&^& EXIT /B",
      "    ECHO.set \"local_node=.\\..\\node\"",
      "    ECHO.",
      "    ECHO.@REM * 设置临时系统环境变量",
      "    ECHO.set \"NODE_PATH=^!local_node^!\\;^!local_node^!\\node_modules\\;.\\node_modules;.\\node_modules\\.bin;\"",
      "    ECHO.set \"PATH=^!NODE_PATH^!;%%PATH%%;\"",
      "    ECHO.",
      "    ECHO.@REM  ====================== ** npm ** ======================",
      "    ECHO.",
      "    ECHO.",
      "    ECHO.",
      "    ECHO.@REM * dev 运行项目",
      "    ECHO.call npm run dev",
      "    ECHO.",
      "    ECHO.endlocal)>\".\\_npm_run_dev.cmd\"",
      "    CD ..",
      ")",
      "",
      "",
      "ECHO.启动 Vue 项目",
      "call \".\\!project_name!\\_npm_run_dev.cmd\"",
      "",
      "",
      "",
      "endlocal",
      ""
    ],
    "description": ["创建 Vue 项目(建议使用 Vite)"]
  },
  "Vite 创建 Vue 项目": {
    "prefix": ["init_vite"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "",
      "@REM ====================== 基础环境配置 ======================",
      "@REM * 标化 node 环境目录",
      "if not exist \".\\node\" ( for /D %%i in (\"*node*\") do ( if /I \"%%~nxi\" NEQ \"node_modules\" ( ren \"%%i\" \"node\" ) ) )",
      "@REM * 定义 node 环境变量",
      "set \"local_node=.\\node\"",
      "",
      "@REM * 设置临时系统环境变量",
      "set \"NODE_PATH=!local_node!;!local_node!\\node_modules;\"",
      "set \"PATH=!NODE_PATH!;%PATH%;\"",
      "",
      "ECHO.= node 版本号:",
      "call node -v",
      "ECHO.= npm 版本号:",
      "call npm -v",
      "ECHO.",
      "",
      "ECHO.- 清理 npm 缓存（禁用：推荐的保护功能）",
      "call npm cache clean --force",
      "ECHO.+ 升级 npm",
      "call npm i npm -g --registry https://registry.npmmirror.com/",
      "ECHO.= 检查 软件仓库位置:",
      "call npm root -g",
      "",
      "@REM * 替换 npm 国内镜像源（全局）",
      "ECHO.npm 设置为淘宝镜像源",
      "call npm config set registry https://registry.npmmirror.com/",
      "ECHO.+ 【本地开发必装】安装 @types/node 类型定义",
      "call npm i -D @types/node --registry https://registry.npmmirror.com/",
      "",
      "",
      "@REM ====================== Vite 创建 Vue 项目 ======================",
      "",
      "",
      "set \"project_name=${1:vite-project}\"",
      "",
      "",
      "if not exist \".\\!project_name!\\\" (",
      "    ECHO.Vite 创建 Vue 项目",
      "    ECHO.* 项目创建建议：",
      "    ECHO.*   - Ok to proceed? （y） :               Yes",
      "    ECHO.*   - Select a framework:                  Vue",
      "    ECHO.*   - Select a variant:                    JavaScript (TypeScript 实现静态检查)",
      "    ECHO.*   - Install with npm and start now?      Yes（嵌入式环境选择 No）",
      "    call npm create vite@latest !project_name!",
      "    @REM * 进入项目目录安装必备依赖",
      "    CD \".\\!project_name!\"",
      "    set \"NODE_PATH=.\\..\\node;.\\..\\node\\node_modules;.\\node_modules;.\\node_modules\\.bin;\"",
      "    set \"PATH=!NODE_PATH!;%PATH%;\"",
      "    ECHO.* 安装 项目依赖",
      "    call npm i --registry https://registry.npmmirror.com/",
      "",
      "    ECHO.* 安装 axios 请求库 :: https://www.axios-http.cn/",
      "    call npm i axios --registry https://registry.npmmirror.com/",
      "",
      "    ECHO.* 安装 vue-router 渐进式路由库 :: https://router.vuejs.org/zh/",
      "    call npm i vue-router --registry https://registry.npmmirror.com/",
      "    @REM  # 配置方法",
      "    @REM  - src/main.ts 中使用路由实例 >>",
      "    @REM    ...import router from './router/index.ts'...",
      "    @REM    ...const app = createApp(App)...",
      "    @REM    ...app.use(router)...",
      "    @REM    app.mount('#app')",
      "",
      "    ECHO.* 安装 pinia 全局数据存储集中管理库 :: https://pinia.vuejs.ac.cn/",
      "    call npm i pinia --registry https://registry.npmmirror.com/",
      "",
      "    ECHO.* 安装 Element Plus 组件库 :: https://element-plus.org/zh-CN/guide/installation",
      "    call npm i element-plus --registry https://registry.npmmirror.com/",
      "",
      "    @REM  【TypeScript】配置集成 ElementPlus 组件库 :: https://element-plus.org/zh-CN/guide/quickstart",
      "    @REM  ./[project_name]/src/main.ts 引入 ElementPlus 组件库：",
      "    @REM      import { createApp } from 'vue'",
      "    @REM      // import './style.css' // 注释其他样式文件",
      "    @REM      import App from './App.vue'",
      "    @REM      // * 引入 ElementPlus 组件库",
      "    @REM      import ElementPlus from 'element-plus'",
      "    @REM      import 'element-plus/dist/index.css'",
      "    @REM      // = 插入 .use(ElementPlus) 配置 ElementPlus 组件库",
      "    @REM      createApp(App).use(ElementPlus).mount('#app')",
      "",
      "    CD ..",
      ")",
      "if exist \".\\!project_name!\\\" (",
      "    CD \".\\!project_name!\"",
      "    if not exist \".\\#run_dev.cmd\" (",
      "        ECHO.* 写入启动脚本",
      "        (  ECHO.@ECHO OFF",
      "        ECHO.setlocal EnableDelayedExpansion",
      "        ECHO.CD /D \"%%~dp0\"",
      "        ECHO.@REM * 设置环境变量",
      "        ECHO.if not exist \".\\..\\node\" ECHO.请先配置 nodeJS 环境 ^&^& EXIT /B",
      "        ECHO.set \"local_node=.\\..\\node\"",
      "        ECHO.",
      "        ECHO.@REM * 添加临时系统环境变量",
      "        ECHO.set \"NODE_PATH=^!local_node^!\\;^!local_node^!\\node_modules\\;.\\node_modules;.\\node_modules\\.bin;\"",
      "        ECHO.set \"PATH=^!NODE_PATH^!;%%PATH%%;\"",
      "        ECHO.",
      "        ECHO.@REM * dev 运行项目",
      "        ECHO.call npm run dev",
      "        ECHO.",
      "        ECHO.",
      "        ECHO.endlocal)>\".\\#run_dev.cmd\"",
      "    )",
      "    if not exist \".\\#npm_package.cmd\" (",
      "        ECHO.* 写入项目依赖管理脚本",
      "        (  ECHO.@ECHO OFF",
      "        ECHO.setlocal EnableDelayedExpansion",
      "        ECHO.CD /D \"%%~dp0\"",
      "        ECHO.@REM * 设置环境变量",
      "        ECHO.if not exist \".\\..\\node\" ECHO.请先配置 nodeJS 环境 ^&^& EXIT /B",
      "        ECHO.set \"local_node=.\\..\\node\"",
      "        ECHO.",
      "        ECHO.@REM * 添加临时系统环境变量",
      "        ECHO.set \"NODE_PATH=^!local_node^!\\;^!local_node^!\\node_modules\\;.\\node_modules;.\\node_modules\\.bin;\"",
      "        ECHO.set \"PATH=^!NODE_PATH^!;%%PATH%%;\"",
      "        ECHO.",
      "        ECHO.@REM * ====================== ** npm ** ======================",
      "        ECHO.",
      "        ECHO.",
      "        ECHO.",
      "        ECHO.endlocal)>\".\\#npm_package.cmd\"",
      "    )",
      "    if not exist \".\\vite.config_跨域代理.ts\" (",
      "        set \"TARGET_FILE=.\\vite.config_跨域代理.ts\"",
      "        ECHO.写入 vite 代理跨域配置文件",
      "        powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "            \"$lines = @(\" ^",
      "            \"  'import vue from ''@vitejs/plugin-vue''',\" ^",
      "            \"  'import { defineConfig } from ''vite''',\" ^",
      "            \"  '',\" ^",
      "            \"  '// https://vite.dev/config/',\" ^",
      "            \"  'export default defineConfig({',\" ^",
      "            \"  '  plugins: [vue()],',\" ^",
      "            \"  '  server: {',\" ^",
      "            \"  '    proxy: {',\" ^",
      "            \"  '      ''/定义代理标识，如：api'': {',\" ^",
      "            \"  '        target: ''https://目标服务器地址.com'',',\" ^",
      "            \"  '        changeOrigin: true, // 核心：修改请求头host，开启代理',\" ^",
      "            \"  '        // 重写路径',\" ^",
      "            \"  '        rewrite: (path) => path.replace(/^\\/定义代理标识/, ''''),',\" ^",
      "            \"  '      },',\" ^",
      "            \"  '    },',\" ^",
      "            \"  '  },',\" ^",
      "            \"  '})'\" ^",
      "            \");\" ^",
      "            \"$content =$lines -join [Environment]::NewLine;\" ^",
      "            \"[System.IO.File]::WriteAllText('!TARGET_FILE!', $content, [System.Text.Encoding]::UTF8)\"",
      "    )",
      "",
      "    CD ..",
      ")",
      "",
      "",
      "ECHO.启动 Vue 项目",
      "call \".\\!project_name!\\#run_dev.cmd\"",
      "",
      "",
      "endlocal",
      ""
    ],
    "description": ["Vite 创建 Vue 项目"]
  }
}
