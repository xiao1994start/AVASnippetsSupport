{
  "模板插槽": {
    "prefix": ["temp_-vue", "temp#_-vue"],
    "body": ["<template #${1:slots}>", "  $0", "</template>"],
    "description": ["模板插槽"]
  },
  "模板插槽: 标题": {
    "prefix": ["temp#title-vue", "temp_title-vue"],
    "body": ["<template #title>${1:标题}</template>"],
    "description": ["模板插槽: 标题"]
  },
  "模板插槽: 错误": {
    "prefix": ["temp#error-vue", "temp_error-vue"],
    "body": ["<template #error>${1:错误}</template>"],
    "description": ["模板插槽: 错误"]
  },
  "模板插槽: 内部前缀": {
    "prefix": ["temp#prefix-vue", "temp_prefix-vue"],
    "body": ["<template #prefix>${1:内部前缀}</template>"],
    "description": ["模板插槽: 内部前缀"]
  },
  "模板插槽: 外部前缀": {
    "prefix": ["temp#prepend-vue", "temp_prepend-vue"],
    "body": ["<template #prepend>${1:外部前缀}</template>"],
    "description": ["模板插槽: 外部前缀"]
  },
  "模板插槽: 外部后缀": {
    "prefix": ["temp#append-vue", "temp_append-vue"],
    "body": ["<template #append>${1:外部后缀}</template>"],
    "description": ["模板插槽: 外部后缀"]
  },
  "div class=''": {
    "prefix": ["div_class_"],
    "body": ["<div class='${2:}'>", "  ${1:div}", "</div>", ""],
    "description": ["div class=''"]
  },
  "style 标签内样式": {
    "prefix": ["sss_-style"],
    "body": ["style=\"${1:}\""],
    "description": ["style 标签内样式"]
  },
  "style 内外间距0": {
    "prefix": ["s_padding_margin_-style"],
    "body": ["style=\"padding: 0;margin: 0;\" $0"],
    "description": ["style 内外间距0"]
  },
  "style 弹性-垂直样式": {
    "prefix": ["s_display_flex_column_-style"],
    "body": ["style=\"display: flex;flex-direction: column;\" $0"],
    "description": ["style 弹性-垂直样式"]
  },
  "style 填充-换行样式": {
    "prefix": ["s_flex_height_auto_-style"],
    "body": ["style=\"flex: 1;height: auto;white-space: normal;line-height: normal;word-break: break-word;padding: 8px;\" $0"],
    "description": ["style 填充-换行样式"]
  }
}
