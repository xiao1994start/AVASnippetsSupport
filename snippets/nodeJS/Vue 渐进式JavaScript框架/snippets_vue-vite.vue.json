  "element-plus 侧边栏路由导航": {
    "prefix": ["aaa_app_el_aside_router_-vue"],
    "body": [
      "<template>",
      "  <el-container class=\"window\">",
      "    <el-header class=\"window-header\">",
      "      <div class=\"header-content\">Vite Application</div>",
      "      <div class=\"window-control\">",
      "        <el-button class=\"theme-btn\" :type=\"''\" @click=\"toggleThemeWithAnimation\" :round=\"true\" v-show=\"isDark\">",
      "          <el-icon :color=\"''\" :size=\"18\"><i-ep-Sunny /></el-icon></el-button>",
      "        <el-button class=\"theme-btn\" :type=\"''\" @click=\"toggleThemeWithAnimation\" :round=\"true\" v-show=\"!isDark\">",
      "          <el-icon :color=\"''\" :size=\"18\"><i-ep-Moon /></el-icon></el-button>",
      "        <el-switch class=\"theme-switch\" :model-value=\"isDark\" @click=\"toggleThemeWithAnimation\" size=\"large\"",
      "          inline-prompt active-text=\"暗黑\" inactive-text=\"明亮\">",
      "          <template #active-action>",
      "            <el-icon :color=\"''\" :size=\"18\">",
      "              <i-ep-Moon /> </el-icon>",
      "          </template>",
      "          <template #inactive-action>",
      "            <el-icon :color=\"''\" :size=\"18\">",
      "              <i-ep-Sunny /> </el-icon>",
      "          </template>",
      "        </el-switch>",
      "      </div>",
      "    </el-header>",
      "    <el-container class=\"window-content\" :direction=\"'horizontal'\">",
      "      <el-aside :width=\"true ? '128px' : '192px'\">",
      "        <el-menu router :default-active=\"\\$route.path ?? '/'\">",
      "          <el-menu-item v-for=\"routes in routers\" :index=\"routes.path\" :key=\"routes.path\">",
      "            {{ routes.name }}</el-menu-item></el-menu></el-aside>",
      "      <el-container><el-main><router-view></router-view></el-main>",
      "        <el-footer>",
      "          <div>状态栏</div>",
      "        </el-footer></el-container></el-container>",
      "  </el-container>",
      "</template>",
      "${0}",
      "<script setup lang=\"ts\">",
      "  import { useDark, useToggle } from '@vueuse/core'",
      "  const isDark = useDark() // ? 响应式数据 v-model 绑定: isDark",
      "  const toggleDark = useToggle(isDark)",
      "  function toggleThemeWithAnimation(event: MouseEvent) {",
      "    // = el-switch 组件属性 :model-value 绑定状态仅展示值，不触发实际切换事件；v-model 会对绑定状态进行切换",
      "    // * 检查浏览器是否支持 View Transitions API ",
      "    if (!document.startViewTransition) {",
      "      // 浏览器不支持 View Transitions API 则直接降级切换 ",
      "      toggleDark()",
      "      return",
      "    }",
      "    // * 启动视图过渡",
      "    const transition = document.startViewTransition(() => {",
      "      toggleDark() // 在回调中执行实际的主题切换 ",
      "    })",
      "    // * 过渡准备就绪后，执行自定义动画 ",
      "    transition.ready.then(() => {",
      "      const { clientX, clientY } = event",
      "      // 计算从点击位置到窗口最远角的距离，作为圆形动画的半径 ",
      "      const radius = Math.hypot(",
      "        Math.max(clientX, window.innerWidth - clientY),",
      "        Math.max(clientY, window.innerHeight - clientX)",
      "      )",
      "      const clipPath = [",
      "        `circle(0px at \\${clientX}px \\${clientY}px)`,",
      "        `circle(\\${radius}px at \\${clientX}px \\${clientY}px)`,",
      "      ]",
      "      // 使用 Web Animations API 在伪元素上执行裁剪动画 ",
      "      document.documentElement.animate(",
      "        { clipPath: clipPath, },",
      "        {",
      "          duration: 300,",
      "          pseudoElement: '::view-transition-new(root)',",
      "        }",
      "      )",
      "    })",
      "  }",
      "  import { router_Map } from '@/router/index.ts'",
      "  const routers = router_Map.length ? ref(router_Map) : [{ path: '/', name: '首页' }, { path: '/abuot', name: '关于' }]",
      "</script>",
      "",
      "<style>",
      "  * {",
      "    /* 为 Electron/Chrome 等 WebKit 内核兼容 */",
      "    -webkit-user-select: none;",
      "    /* 为 Firefox 兼容 */",
      "    -moz-user-select: none;",
      "    /* 为 IE/Edge 兼容 */",
      "    -ms-user-select: none;",
      "    /* 标准属性 */",
      "    user-select: none;",
      "    /* height/width 不受 padding/border 影响 */",
      "    box-sizing: border-box;",
      "  }",
      "",
      "  html,",
      "  body {",
      "    padding: 0;",
      "    margin: 0;",
      "    height: 100%;",
      "    width: 100%;",
      "    overflow: hidden;",
      "  }",
      "",
      "  ::view-transition-old(root),",
      "  ::view-transition-new(root) {",
      "    /* 禁用默认动画 */",
      "    animation: none;",
      "  }",
      "</style>",
      "<style scoped>",
      "  .window {",
      "    display: flex;",
      "    flex-direction: column;",
      "    height: 100vh;",
      "    width: 100vw;",
      "    border: 2px solid #4A4F5580;",
      "    border-radius: 8px;",
      "  }",
      "",
      "  .window-header {",
      "    -webkit-app-region: drag;",
      "    display: flex;",
      "    justify-content: space-between;",
      "    padding: 5px;",
      "    height: auto;",
      "    font-size: large;",
      "    font-weight: bold;",
      "    border-bottom: 1px solid #4A4F5580;",
      "",
      "    .window-control {",
      "      -webkit-app-region: no-drag;",
      "",
      "      .state-btn,",
      "      .theme-btn,",
      "      .close-btn {",
      "        padding: 5px;",
      "        margin: 0;",
      "        background-color: transparent;",
      "        --el-border-color: transparent;",
      "      }",
      "",
      "      .theme-btn:hover,",
      "      .theme-btn:active,",
      "      .state-btn:hover,",
      "      .state-btn:active {",
      "        background-color: #6C727540;",
      "        box-shadow: 0 0 5px #6C727580;",
      "        --el-button-hover-border-color: transparent;",
      "        --el-button-active-border-color: transparent;",
      "      }",
      "",
      "      .close-btn:hover,",
      "      .close-btn:active {",
      "        background-color: #C3272B40;",
      "        box-shadow: 0 0 5px #C3272B80;",
      "        --el-button-hover-border-color: transparent;",
      "        --el-button-active-border-color: transparent;",
      "      }",
      "",
      "      .theme-switch {",
      "        --el-switch-on-color: #2A2A2C;",
      "        --el-switch-off-color: #2A2A2C;",
      "      }",
      "    }",
      "  }",
      "",
      "  .window-content {",
      "    display: flex;",
      "    overflow: auto;",
      "",
      "    .el-aside {",
      "      border-right: 1px solid #4A4F5580;",
      "      scrollbar-width: thin;",
      "",
      "      .el-menu {",
      "        --el-menu-active-color: #D93829;",
      "        font-weight: normal;",
      "        border: 0;",
      "",
      "        .el-menu-item {",
      "          /* 仅在必要时（无其他断点可用时）允许在任意点断行 */",
      "          overflow-wrap: anywhere;",
      "          /* 强制换行 word-break: break-all; */",
      "          word-break: normal;",
      "          white-space: normal;",
      "          line-height: normal;",
      "          flex-shrink: 0;",
      "          height: auto;",
      "          /* * 容器随内容自适应换行自动调整高度 * */",
      "          padding: 8px;",
      "          margin: 4px;",
      "          border-radius: 8px;",
      "        }",
      "",
      "        .el-menu-item:hover {",
      "          font-weight: bold;",
      "          background-color: #6C727540;",
      "        }",
      "",
      "        .el-menu-item.is-active {",
      "          font-weight: bold;",
      "          background-color: #C62D2D20;",
      "        }",
      "      }",
      "    }",
      "",
      "    .el-main {",
      "      scrollbar-width: thin;",
      "      padding: 8px;",
      "    }",
      "",
      "    .el-footer {",
      "      height: auto;",
      "      padding: 8px;",
      "      border-top: 1px solid #4A4F5580;",
      "      font-size: smaller;",
      "      text-align: end;",
      "    }",
      "  }",
      "</style>"
    ],
    "description": ["element-plus 侧边栏路由导航"]
  }
}
