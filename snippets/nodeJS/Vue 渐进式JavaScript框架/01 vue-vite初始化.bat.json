      "      \"  ' * * createWebHashHistory: 创建路由哈希模式实例（无需服务器配置，兼容性好，本地协议静态文件） ',\" ^",
      "      \"  ' */ ',\" ^",
      "      \"  'const router = createRouter({ ',\" ^",
