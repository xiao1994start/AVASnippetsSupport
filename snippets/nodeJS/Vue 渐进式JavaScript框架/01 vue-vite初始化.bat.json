      "    \"\\$json = \\$json  -replace '(?ms)/\\*.*?\\*/' -replace '(?m)(?<=^([^'']|''[^'']*'')*)//.*' | ConvertFrom-Json;\" ^",
      "    \"if (\\$null -eq \\$json) { \\$json = [pscustomobject]@{} };\" ^",
      "    \"if (-not \\$json.PSObject.Properties['paths']) { Add-Member -InputObject \\$json -MemberType NoteProperty -Name paths -Value ([pscustomobject]@{'@/*'=@('./src/*')}) };\" ^",
      "    \"\\$json | ConvertTo-Json -Depth 100 | Set-Content -Path \\$path -Encoding UTF8\"",
      "  setlocal EnableDelayedExpansion",
      "ECHO.重写 vite.config.ts 文件",
