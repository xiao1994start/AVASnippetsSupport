      "    \"  ''\" ^",
      "    \") -join [Environment]::NewLine;\" ^",
      "    \"[System.IO.File]::WriteAllText(\\$filePath, \\$lines, [System.Text.Encoding]::UTF8)\"",
      "  setlocal EnableDelayedExpansion",
      "ECHO.写入 src/router/index.ts 路由文件",
      "  if not exist \"%~dp0%project_name%\\src\\router\" ( md \"%~dp0%project_name%\\src\\router\" )",
      "  if not exist \"%~dp0%project_name%\\src\\router\\index.ts\" (",
