{
  "安装 unplugin vue/vite 插件系统": {
    "prefix": ["npm_unplugin_vue_vite"],
    "body": [
      "ECHO.* 安装 unplugin-vue-components unplugin-auto-import 自动导入插件 :: https://element-plus.org/zh-CN/guide/quickstart#%E8%87%AA%E5%8A%A8%E5%AF%BC%E5%85%A5-%E6%8E%A8%E8%8D%90",
      "call npm i unplugin-vue-components unplugin-auto-import -D --registry https://registry.npmmirror.com/",
      "call npm i unplugin-icons -D --registry https://registry.npmmirror.com/",
      "@REM  # 配置方法",
      "@REM  - vite.config.ts 配置自动导入插件：",
      "@REM    ...import...",
      "@REM    import AutoImport from 'unplugin-auto-import/vite' // * 引入 AutoImport 插件",
      "@REM    import Components from 'unplugin-vue-components/vite' // * 引入 Components 插件",
      "@REM    import { ElementPlusResolver } from 'unplugin-vue-components/resolvers' // * 引入 ElementPlusResolver 解析器",
      "@REM    import { fileURLToPath, URL } from 'node:url'",
      "@REM    export default defineConfig({",
      "@REM      plugins: [...",
      "@REM        AutoImport({ imports: ['vue'], resolvers: [ElementPlusResolver()], dts: 'src/auto-imports.d.ts' }),,",
      "@REM        Components({",
      "@REM          resolvers: [ElementPlusResolver(), IconsResolver({ enabledCollections: ['ep'] })],",
      "@REM          dts: 'src/components.d.ts',",
      "@REM        }),",
      "@REM        Icons({ autoInstall: true, scale: 1 }),",
      "@REM      ...],",
      "@REM      resolve: {",
      "@REM        alias: {",
      "@REM          // * 配置import路径别名: @ => ./src",
      "@REM          '@': fileURLToPath(new URL('./src', import.meta.url)),",
      "@REM        },",
      "@REM      },",
      "@REM    })",
      "@REM  ! 不要配置 ./src/main.ts 中 ElementPlus element-plus组件库",
      "if not exist \".\\vite.config_unplugin.ts\" (",
      "    set \"TARGET_FILE=.\\vite.config_unplugin.ts\"",
      "    ECHO.写入 unplugin 自动导入插件配置文件",
      "    powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "        \"$lines = @(\" ^",
      "        \"  '/**',\" ^",
      "        \"  ' * # unplugin 自动导入插件配置文件',\" ^",
      "        \"  ' * @use ./vite.config.ts 中引入 =>',\" ^",
      "        \"  ' *   import unplugin_Config from ''./vite.config_unplugin.ts''',\" ^",
      "        \"  ' *     plugins: [vue(), ...],',\" ^",
      "        \"  ' *   })',\" ^",
      "        \"  ' */',\" ^",
      "        \"  'import AutoImport from ''unplugin-auto-import/vite'' // * 引入 AutoImport 插件',\" ^",
      "        \"  'import Components from ''unplugin-vue-components/vite'' // * 引入 Components 插件',\" ^",
      "        \"  'import { ElementPlusResolver } from ''unplugin-vue-components/resolvers'' // * 引入 ElementPlusResolver 解析器',\" ^",
      "        \"  'import Icons from ''unplugin-icons/vite''',\" ^",
      "        \"  'import IconsResolver from ''unplugin-icons/resolver''',\" ^",
      "        \"  'const unplugin_Config = {',\" ^",
      "        \"  '  plugins: [',\" ^",
      "        \"  '    AutoImport({ imports: [''vue''], resolvers: [ElementPlusResolver()], dts: ''src/auto-imports.d.ts'' }),',\" ^",
      "        \"  '    Components({',\" ^",
      "        \"  '      resolvers: [ElementPlusResolver(), IconsResolver({ enabledCollections: [''ep''] })],',\" ^",
      "        \"  '      dts: ''src/components.d.ts'',',\" ^",
      "        \"  '    }),',\" ^",
      "        \"  '    Icons({ autoInstall: true, scale: 1 }), // * 挂载 Icons 插件',\" ^",
      "        \"  '  ],',\" ^",
      "        \"  '}',\" ^",
      "        \"  'export default unplugin_Config'\" ^",
      "        \");\" ^",
      "        \"$content =$lines -join [Environment]::NewLine;\" ^",
      "        \"[System.IO.File]::WriteAllText('!TARGET_FILE!', $content, [System.Text.Encoding]::UTF8)\"",
      ")",
      ""
    ],
    "description": ["安装 unplugin vue/vite 插件系统"]
  }
}
