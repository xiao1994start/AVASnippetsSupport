{
  "安装 express Web应用框架": {
    "prefix": ["npm_express"],
    "body": [
      "ECHO.+ 安装 express Web应用框架 类型提示",
      "call npm i express @types/express --registry https://registry.npmmirror.com/",
      ""
    ],
    "description": ["安装 express Web应用框架"]
  },
  "初始化 express 项目": {
    "prefix": ["init_express_"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "@REM ====================== 基础环境配置 ======================",
      "@REM * 初始化 node 环境目录",
      "if not exist \"%~dp0node\" ( for /D %%i in (\"*node*\") do ( if /I \"%%~nxi\" NEQ \"node_modules\" ( ren \"%%i\" \"node\" ) ) )",
      "@REM * 定义 node 环境变量",
      "set \"local_node=%~dp0node\"",
      "@REM * 设置临时系统环境变量",
      "set \"NODE_PATH=!local_node!;!local_node!\\node_modules;\"",
      "set \"PATH=!NODE_PATH!;%PATH%;\"",
      "",
      "ECHO.= node 版本号: && call node -v",
      "ECHO.= npm 版本号: && call npm -v",
      "",
      "ECHO.- 清理 npm 缓存（禁用：推荐的保护功能）",
      "call npm cache clean --force",
      "ECHO.+ 升级 npm",
      "call npm i -g npm --registry https://registry.npmmirror.com/",
      "ECHO.= 检查 软件仓库位置:",
      "call npm root -g",
      "",
      "@REM  @REM * 替换 npm 国内镜像源（全局）",
      "@REM  ECHO.npm 设置为淘宝镜像源",
      "@REM  call npm config set registry https://registry.npmmirror.com/",
      "@REM * 替换 npm 国内镜像源（临时）",
      "set registry=https://registry.npmmirror.com/",
      "",
      "@REM ====================== Void 构建 Vue 项目 ======================",
      "",
      "set \"project_name=express-${1:111}\"",
      "",
      "@REM  ===  初始化项目 ===",
      "if not exist \"%~dp0%project_name%\\\" (",
      "  md \"%~dp0%project_name%\"",
      "  CD \"%~dp0%project_name%\"",
      "  set \"NODE_PATH=%~dp0node;%~dp0node\\node_modules;%~dp0node_modules;%~dp0node_modules\\.bin;%~dp0%project_name%\\node_modules;%~dp0%project_name%\\node_modules\\.bin;\"",
      "  set \"PATH=!NODE_PATH!;%PATH%;\"",
      "  call ECHO.* 初始化 express 项目",
      "  call npm init -y",
      "  ECHO.+ 安装 express Web应用框架 类型提示",
      "  call npm i express @types/express --registry https://registry.npmmirror.com/",
      "  @REM * 安装必备依赖",
      "  ECHO.* 安装 项目依赖",
      "  call npm i --registry https://registry.npmmirror.com/",
      "  ECHO.+ TypeScript :: @types/node 类型定义; typescript 构建工具; tsx 运行时加速器（监听文件变化 tsx watch filePath）",
      "  call npm i -g @types/node typescript tsx --registry https://registry.npmmirror.com/",
      "  call npm i -D @types/node typescript tsx --registry https://registry.npmmirror.com/",
      "  ",
      "  @REM  * axios 请求库",
      "  ECHO.* 安装 axios 请求库 :: https://www.axios-http.cn/",
      "  call npm i axios --registry https://registry.npmmirror.com/",
      "  @REM  * cors 跨域跨源资源共享中间件",
      "  ECHO.安装 cors 跨域跨源资源共享中间件",
      "  call npm i cors @types/cors --registry https://registry.npmmirror.com/",
      "  CD /D \"%~dp0\"",
      ")",
      "if exist \"%~dp0%project_name%\\\" (",
      "  CD \"%~dp0%project_name%\"",
      "  ECHO.= 安全机制批准 + 重建项目依赖",
      "  @REM  ! npm approve-scripts::https://npm.nodejs.cn/cli/v12/commands/npm-approve-scripts",
      "  @REM  ? --all 一次性批准每个带有未经审核安装脚本的软件包",
      "  @REM  ? --allow-scripts-pending 允许批准带有未经审核安装脚本的软件包",
      "  call npm approve-scripts --allow-scripts-pending && call npm install-scripts approve --all",
      "  if not exist \"%~dp0%project_name%\\tsconfig.json\" (",
      "    @REM  * 初始化 TypeScript",
      "    ECHO.初始化 tsconfig.json",
      "    call npx tsc --init",
      "  )",
      "  if not exist \"%~dp0%project_name%\\#npm_package.cmd\" (",
      "    ECHO.* 写入项目依赖管理脚本",
      "    (  ECHO.@ECHO OFF",
      "    ECHO.setlocal EnableDelayedExpansion",
      "    ECHO.CD /D \"%%~dp0\"",
      "    ECHO.@REM * 设置环境变量",
      "    ECHO.if not exist \"%%~dp0..\\node\" ECHO.请先配置 nodeJS 环境 ^&^& EXIT /B",
      "    ECHO.set \"local_node=%%~dp0..\\node\"",
      "    ECHO.@REM * 添加临时系统环境变量",
      "    ECHO.set \"NODE_PATH=%%local_node%%\\;%%local_node%%\\node_modules\\;%%~dp0node_modules;%%~dp0node_modules\\.bin;\"",
      "    ECHO.set \"PATH=%%NODE_PATH%%;%%PATH%%;\"",
      "    ECHO.call npm i --registry https://registry.npmmirror.com/",
      "    ECHO.@REM  ====================== ** npm ** ======================",
      "    ECHO.",
      "    ECHO.endlocal",
      "    )>\"%~dp0%project_name%\\#npm_package.cmd\"",
      "  )",
      "  if not exist \"%~dp0%project_name%\\public\\\" ( ECHO 创建 public 公共目录 && md \"%~dp0%project_name%\\public\\\" )",
      "  if not exist \"%~dp0%project_name%\\src\\\" ( ECHO 创建 src 目录 && md \"%~dp0%project_name%\\src\\\" )",
      "  if not exist \"%~dp0%project_name%\\src\\utils\\\" ( ECHO 创建 src\\utils 工具目录 && md \"%~dp0%project_name%\\src\\utils\\\" )",
      "  CD /D \"%~dp0\"",
      ")",
      "@REM  ===  集成配置 ===",
      "if exist \"%~dp0%project_name%\\package.json\" (",
      "  ECHO.配置 package.json",
      "  set \"JSON_FILE=%~dp0%project_name%\\package.json\"",
      "  powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$path = \\$env:JSON_FILE;\" ^",
      "  \"\\$json = Get-Content -Raw -Encoding UTF8 \\$path;\" ^",
      "  \"\\$pattern = '(?m)^[ \\t]*(?://[^\\r\\n]*|/\\*[\\s\\S]*?\\*/)[ \\t]*(?:\\r?\\n|\\r|\\$)';\" ^",
      "  \"\\$evaluator = [System.Text.RegularExpressions.MatchEvaluator]{ param(\\$m) if (\\$m.Groups['s'].Success) { \\$m.Value } else { '' } };\" ^",
      "  \"\\$json = [regex]::Replace(\\$json, \\$pattern, \\$evaluator) | ConvertFrom-Json;\" ^",
      "  \"\\$obj = \\$json;\" ^",
      "  \"\\$key = 'type';\" ^",
      "  \"\\$val = ('module');\" ^",
      "  \"Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force;\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$path, (\\$json | ConvertTo-Json -Depth 100), \\$utf8NoBom)\"",
      ")",
      "if exist \"%~dp0%project_name%\\tsconfig.json\" (",
      "  ECHO.配置 tsconfig.json",
      "  set \"JSON_FILE=%~dp0%project_name%\\tsconfig.json\"",
      "  powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$path = \\$env:JSON_FILE;\" ^",
      "  \"\\$raw = Get-Content -Raw -Encoding UTF8 \\$path;\" ^",
      "  \"\\$pattern = '(?<s>`\"\"(\\.|[^`\"\"\\\\\\])*`\"\")|//[^\\r\\n]*|/\\*[\\s\\S]*?\\*/';\" ^",
      "  \"\\$evaluator = [System.Text.RegularExpressions.MatchEvaluator]{ param(\\$m) if (\\$m.Groups['s'].Success) { \\$m.Value } else { '' } };\" ^",
      "  \"\\$clean = [regex]::Replace(\\$raw, \\$pattern, \\$evaluator);\" ^",
      "  \"\\$clean = [regex]::Replace(\\$clean, ',(?=\\s*[}\\]])', '');\" ^",
      "  \"\\$json = \\$clean | ConvertFrom-Json;\" ^",
      "  \"<# 配置JSON #>\" ^",
      "  \"\\$obj = \\$json;\" ^",
      "  \"\\$key = 'include';\" ^",
      "  \"\\$val = (@('src/**/*'));\" ^",
      "  \"if (-not \\$obj.PSObject.Properties[\\$key]) { Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force };\" ^",
      "  \"\\$obj = \\$json;\" ^",
      "  \"\\$key = 'exclude';\" ^",
      "  \"\\$val = (@('node_modules', 'dist'));\" ^",
      "  \"if (-not \\$obj.PSObject.Properties[\\$key]) { Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force };\" ^",
      "  \"\\$obj = \\$json.compilerOptions;\" ^",
      "  \"\\$key = 'rootDir';\" ^",
      "  \"\\$val = ('./src');\" ^",
      "  \"Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force;\" ^",
      "  \"\\$obj = \\$json.compilerOptions;\" ^",
      "  \"\\$key = 'outDir';\" ^",
      "  \"\\$val = ('./dist');\" ^",
      "  \"Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force;\" ^",
      "  \"\\$obj = \\$json.compilerOptions;\" ^",
      "  \"\\$key = 'types';\" ^",
      "  \"\\$val = (@('node'));\" ^",
      "  \"Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force;\" ^",
      "  \"\\$obj = \\$json.compilerOptions;\" ^",
      "  \"\\$key = 'allowImportingTsExtensions';\" ^",
      "  \"\\$val = (\\$true);\" ^",
      "  \"Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force;\" ^",
      "  \"\\$obj = \\$json.compilerOptions;\" ^",
      "  \"\\$key = 'noEmit';\" ^",
      "  \"\\$val = (\\$true);\" ^",
      "  \"Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force;\" ^",
      "  \"<# 写入JSON配置项 #>\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$path, (\\$json | ConvertTo-Json -Depth 100), \\$utf8NoBom)\"",
      ")",
      "if not exist \"%~dp0%project_name%\\src\\app.ts\" (",
      "  ECHO.初始化 app.ts",
      "  set \"TARGET_FILE=%~dp0%project_name%\\src\\app.ts\"",
      "  powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$lines = '/** @file app.ts 应用入口文件 */ ',\" ^",
      "  \"'import path from ''node:path'' // * 引入 path 路径模块 ',\" ^",
      "  \"'import os from ''node:os'' // * 引入 os 操作系统模块 ',\" ^",
      "  \"'import express from ''express'' // * 引入 express Web应用框架 ',\" ^",
      "  \"'import cors from ''cors'' // * 引入 cors 跨域跨源资源共享中间件 ',\" ^",
      "  \"' ',\" ^",
      "  \"'const app = express() // * 创建 express 应用实例 ',\" ^",
      "  \"'app.use(express.json()) // - 注册: 解析 JSON 格式的请求体中间件 ',\" ^",
      "  \"'app.use(cors()) // - 注册: 跨域跨源资源共享中间件 ',\" ^",
      "  \"' ',\" ^",
      "  \"'const publicDir = path.resolve(''./public'') // * public 文件夹设为静态资源目录 ',\" ^",
      "  \"'app.use(express.static(publicDir, { maxAge: ''1d'' })) // - 注册: 静态资源中间件 http://localhost:\\${PORT} + \\${publicDir目录下文件路径} ',\" ^",
      "  \"' ',\" ^",
      "  \"'const HOST = ''0.0.0.0'' // - 监听主机地址 ',\" ^",
      "  \"'const PORT = 3000 // - 监听端口号 ',\" ^",
      "  \"' ',\" ^",
      "  \"'/** * # 获取局域网 IP 地址 */ ',\" ^",
      "  \"'function getLanIPs(): string[] { ',\" ^",
      "  \"'  const nets = os.networkInterfaces() ',\" ^",
      "  \"'  const ips: string[] = [] ',\" ^",
      "  \"'  for (const name of Object.keys(nets)) { ',\" ^",
      "  \"'    for (const net of nets[name] ?? []) { ',\" ^",
      "  \"'      // 过滤 IPv4、非回环、非内部 ',\" ^",
      "  \"'      if (net.family === ''IPv4'' && !net.internal) { ',\" ^",
      "  \"'        ips.push(net.address) ',\" ^",
      "  \"'      } ',\" ^",
      "  \"'    } ',\" ^",
      "  \"'  } ',\" ^",
      "  \"'  console.log(''LanIPs:'', ips) ',\" ^",
      "  \"'  return ips ',\" ^",
      "  \"'} ',\" ^",
      "  \"'const ips = getLanIPs() ',\" ^",
      "  \"'const ip = ips[0] ',\" ^",
      "  \"' ',\" ^",
      "  \"'app.get(''/'', (req, res) => { ',\" ^",
      "  \"'  console.log(''GET 请求.query:'', req.query) // * GET 请求参数 ',\" ^",
      "  \"'  res.send(''GET_ExpressServer'') // * 响应客户端 ',\" ^",
      "  \"'}) ',\" ^",
      "  \"' ',\" ^",
      "  \"'app.get(''//:id'', (req, res) => { ',\" ^",
      "  \"'  console.log(''GET 请求.params:'', req.params) ',\" ^",
      "  \"'  res.send(`GET_ExpressServer/${req.params.id}`) ',\" ^",
      "  \"'}) ',\" ^",
      "  \"' ',\" ^",
      "  \"'app.post(''/'', async (req, res) => { ',\" ^",
      "  \"'  console.log(''POST 请求.body:'', req.body) ',\" ^",
      "  \"'  res.json({ msg: ''POST_ExpressServer'', ServerURL: `http://\\${ip}:\\${PORT}` }) // * 响应客户端 ',\" ^",
      "  \"'}) ',\" ^",
      "  \"' ',\" ^",
      "  \"'// * 监听端口 ',\" ^",
      "  \"'app.listen(PORT, HOST, () => { ',\" ^",
      "  \"'  console.log(`Server running on 本机: http://localhost:\\${PORT}`) ',\" ^",
      "  \"'  ips.forEach((ip) => console.log(`  局域网: http://\\${ip}:\\${PORT}`)) ',\" ^",
      "  \"'}) ',\" ^",
      "  \"'';\" ^",
      "  \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$filePath, (\\$lines -join [Environment]::NewLine), \\$utf8NoBom)\"",
      ")",
      "if not exist \"%~dp0%project_name%\\src\\utils\\proxyVPN.ts\" (",
      "  ECHO.初始化 proxyVPN.ts 代理VPN工具函数",
      "  set \"TARGET_FILE=%~dp0%project_name%\\src\\utils\\proxyVPN.ts\"",
      "  powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$lines = '/** @file proxyVPN.ts 代理VPN工具函数 */ ',\" ^",
      "  \"'import path from ''node:path'' // * 引入 path 路径模块 ',\" ^",
      "  \"'import fs from ''node:fs'' // * 引入 fs 文件系统模块 ',\" ^",
      "  \"'import axios from ''axios'' // * 引入 axios 请求库 ',\" ^",
      "  \"' ',\" ^",
      "  \"'const baseDir = path.resolve() ',\" ^",
      "  \"' ',\" ^",
      "  \"'export async function proxyVPN(url: string, responseType: boolean = false) { ',\" ^",
      "  \"'  const client = axios.create({ withCredentials: true }) // withCredentials 用于跨域请求时是否需要使用凭证 ',\" ^",
      "  \"'  // * 获取 initialToken 用于请求头 x-stats-id :: https://proxyorb.com/zh-Hans/proxy-site ',\" ^",
      "  \"'  const proxyorb_url = ''https://proxyorb.com/zh-Hans/proxy-site'' ',\" ^",
      "  \"'  const get_initialToken = await client.get(proxyorb_url) ',\" ^",
      "  \"'  // console.log(''获取initialToken_HTML页面内容:'', get_initialToken.data) ',\" ^",
      "  \"'  const regexp_initialToken = /\\\\\\\\\\\\\"\"initialToken\\\\\\\\\\\\\"\"\"\":\\\\\\\\\\\\\"\"\"\"([^^\"\"\"\"\\\\\\]+)\\\\\\\\\\\\\"\"\"\"/',\" ^",
      "  \"'  const initialToken = String(get_initialToken.data).match(regexp_initialToken)?.[1] ',\" ^",
      "  \"'  // console.log(''请求头 x-stats-id:'', initialToken) ',\" ^",
      "  \"'  // * 代理服务器 https://proxyorb.com/api/servers ',\" ^",
      "  \"'  const proxyorb_servers = ''https://proxyorb.com/api/servers'' ',\" ^",
      "  \"'  const form_data = new FormData() ',\" ^",
      "  \"'  form_data.append(''input'', url) ',\" ^",
      "  \"'  const post_req = await client.post(proxyorb_servers, form_data, { headers: { ''x-stats-id'': initialToken } }) ',\" ^",
      "  \"'  const regexp_proxy_url = /<meta\\shttp-equiv=\\\\\\\"\"\"\"x-refresh\\\\\\\"\"\"\"\\scontent=[\"\"\"\"'']([^^\"\"'']+)[\"\"\"\"'']/i',\" ^",
      "  \"'  const proxy_url = String(post_req.data).match(regexp_proxy_url)?.[1] as string ',\" ^",
      "  \"'  // console.log(''代理服务器URL:'', proxy_url) ',\" ^",
      "  \"'  // * 重定向URL ',\" ^",
      "  \"'  const proxy_url_list = proxy_url.split(''&__poss='') ',\" ^",
      "  \"'  const redirectURL = proxy_url_list[0] as string ',\" ^",
      "  \"'  const redirectCookie = (''__poss='' + proxy_url_list[1]) as string ',\" ^",
      "  \"'  const redirect_resp = await client.get(redirectURL, { ',\" ^",
      "  \"'    headers: { ',\" ^",
      "  \"'      ''user-agent'': ',\" ^",
      "  \"'        ''Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36 Edg/157.0.0.0'', ',\" ^",
      "  \"'      cookie: redirectCookie, ',\" ^",
      "  \"'    }, ',\" ^",
      "  \"'    responseType: responseType ? ''arraybuffer'' : ''json'', ',\" ^",
      "  \"'  }) ',\" ^",
      "  \"'  const content_type = redirect_resp.headers[''content-type''] ',\" ^",
      "  \"'  const data = redirect_resp.data ',\" ^",
      "  \"'  console.log(''content-type:'', content_type) ',\" ^",
      "  \"'  ^!responseType && console.log(''data:'', data) ',\" ^",
      "  \"'  return { content_type: content_type, data: data } ',\" ^",
      "  \"'} ',\" ^",
      "  \"' ',\" ^",
      "  \"'export async function getIMG(url: string) { ',\" ^",
      "  \"'  const resp = await proxyVPN(url) ',\" ^",
      "  \"'  let title: string = '''' ',\" ^",
      "  \"'  let src_URL: string = '''' ',\" ^",
      "  \"'  let src_list: string[] = [] ',\" ^",
      "  \"'  let file_name: string = '''' ',\" ^",
      "  \"'  let img_url: string = '''' ',\" ^",
      "  \"'  let img_path: string = '''' ',\" ^",
      "  \"'  title = resp.data.title ',\" ^",
      "  \"'  src_URL = resp.data.src ',\" ^",
      "  \"'  src_list = src_URL.split(''/'') ',\" ^",
      "  \"'  file_name = src_list.at(-1) as string ',\" ^",
      "  \"'  img_url = `\\${title}/\\${file_name}` ',\" ^",
      "  \"'  img_path = path.resolve(baseDir, ''public'', img_url) ',\" ^",
      "  \"'  if (^!fs.existsSync(img_path)) { ',\" ^",
      "  \"'    console.log(''下载图片:'', src_URL) ',\" ^",
      "  \"'    const img_resp = await proxyVPN(src_URL, true) ',\" ^",
      "  \"'    const buffer = Buffer.from(img_resp.data) ',\" ^",
      "  \"'    await fs.promises.mkdir(path.join(img_path, ''../''), { recursive: true }) ',\" ^",
      "  \"'    await fs.promises.writeFile(img_path, buffer) ',\" ^",
      "  \"'    console.log(''图片下载完成:'', img_path) ',\" ^",
      "  \"'  } ',\" ^",
      "  \"'  return { img_url: img_url, img_path: img_path } ',\" ^",
      "  \"'} ',\" ^",
      "  \"' ',\" ^",
      "  \"'if (import.meta.main) { ',\" ^",
      "  \"'  // * 调试当前脚本 ',\" ^",
      "  \"'  let url = ''https://www.tuzac.com/api/?ac=get_random_photo_by_tag&tag=福利姬'' ',\" ^",
      "  \"'  await getIMG(url) ',\" ^",
      "  \"'} ',\" ^",
      "  \"'';\" ^",
      "  \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$filePath, (\\$lines -join [Environment]::NewLine), \\$utf8NoBom)\"",
      ")",
      "",
      "endlocal",
      ""
    ],
    "description": ["初始化 express 项目"]
  }
}
