{
  "tsdown 构建node项目": {
    "prefix": ["init_tsdown_node"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "@REM ====================== 基础环境配置 ======================",
      "@REM * 标化 node 环境目录",
      "if not exist \"%~dp0node\" ( for /D %%i in (\"*node*\") do ( if /I \"%%~nxi\" NEQ \"node_modules\" ( ren \"%%i\" \"node\" ) ) )",
      "@REM  * 定义 node 环境变量",
      "set \"local_node=%~dp0node\"",
      "@REM  * 设置临时系统环境变量",
      "set \"NODE_PATH=!local_node!;!local_node!\\node_modules;\"",
      "set \"PATH=!NODE_PATH!;%PATH%;\"",
      "",
      "@REM  ECHO.= node 版本号: && call node -v",
      "@REM  ECHO.= npm 版本号: && call npm -v",
      "",
      "@REM  ECHO.- 清理 npm 缓存（禁用：推荐的保护功能）",
      "@REM  call npm cache clean --force",
      "@REM  ECHO.+ 升级 npm",
      "@REM  call npm i npm -g --registry https://registry.npmmirror.com/",
      "@REM  ECHO.= 检查 软件仓库位置:",
      "@REM  call npm root -g",
      "",
      "@REM  @REM * 替换 npm 国内镜像源（全局）",
      "@REM  ECHO.npm 设置为淘宝镜像源",
      "@REM  call npm config set registry https://registry.npmmirror.com/",
      "@REM  @REM  ! npm approve-scripts::https://npm.nodejs.cn/cli/v12/commands/npm-approve-scripts",
      "@REM  @REM  ? --all 一次性批准每个带有未经审核安装脚本的软件包",
      "@REM  @REM  ? --allow-scripts-pending 允许批准带有未经审核安装脚本的软件包",
      "@REM  call npm approve-scripts --allow-scripts-pending",
      "",
      "@REM  ECHO.+ tsdown 构建工具 【https://github.com/rolldown/tsdown】",
      "@REM  call npm i tsdown -g --registry https://registry.npmmirror.com/",
      "",
      "@REM  === tsdown 初始化构建项目 ===",
      "",
      "set \"project_name=tsdown-${1:ts}\"",
      "",
      "if not exist \"%~dp0%project_name%\" (",
      "  @REM  ====================== tsdown 构建项目配置 ======================",
      "  @REM  ! 不要开代理",
      "  @REM  ■  Error: Failed to download https://api.github.com/repos/sxzz/tsdown-templates/tarball/main: TypeError: fetch failed",
      "  @REM  ■  Canceled",
      "  ECHO.tsdown 构建项目配置:",
      "  @REM  中文官网::https://tsdown.dev/zh-CN/",
      "  @REM  文档::https://tsdown.dev/zh-CN/guide/",
      "  ECHO.*  Ok to proceed? ^(y^) :  Yes/y/Enter",
      "  ECHO.*  ? Which template do you want to use?  default（按需选择，default适用纯脚本项目）",
      "  call npm create tsdown@latest \"%~dp0%project_name%\"",
      "  CD \"%~dp0%project_name%\"",
      "  set \"NODE_PATH=%~dp0node;%~dp0node\\node_modules;%~dp0node_modules;%~dp0node_modules\\.bin;%~dp0%project_name%\\node_modules;%~dp0%project_name%\\node_modules\\.bin;\"",
      "  set \"PATH=!NODE_PATH!;%PATH%;\"",
      "  ECHO.* 安装 项目依赖",
      "  call npm i --registry https://registry.npmmirror.com/",
      "  ECHO.+ 【本地开发必装】安装 @types/node 类型定义",
      "  call npm i @types/node -D --registry https://registry.npmmirror.com/",
      "  ECHO.+ 安装 typescript 模块",
      "  call npm i typescript -g --registry https://registry.npmmirror.com/",
      "  call npm i typescript --registry https://registry.npmmirror.com/",
      "  ECHO.+ 【TypeScript】安装 tsx 运行时加速器",
      "  call npm i tsx -g --registry https://registry.npmmirror.com/",
      "  call npm i tsx --registry https://registry.npmmirror.com/",
      "  @REM  * inquirer 终端交互模块",
      "  ECHO.+ 安装 inquirer 终端交互模块",
      "  call npm i inquirer -g --registry https://registry.npmmirror.com/",
      "  call npm i inquirer --registry https://registry.npmmirror.com/",
      "  CD /D \"%~dp0\"",
      ")",
      "if exist \"%~dp0%project_name%\" (",
      "  if not exist \"%~dp0%project_name%\\#npm_package.cmd\" (",
      "    ECHO.写入 tsdown 项目依赖管理脚本",
      "    setlocal DisableDelayedExpansion",
      "    set \"TARGET_FILE=%~dp0%project_name%\\#npm_package.cmd\"",
      "    powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "    \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "    \"\\$lines = @(\" ^",
      "    \"  '@ECHO OFF ',\" ^",
      "    \"  'setlocal EnableDelayedExpansion ',\" ^",
      "    \"  'CD /D \\\"%%~dp0\\\" ',\" ^",
      "    \"  '@REM * 设置环境变量 ',\" ^",
      "    \"  'if not exist \\\"%%~dp0..\\node\\\" ECHO.请先配置 nodeJS 环境 ^&^& EXIT /B ',\" ^",
      "    \"  'set \\\"local_node=%%~dp0..\\node\\\" ',\" ^",
      "    \"  '@REM * 添加临时系统环境变量 ',\" ^",
      "    \"  'set \\\"NODE_PATH=%%local_node%%\\;%%local_node%%\\node_modules\\;%%~dp0node_modules;%%~dp0node_modules\\.bin;\\\" ',\" ^",
      "    \"  'set \\\"PATH=%%NODE_PATH%%;%%PATH%%;\\\" ',\" ^",
      "    \"  'call npm i --registry https://registry.npmmirror.com/ ',\" ^",
      "    \"  '@REM  ====================== ** npm ** ====================== ',\" ^",
      "    \"  ' ',\" ^",
      "    \"  ' ',\" ^",
      "    \"  ' ',\" ^",
      "    \"  'endlocal ',\" ^",
      "    \"  ''\" ^",
      "    \") -join [Environment]::NewLine;\" ^",
      "    \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "    \"[System.IO.File]::WriteAllText(\\$filePath, [string]\\$lines, \\$utf8NoBom)\"",
      "    setlocal EnableDelayedExpansion",
      "  )",
      "  if not exist \"%~dp0%project_name%\\#run_build.cmd\" (",
      "    ECHO.写入 tsdown 项目构建文件",
      "    setlocal DisableDelayedExpansion",
      "    set \"TARGET_FILE=%~dp0%project_name%\\#run_build.cmd\"",
      "    powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "    \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "    \"\\$lines = @(\" ^",
      "    \"  '@ECHO OFF ',\" ^",
      "    \"  'setlocal EnableDelayedExpansion ',\" ^",
      "    \"  'CD /D \\\"%%~dp0\\\" ',\" ^",
      "    \"  '@REM * 设置环境变量 ',\" ^",
      "    \"  'if not exist \\\"%%~dp0..\\node\\\" ECHO.请先配置 nodeJS 环境 ^&^& EXIT /B ',\" ^",
      "    \"  'set \\\"local_node=%%~dp0..\\node\\\" ',\" ^",
      "    \"  '@REM * 添加临时系统环境变量 ',\" ^",
      "    \"  'set \\\"NODE_PATH=%%local_node%%\\;%%local_node%%\\node_modules\\;%%~dp0node_modules;%%~dp0node_modules\\.bin;\\\" ',\" ^",
      "    \"  'set \\\"PATH=%%NODE_PATH%%;%%PATH%%;\\\" ',\" ^",
      "    \"  ' ',\" ^",
      "    \"  '@REM * 构建 可执行文件 ',\" ^",
      "    \"  'call npm run build ',\" ^",
      "    \"  ' ',\" ^",
      "    \"  'endlocal ',\" ^",
      "    \"  ''\" ^",
      "    \") -join [Environment]::NewLine;\" ^",
      "    \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "    \"[System.IO.File]::WriteAllText(\\$filePath, [string]\\$lines, \\$utf8NoBom)\"",
      "    setlocal EnableDelayedExpansion",
      "  )",
      ")",
      "if not exist \"%~dp0%project_name%\\tsdown.config.build.ts\" (",
      "  ECHO.写入 tsdown 项目构建配置文件参考",
      "  setlocal DisableDelayedExpansion",
      "  set \"TARGET_FILE=%~dp0%project_name%\\tsdown.config.build.ts\"",
      "  powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "  \"\\$lines = @(\" ^",
      "  \"  'import { UserConfig } from ''tsdown'' ',\" ^",
      "  \"  '// https://tsdown.dev/zh-CN/reference/cli ',\" ^",
      "  \"  'const userConfig: UserConfig = { ',\" ^",
      "  \"  '  dts: { ',\" ^",
      "  \"  '    generator: ''tsgo'', // * 声明文件生成器 ',\" ^",
      "  \"  '    // ? ''tsc'' 支持完整的 TypeScript 类型系统 ',\" ^",
      "  \"  '    // ? ''oxc'' 速度更快，但需要与 isolatedDeclarations 兼容的代码 ',\" ^",
      "  \"  '    // ? ''tsgo'' 使用了实验性的 TypeScript Go 编译器 ',\" ^",
      "  \"  '  }, ',\" ^",
      "  \"  '  exports: true, // * 是否导出模块生成 package.json ',\" ^",
      "  \"  '  // ...config options ',\" ^",
      "  \"  '  entry: [''./src/cli.ts''], // - 声明构建时的入口文件 ',\" ^",
      "  \"  '  // * 声明需要打包的依赖项 ',\" ^",
      "  \"  '  deps: { ',\" ^",
      "  \"  '    alwaysBundle: [''inquirer''], // - 声明需要打包的依赖项 ',\" ^",
      "  \"  '  }, ',\" ^",
      "  \"  '  exe: { ',\" ^",
      "  \"  '    // - 声明可执行文件的配置 ',\" ^",
      "  \"  '    fileName: ''myApp'', // * 声明可执行文件的名称 ',\" ^",
      "  \"  '    seaConfig: { ',\" ^",
      "  \"  '      // * 禁用实验性警告 (默认: true) ',\" ^",
      "  \"  '      disableExperimentalSEAWarning: true, ',\" ^",
      "  \"  '      // * 使用 V8 快照加速启动 (默认: false) 建议''关闭'' ',\" ^",
      "  \"  '      useSnapshot: false, ',\" ^",
      "  \"  '      // * 使用 V8 代码缓存加速启动 (默认: false) 建议''开启'' ',\" ^",
      "  \"  '      useCodeCache: true, ',\" ^",
      "  \"  '      // * 运行时如何扩展 execArgv (默认: ''env'') [''none'' | ''env'' | ''cli''] ',\" ^",
      "  \"  '      execArgvExtension: ''env'', ',\" ^",
      "  \"  '    }, ',\" ^",
      "  \"  '  }, ',\" ^",
      "  \"  '  // * 复制文件到可执行文件目录 ',\" ^",
      "  \"  '  /** ',\" ^",
      "  \"  '   * ? from: string | string[] (默认: 必填) 源路径或 glob 模式。数组中可以包含否定模式 ',\" ^",
      "  \"  '   * ? to: string (默认: outDir) 目标路径，基于项目根目录解析 ',\" ^",
      "  \"  '   * ? flatten: boolean (默认: true, 建议: false) 是否扁平化目录结构（将匹配的文件直接放入 to）设为 false 时，会保留第一个路径段之后的目录结构 ',\" ^",
      "  \"  '   */ ',\" ^",
      "  \"  '  copy: [ ',\" ^",
      "  \"  '    // { from: ''./src/需要打包的文件夹'', to: ''./build'', flatten: false } ',\" ^",
      "  \"  '  ], ',\" ^",
      "  \"  '} ',\" ^",
      "  \"  'export default userConfig ',\" ^",
      "  \"  ''\" ^",
      "  \") -join [Environment]::NewLine;\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$filePath, [string]\\$lines, \\$utf8NoBom)\"",
      "  setlocal EnableDelayedExpansion",
      ")",
      "if exist \"%~dp0%project_name%\\tsconfig.json\" (",
      "  ECHO.配置 tsconfig.json 文件",
      "  setlocal DisableDelayedExpansion",
      "  set \"JSON_FILE=%~dp0%project_name%\\tsconfig.json\"",
      "  powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$path = \\$env:JSON_FILE;\" ^",
      "  \"\\$json = Get-Content -Raw -Encoding UTF8 \\$path;\" ^",
      "  \"\\$json = \\$json  -replace '(?ms)/\\*.*?\\*/' -replace '(?m)(?<=^([^'']|''[^'']*'')*)//.*' | ConvertFrom-Json;\" ^",
      "  \"if (\\$null -eq \\$json) { \\$json = [pscustomobject]@{} };\" ^",
      "  \"\\$obj = \\$json;\" ^",
      "  \"\\$key = 'compilerOptions';\" ^",
      "  \"\\$val = ([pscustomobject]@{});\" ^",
      "  \"if (-not \\$obj.PSObject.Properties[\\$key]) { Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force };\" ^",
      "  \"\\$obj = \\$json.compilerOptions;\" ^",
      "  \"\\$key = 'rewriteRelativeImportExtensions';\" ^",
      "  \"\\$val = (\\$true);\" ^",
      "  \"Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force;\" ^",
      "  \"\\$obj = \\$json.compilerOptions;\" ^",
      "  \"\\$key = 'allowImportingTsExtensions';\" ^",
      "  \"\\$val = (\\$true);\" ^",
      "  \"Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force;\" ^",
      "  \"\\$json = \\$json | ConvertTo-Json -Depth 100;\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$path, [string]\\$json, \\$utf8NoBom)\"",
      "  setlocal EnableDelayedExpansion",
      ")",
      "",
      "endlocal",
      "EXIT /B",
      ""
    ],
    "description": ["tsdown 构建node项目"]
  },
  "tsdown 项目打包": {
    "prefix": ["tsdown_build"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "@REM  * 设置临时系统环境变量",
      "set \"NODE_PATH=%~dp0..\\node;%~dp0..\\node\\node_modules;%~dp0node_modules;\"",
      "set \"XPATH=%PATH%\"",
      "set \"PATH=%NODE_PATH%;%XPATH%;\"",
      "",
      "goto :run_build",
      "./tsdown.config.ts 配置项：",
      "  // ...config options",
      "  entry: ['src/_test.ts'],",
      "  exe: {",
      "    fileName: 'py_test',",
      "    seaConfig: {",
      "      disableExperimentalSEAWarning: true, //禁用实验性警告(默认:true)",
      "      useSnapshot: false, //使用 V8 快照加速启动(默认:false)",
      "      useCodeCache: true, //使用 V8 代码缓存加速启动(默认:false)",
      "      execArgvExtension: 'env', //添加环境变量(默认:'env')",
      "      // * assets: Record<string, string> 嵌入到可执行文件中的资产",
      "      // ? {键(内部虚拟路径): 值(实际打包文件路径)}",
      "    },",
      "  },",
      "  // ? from: 打包目录实际路径",
      "  // ? to: './build' 目标目录(默认:./dist)",
      "  // ? flatten: false(必须设置)",
      "  copy: [{ from: './from', to: './build', flatten: false }],",
      ":run_build",
      "@REM  * 运行构建",
      "call npm run build",
      "",
      "endlocal",
      ""
    ],
    "description": ["tsdown 项目打包"]
  }
}
