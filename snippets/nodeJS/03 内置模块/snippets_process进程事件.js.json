  "配置子进程的 PATH 环境变量 => object": {
    "prefix": ["process_env_PATH_"],
    "body": [
      "// # 配置子进程的 PATH 环境变量",
      "let new_env = [path.join(${1:PATH环境变量})].join(';')",
      "let system_env = String(process.env.PATH)",
      "  .split(';')",
      "  .filter((item) => item !== '')",
      "  .join(';')",
      "process.env.PATH = [new_env, system_env].join(';')",
      ""
    ],
    "description": ["配置子进程的 PATH 环境变量 => object"]
  },
