  "配置子进程的 PATH 环境变量": {
    "prefix": ["set_env_PATH"],
    "body": [
      "/** 配置子进程的 PATH 环境变量 */",
      "let new_env = [path.join(__dirname, '${1:python}')].join(';')",
      "let system_env = String(process.env.PATH)",
      "  .split(';')",
      "  .filter((item) => item !== '')",
      "  .join(';')",
      "process.env.PATH = [new_env, system_env].join(';')",
      "",
      "$0"
    ],
    "description": ["配置子进程的 PATH 环境变量"]
  }
}
