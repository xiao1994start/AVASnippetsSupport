{
  "const ... = require('...') 导入依赖 [CommonJS]": {
    "prefix": ["new_require_", "nreq_"],
    "body": ["const ${2:name} = require('${1:JS_path}')"],
    "description": ["const ... = require('...') 导入依赖 [CommonJS]"]
  },
  "import 导入依赖": {
    "prefix": ["impt_"],
    "body": ["import {${2:module_name}} from '${1:module}'"],
    "description": ["import 导入依赖"]
  },
  "import 导入类型依赖": {
    "prefix": ["impt_typ_"],
    "body": ["import type {${2:module_name}} from '${1:module}'"],
    "description": ["import 导入类型依赖"]
  },
  "() => import(...) 动态导入依赖": {
    "prefix": ["new_lambda_import_", "nlami_"],
    "body": ["() => import(${0})"],
    "description": ["() => import(...) 动态导入依赖"]
  },
  "export 导出声明": {
    "prefix": ["expt_", "ept_"],
    "body": ["export ${0}"],
    "description": ["export 导出 声明"]
  },
  "module.exports 导出模块 [CommonJS]": {
    "prefix": ["mod_expt_", "mod_ept_"],
    "body": ["module.exports = {${0}}"],
    "description": ["module.exports 导出模块 [CommonJS]"]
  },
  "export default 默认导出": {
    "prefix": ["expt_def_", "ept_def_"],
    "body": ["export default {${0}}"],
    "description": ["export default 默认导出"]
  },
  "function () {...} 初始化声明提升|构造函数": {
    "prefix": ["new_def_function_", "ndf_"],
    "body": ["function ${1:name}(${2:params}) {${0}}"],
    "description": ["function () {...} 初始化声明提升|构造函数"]
  },
  "const = () => {...} 箭头函数": {
    "prefix": ["const_def_function_arrow_", "cdfa_"],
    "body": ["const ${1:name} = (${2:params}) => { ${0} }"],
    "description": ["const = () => {...} 箭头函数"]
  },
  "const = function () => {...}": {
    "prefix": ["const_def_function_", "cdf_"],
    "body": ["const ${1:name} = function (${2:params}) { ${0} }"],
    "description": ["const = function () => {...}"]
  },
  "() => return": {
    "prefix": ["new_lambda_", "nlam_"],
    "body": ["(${1}) => (${0})"],
    "description": ["() => return"]
  },
  "() => {...}": {
    "prefix": ["new_def_function_arrow_", "ndfa_"],
    "body": ["(${1:}) => {${0}}"],
    "description": ["() => {...}"]
  },
  "async 异步声明": {
    "prefix": ["async_", "asc_"],
    "body": ["async ${1:}"],
    "description": ["async 异步声明"]
  },
  "await 等待Promise完成": {
    "prefix": ["await_", "awt_", "aw"],
    "body": ["await ${1:}"],
    "description": ["await 等待Promise完成"]
  },
  "this 访问属性": {
    "prefix": ["this_", "ths_"],
    "body": ["this${1:.属性名}"],
    "description": ["this 访问属性"]
  },
  "then 处理成功回调": {
    "prefix": ["then_", "thn_"],
    "body": ["then((${1:value_可选}) => { ${2:callback_回调} })"],
    "description": ["then 处理成功回调"]
  },
  "catch 异常状态处理": {
    "prefix": ["catch_", "cach_"],
    "body": ["catch((${1:error_可选}) => { ${2:callback_回调} })"],
    "description": ["catch 异常状态处理"]
  },
  "throw 抛出异常": {
    "prefix": ["throw_err", "thw_"],
    "body": ["throw ${1:err}"],
    "description": ["throw 抛出异常"]
  },
  "throw 抛出自定义异常": {
    "prefix": ["throw_new_Error_", "thwne_"],
    "body": ["throw new Error(`${1:example_Err}`)"],
    "description": ["throw 抛出自定义异常"]
  },
  "extends 继承关键字": {
    "prefix": ["extends_", "extds_"],
    "body": ["extends ${1:继承}"],
    "description": ["extends 继承关键字"]
  },
  "return": {
    "prefix": ["return_", "ret_"],
    "body": ["return ${0}"],
    "description": ["return 返回值"]
  },
  "if (import.meta.main) {...} 脚本调试": {
    "prefix": ["if_main_"],
    "body": ["if (import.meta.main) {", "  // * 调试当前脚本", "${0}", "}", ""],
    "description": ["if (import.meta.main) {...} 脚本调试"]
  },
  "import.meta": {
    "prefix": ["import_meta", "impt_mt"],
    "body": ["import.meta${0}"],
    "description": ["import.meta"]
  },
  "import.meta.filename": {
    "prefix": ["import_meta_filename", "impt_mt_file"],
    "body": ["import.meta.filename"],
    "description": ["import.meta.filename"]
  },
  "import.meta.dirname": {
    "prefix": ["import_meta_dirname", "impt_mt_dir"],
    "body": ["import.meta.dirname"],
    "description": ["import.meta.dirname"]
  },
  "const __dirname": {
    "prefix": ["const_dir_import_meta_dir_", "cdirmt_"],
    "body": ["const __dirname = import.meta.dirname"],
    "description": ["const __dirname"]
  },
  "const __filename": {
    "prefix": ["const_file_import_meta_file_", "cfilemt_"],
    "body": ["const __filename = import.meta.filename"],
    "description": ["const __filename"]
  },
  "import.meta.url": {
    "prefix": ["import_meta_url", "impt_mt_url"],
    "body": ["import.meta.url"],
    "description": ["返回当前模块（文件）的绝对URL地址"]
  },
  "setTimeout": {
    "prefix": ["settimeout_", "set_sleep_"],
    "body": ["setTimeout(() => {${1:console.log('回调')}}, ${2:1000});"],
    "description": ["setTimeout"]
  },
  "setInterval": {
    "prefix": ["setinterval_", "set_loop_"],
    "body": ["setInterval(() => {${1:console.log('回调')}}, ${2:1000});"],
    "description": ["setInterval"]
  }
}
