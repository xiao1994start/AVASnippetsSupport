{
  "... else if(...){...}": {
    "prefix": ["elif_"],
    "body": ["else if (${1:}) {${2:}}"],
    "description": ["... else if(...){...}"]
  },
  "try ... catch ...": {
    "prefix": ["tryca_"],
    "body": ["try {", "  ${1:}", "} catch (err) {", "  ", "}"],
    "description": ["try ... catch ..."]
  },
  "try ... finally ...": {
    "prefix": ["tryfi_"],
    "body": ["try {", "  ${1:}", "} finally {", "  ", "}"],
    "description": ["try ... finally ..."]
  }
}
