{
  "... else if(...){...}": {
    "prefix": ["else_if_", "elif_"],
    "body": ["else if (${1:}) {${2:}}"],
    "description": ["... else if(...){...}"]
  },
  "try ... catch ...": {
    "prefix": ["try_catch_"],
    "body": ["try {", "  ${1:}", "} catch (error) {", "  ", "}"],
    "description": ["try ... catch ..."]
  },
  "try ... finally ...": {
    "prefix": ["try_finally_"],
    "body": ["try {", "  ${1:}", "} finally {", "  ", "}"],
    "description": ["try ... finally ..."]
  }
}
