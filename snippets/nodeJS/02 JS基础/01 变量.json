{
  "var 变量-函数作用域": {
    "prefix": ["new var"],
    "body": ["var $0"],
    "description": ["var 变量-函数作用域"]
  },
  "let 变量-块级作用域": {
    "prefix": ["new let"],
    "body": ["let $0"],
    "description": ["let 变量-块级作用域"]
  },
  "const 常量-块级作用域": {
    "prefix": ["new const"],
    "body": ["const $0"],
    "description": ["const 常量-块级作用域"]
  },
  "获取当前脚本文件的路径": {
    "prefix": ["get filepath"],
    "body": ["let current_script_path = __filename;"],
    "description": ["获取当前脚本文件的路径"]
  },
  "获取当前脚本文件的目录路径": {
    "prefix": ["get dirpath"],
    "body": ["let current_script_dir = __dirname;"],
    "description": ["获取当前脚本文件的目录路径"]
  }
}
