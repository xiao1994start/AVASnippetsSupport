{
  "async 异步声明": {
    "prefix": ["async_", "asc_"],
    "body": ["async ${1:}"],
    "description": ["async 异步声明"]
  },
  "await 等待Promise完成": {
    "prefix": ["await_", "awt_"],
    "body": ["await ${1:}"],
    "description": ["await 等待Promise完成"]
  },
  "function () {...}": {
    "prefix": ["new_def_function_", "ndf_"],
    "body": ["function ${1:name}(${2:params}) {$0}"],
    "description": ["function () {...}"]
  },
  "() => ...": {
    "prefix": ["new_lambda_return_", "nadr_"],
    "body": ["(${1:}) => $0"],
    "description": ["() => ..."]
  },
  "() => import(...)": {
    "prefix": ["new_lambda_import_", "nadi_"],
    "body": ["() => import($0)"],
    "description": ["() => import(...)"]
  },
  "() => {...}": {
    "prefix": ["new_lambda_", "nadf_"],
    "body": ["(${1:}) => {$0}"],
    "description": ["() => {...}"]
  },
  "class 类定义": {
    "prefix": ["new_class_"],
    "body": [
      "class name {",
      "  // # 属性 => 属性名: 属性类型 = 初始值",
      "  // 使用 this.属性名 来访问属性",
      "",
      "  // # 构造函数 => constructor( 参数名: 参数类型 ) { 初始化属性 }",
      "  constructor() {}",
      "",
      "  // # 类方法 => 方法名() {}",
      "",
      "  // = 创建实例对象 => const/let instance = new 类名()",
      "}",
      ""
    ],
    "description": ["class 类定义"]
  },
  "class extends 类继承": {
    "prefix": ["new_class_extends_"],
    "body": [
      "class name extends ParentClassName {",
      "  // # 属性 => 属性名: 属性类型 = 初始值",
      "  // 使用 this.属性名 来访问属性",
      "  $0",
      "  // # 构造函数 => constructor( 参数名: 参数类型 ) { super(继承父类的构造函数参数); 初始化属性 }",
      "  constructor() {",
      "    super()",
      "  }",
      "",
      "  // # 重写父类的方法 => override 方法名() { super.继承方法() }",
      "",
      "  // # 类方法 => 方法名() { ... }",
      "",
      "  // = 创建实例对象 => const/let instance = new 类名()",
      "}",
      ""
    ],
    "description": ["class extends 类继承"]
  },
  "class implements 接口约束类": {
    "prefix": ["new_class_implements_"],
    "body": [
      "class name implements interfaceName {",
      "  // # 属性 => 属性名: 属性类型 = 初始值",
      "  // 使用 this.属性名 来访问属性",
      "    $0",
      "",
      "  // # 构造函数 => constructor( 参数名: 参数类型 ) { super(继承父类的构造函数参数); 初始化属性 }",
      "  constructor() {",
      "",
      "  }",
      "",
      "  // # 接口方法 => 方法名() { ... }",
      "  method(): void {}",
      "",
      "  // # 类方法（扩展接口规定以外的方法） => 方法名() { ... }",
      "",
      "  // = 创建实例对象 => const/let instance = new 类名()",
      "}",
      ""
    ],
    "description": ["class implements 接口约束类"]
  },
  "extends 继承关键字": {
    "prefix": ["extends_", "extds_"],
    "body": ["extends ${1:继承}"],
    "description": ["extends 继承关键字"]
  },
  "export 导出声明": {
    "prefix": ["export_", "ept_"],
    "body": ["export $0"],
    "description": ["export 导出 声明"]
  },
  "export 导出模块 [CommonJS]": {
    "prefix": ["module_exports_"],
    "body": ["module.exports = {$0}"],
    "description": ["export 导出 模块 [CommonJS]"]
  },
  "export 默认导出 [ESM]": {
    "prefix": ["export_default_", "edf_"],
    "body": ["export default {$0}"],
    "description": ["export 默认导出 [ESM]"]
  },
  "const ... = require('...') 导入依赖 [CommonJS]": {
    "prefix": ["new_require_"],
    "body": ["const ${2:name} = require('${1:JS_path}')"],
    "description": ["const ... = require('...') 导入依赖 [CommonJS]"]
  },
  "import 导入依赖 [ESM]": {
    "prefix": ["impt_"],
    "body": ["import ${2:module_name} from '${1:module}'"],
    "description": ["import 导入依赖 [ESM]"]
  },
  "type 定义类型": {
    "prefix": ["type_", "tp_"],
    "body": [
      "type Type_Name = {",
      "  // * 属性: 属性类型",
      "  // * readonly 只读属性: 只读属性类型",
      "  // * 可选属性?: 可选属性类型",
      "  // * (函数参数: 参数类型): 返回类型（如 : void）",
      "  // * 方法(参数: 参数类型): 返回类型（如 : void）",
      "  Type_Properties: Type",
      "}",
      ""
    ],
    "description": ["type 定义类型（支持类型别名，不能重复声明合并。如果需要合并是，使用 & 运算符）"]
  },
  "typeof 类型查询": {
    "prefix": ["typeof_", "tpof_"],
    "body": ["typeof ${1:value_变量}"],
    "description": ["typeof 类型查询"]
  },
  "interface 接口定义结构": {
    "prefix": ["interface_", "intf_"],
    "body": [
      "interface Interface_Name {",
      "  // * 属性: 属性类型",
      "  // * readonly 只读属性: 只读属性类型",
      "  // * 可选属性?: 可选属性类型",
      "  // * (函数参数: 参数类型): 返回类型（如 : void）",
      "  // * 方法(参数: 参数类型): 返回类型（如 : void）",
      "  Interface_Properties: Type",
      "}",
      ""
    ],
    "description": ["interface 接口定义结构（支持重复声明自动合并）"]
  },
  "this 访问属性": {
    "prefix": ["this_", "tis_"],
    "body": ["this.${1:属性名}"],
    "description": ["this 访问属性"]
  },
  "then 处理成功回调": {
    "prefix": ["then_", "tn_"],
    "body": ["then((${1:value_可选}) => { ${2:callback_回调} })"],
    "description": ["then 处理成功回调"]
  },
  "throw 抛出异常": {
    "prefix": ["throw_err", "twer_"],
    "body": ["throw ${1:err}"],
    "description": ["throw 抛出异常"]
  },
  "throw 抛出自定义异常": {
    "prefix": ["throw_new_Error_", "twnEr_"],
    "body": ["throw new Error(`${1:example_Err}`)"],
    "description": ["throw 抛出自定义异常"]
  },
  "setTimeout": {
    "prefix": ["settimeout_", "time_sleep_"],
    "body": ["setTimeout(() => {", "  $0", "}, ${1:timeout});"],
    "description": ["setTimeout"]
  }
}
