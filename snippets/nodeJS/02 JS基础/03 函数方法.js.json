{
  "const ... = require('...') 导入依赖 [CommonJS]": {
    "prefix": ["new_require_", "nreq_"],
    "body": ["const ${2:name} = require('${1:JS_path}')"],
    "description": ["const ... = require('...') 导入依赖 [CommonJS]"]
  },
  "import 导入依赖 [ESM]": {
    "prefix": ["impt_"],
    "body": ["import ${2:module_name} from '${1:module}'"],
    "description": ["import 导入依赖 [ESM]"]
  },
  "export 导出声明": {
    "prefix": ["export_", "expt_"],
    "body": ["export $0"],
    "description": ["export 导出 声明"]
  },
  "export 导出模块 [CommonJS]": {
    "prefix": ["module_exports_", "mod_expt_"],
    "body": ["module.exports = {$0}"],
    "description": ["export 导出 模块 [CommonJS]"]
  },
  "export 默认导出 [ESM]": {
    "prefix": ["export_default_", "expt_def_"],
    "body": ["export default {$0}"],
    "description": ["export 默认导出 [ESM]"]
  },
  "async 异步声明": {
    "prefix": ["async_", "asc_"],
    "body": ["async ${1:}"],
    "description": ["async 异步声明"]
  },
  "await 等待Promise完成": {
    "prefix": ["await_", "aw_"],
    "body": ["await ${1:}"],
    "description": ["await 等待Promise完成"]
  },
  "type 定义类型": {
    "prefix": ["type_", "tp_"],
    "body": [
      "type Type_Name = {",
      "  // * 属性: 属性类型",
      "  // * readonly 只读属性: 只读属性类型",
      "  // * 可选属性?: 可选属性类型",
      "  // * (函数参数: 参数类型): 返回类型（如 : void）",
      "  // * 方法(参数: 参数类型): 返回类型（如 : void）",
      "  Type_Properties: Type",
      "}",
      ""
    ],
    "description": ["type 定义类型（支持类型别名，不能重复声明合并。如果需要合并是，使用 & 运算符）"]
  },
  "typeof 类型查询": {
    "prefix": ["typeof_", "tpof_"],
    "body": ["typeof ${1:value_变量}"],
    "description": ["typeof 类型查询"]
  },
  "interface 接口定义结构": {
    "prefix": ["interface_", "intf_"],
    "body": [
      "interface Interface_Name {",
      "  // * 属性: 属性类型",
      "  // * readonly 只读属性: 只读属性类型",
      "  // * 可选属性?: 可选属性类型",
      "  // * (函数参数: 参数类型): 返回类型（如 : void）",
      "  // * 方法(参数: 参数类型): 返回类型（如 : void）",
      "  Interface_Properties: Type",
      "}",
      ""
    ],
    "description": ["interface 接口定义结构（支持重复声明自动合并）"]
  },
  "this 访问属性": {
    "prefix": ["this_", "ths_"],
    "body": ["this${1:.属性名}"],
    "description": ["this 访问属性"]
  },
  "then 处理成功回调": {
    "prefix": ["then_", "thn_"],
    "body": ["then((${1:value_可选}) => { ${2:callback_回调} })"],
    "description": ["then 处理成功回调"]
  },
  "throw 抛出异常": {
    "prefix": ["throw_err", "thw_"],
    "body": ["throw ${1:err}"],
    "description": ["throw 抛出异常"]
  },
  "throw 抛出自定义异常": {
    "prefix": ["throw_new_Error_", "thwne_"],
    "body": ["throw new Error(`${1:example_Err}`)"],
    "description": ["throw 抛出自定义异常"]
  },
  "extends 继承关键字": {
    "prefix": ["extends_", "extds_"],
    "body": ["extends ${1:继承}"],
    "description": ["extends 继承关键字"]
  },
  "function () {...}": {
    "prefix": ["new_def_function_", "ndf_"],
    "body": ["function ${1:name}(${2:params}) {$0}"],
    "description": ["function () {...}"]
  },
  "() => ...": {
    "prefix": ["new_lambda_", "nlam_"],
    "body": ["(${1:}) => $0"],
    "description": ["() => ..."]
  },
  "() => import(...)": {
    "prefix": ["new_lambda_import_", "nlami_"],
    "body": ["() => import($0)"],
    "description": ["() => import(...)"]
  },
  "() => {...}": {
    "prefix": ["new_arrow_def_function_", "nadf_"],
    "body": ["(${1:}) => {$0}"],
    "description": ["() => {...}"]
  },
  "const () => {...}": {
    "prefix": ["new_const_arrow_def_function_", "ncadf_"],
    "body": ["const ${1:name} = (${2:params}) => {$0}"],
    "description": ["const () => {...}"]
  },
  "class 类定义": {
    "prefix": ["new_class_"],
    "body": [
      "class ${1:name} {",
      "  // # 属性 => 属性名: 属性类型 = 初始值",
      "  // this 标识类实例的self内部对象，使用 this.属性名 来访问属性",
      "  ",
      "",
      "  // # 构造函数 => constructor( 参数名: 参数类型 ) { 初始化属性 }",
      "  constructor() {}",
      "  ",
      "",
      "  // # 实例方法: 实例化后调用 => 方法名() {} ",
      "  ",
      "",
      "  // # 静态方法: 类名.静态方法() 调用 => static 方法名() {}",
      "  ",
      "",
      "  // = 创建实例对象 => const/let instance = new 类名()",
      "}",
      ""
    ],
    "description": ["class 类定义"]
  },
  "class extends 类继承": {
    "prefix": ["new_class_extends_"],
    "body": [
      "class name extends ParentClassName {",
      "  // # 属性 => 属性名: 属性类型 = 初始值",
      "  // this 标识类实例的self内部对象，使用 this.属性名 来访问属性",
      "  $0",
      "",
      "  // # 构造函数 => constructor( 参数名: 参数类型 ) { super(继承父类的构造函数参数); 初始化属性 }",
      "  constructor() {",
      "    super()",
      "  }",
      "",
      "  // # 重写父类的方法 => override 方法名() { super.继承方法() }",
      "  ",
      "",
      "  // # 实例方法: 实例化后调用 => 方法名() {} ",
      "  ",
      "",
      "  // # 静态方法: 类名.静态方法() 调用 => static 方法名() {}",
      "  ",
      "",
      "  // = 创建实例对象 => const/let instance = new 类名()",
      "}",
      ""
    ],
    "description": ["class extends 类继承"]
  },
  "class implements 接口约束类": {
    "prefix": ["new_class_implements_"],
    "body": [
      "class name implements interfaceName {",
      "  // # 属性 => 属性名: 属性类型 = 初始值",
      "  // this 标识类实例的self内部对象，使用 this.属性名 来访问属性",
      "    $0",
      "",
      "  // # 构造函数 => constructor( 参数名: 参数类型 ) { super(继承父类的构造函数参数); 初始化属性 }",
      "  constructor() {}",
      "",
      "  // # 接口方法 => 方法名() {}",
      "  // method(): void {}",
      "",
      "  // # 实例方法（扩展接口规定以外的方法）: 实例化后调用 => 方法名() {}",
      "  ",
      "",
      "  // # 静态方法: 类名.静态方法() 调用 => static 方法名() {}",
      "  ",
      "",
      "  // = 创建实例对象 => const/let instance = new 类名()",
      "}",
      ""
    ],
    "description": ["class implements 接口约束类"]
  },
  "decorator 声明类装饰器": {
    "prefix": ["new_class_decorator_", "new_object_decorator_"],
    "body": [
      "function ${1:decorator_Name}(target: new (...args: any[]) => any) {",
      "  /**",
      "   * # 类装饰器: 修改类内部已有的行为或属性",
      "   * @param {Function} target{函数/方法类型} 被装饰的目标类对象（装饰器自动传递该参数）",
      "   * @param {new (...args: any[]) => any} target{可构造类型} 被装饰的目标类对象（装饰器自动传递该参数）",
      "   * @use target.prototype.方法名 = 方法体 => 作用域类的实例对象，用于添加类的实例方法或属性",
      "   * @调用 在目标对象上一行添加 @装饰器 即可，不需要传递 target 参数",
      "   * @报错 出现 @ 符号报错，使用 tsx 编译工具运行 ( npm i tsx -g )",
      "   */",
      "  target.prototype.toString = function () {",
      "    return JSON.stringify(this)",
      "  }",
      "}",
      ""
    ],
    "description": ["decorator 声明类装饰器"]
  },
  "decorator 声明方法装饰器": {
    "prefix": ["new_function_decorator_", "new_method_decorator_"],
    "body": [
      "function ${1:decorator_Name}(method: Function, context: ClassMethodDecoratorContext) {",
      "  /**",
      "   * # 方法装饰器: 修改方法内部已有的行为或属性",
      "   * @param {Function} method{函数/方法类型} 被装饰的目标方法（装饰器自动传递该参数）",
      "   * @param {ClassMethodDecoratorContext} context {装饰器上下文对象} 方法装饰器参数，包括装饰器、目标信息",
      "   * @调用 在目标对象上一行添加 @装饰器 即可，不需要传递 method 和 context 参数",
      "   * @报错 出现 @ 符号报错，使用 tsx 编译工具运行 ( npm i tsx -g )",
      "   */",
      "  return function (this: any, ...args: any[]) {",
      "    // * 执行前...",
      "",
      "    // - 调用 目标方法",
      "    const result = method.call(this, ...args)",
      "",
      "    // * 执行后...",
      "",
      "    // - 返回 执行结果",
      "    return result",
      "  }",
      "}",
      ""
    ],
    "description": "decorator 声明方法装饰器"
  },
  "decorator 声明装饰器工厂": {
    "prefix": ["new_decorator_factory_", "new_dec_fact_"],
    "body": [
      "function DecFactory(delay?: number) {",
      "  return function (method: Function, context: ClassMethodDecoratorContext) {",
      "    let timer: any",
      "    return function (this: any, ...args: any[]) {",
      "      clearTimeout(timer)",
      "      timer = setTimeout(() => {",
      "        method.call(this, ...args)",
      "      }, delay || 1000)",
      "    }",
      "  }",
      "}",
      ""
    ],
    "description": ["decorator 声明装饰器工厂"]
  },
  "setTimeout": {
    "prefix": ["settimeout_", "time_sleep_"],
    "body": ["setTimeout(() => {", "  $0", "}, ${1:timeout});"],
    "description": ["setTimeout"]
  }
}
