{
  "async 异步声明": {
    "prefix": ["asc_", "async_"],
    "body": ["async ${1:}"],
    "description": ["async 异步声明"]
  },
  "await 等待Promise完成": {
    "prefix": ["awt_", "await_"],
    "body": ["await ${1:}"],
    "description": ["await 等待Promise完成"]
  },
  "function () {}": {
    "prefix": ["new_def_function_"],
    "body": ["function ${1:name}(${2:params}) {$0}"],
    "description": ["function () {}"]
  },
  "() => ...": {
    "prefix": ["new_lambda_return"],
    "body": ["(${1:params}) => $0"],
    "description": ["() => ..."]
  },
  "() => {...}": {
    "prefix": ["new_lambda_"],
    "body": ["(${1:params}) => {$0}"],
    "description": ["() => {...}"]
  },
  "const () => {...}": {
    "prefix": ["new_arrow_lambda"],
    "body": ["const ${1:name} = (${2:params}) => {$0}"],
    "description": ["const () => {...}"]
  },
  "export 导出声明": {
    "prefix": ["ept_", "export_"],
    "body": ["export $0"],
    "description": ["export 导出 声明"]
  },
  "export 导出函数声明": {
    "prefix": ["ept_def_function_", "export_def_function_"],
    "body": ["export function ${1:name}(${2:params}) {$0}"],
    "description": ["export 导出 函数声明"]
  },
  "export 导出模块 [CommonJS]": {
    "prefix": ["module_exports_"],
    "body": ["module.exports = {$0}"],
    "description": ["export 导出 模块 [CommonJS]"]
  },
  "export 导出模块 [ESM]": {
    "prefix": ["export_default_"],
    "body": ["export default {$0}"],
    "description": ["export 导出 模块 [ESM]"]
  },
  "const ... = require('...') 导入依赖 [CommonJS]": {
    "prefix": ["new_require_"],
    "body": ["const ${2:name} = require('${1:JS_path}')"],
    "description": ["const ... = require('...') 导入依赖 [CommonJS]"]
  },
  "import 导入依赖 [ESM]": {
    "prefix": ["impt_"],
    "body": ["import ${2:module_name} from '${1:module}'"],
    "description": ["import 导入依赖 [ESM]"]
  },
  "throw 抛出异常": {
    "prefix": ["throw_err"],
    "body": ["throw ${1:err}"],
    "description": ["throw 抛出异常"]
  },
  "throw 抛出自定义异常": {
    "prefix": ["throw_new_Error"],
    "body": ["throw new Error(`${1:example_Err}`)"],
    "description": ["throw 抛出自定义异常"]
  }
}
