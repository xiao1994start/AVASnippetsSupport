{
  "const ... = require('...') 加载模块 [CommonJS]": {
    "prefix": ["new require"],
    "body": ["const ${2:name} = require('${1:JS_path}');"],
    "description": ["const ... = require('...') 加载模块 [CommonJS]"]
  },
  "创建 function 方法函数": {
    "prefix": ["new def function"],
    "body": ["function ${1:name}(${2:params}) {", "  $0", "}", ""],
    "description": "创建 function 方法函数"
  },
  "创建 匿名函数": {
    "prefix": ["new lambda"],
    "body": ["(${1:params}) => {", "  $0", "}", ""],
    "description": "创建 匿名函数"
  },
  "导出/暴露 模块 [CommonJS]": {
    "prefix": ["module exports -CommonJS"],
    "body": ["module.exports = { $0 }", ""],
    "description": ["导出/暴露 模块 [CommonJS]"]
  },
  "导出/暴露 模块 [ESM]": {
    "prefix": ["export default -ESM"],
    "body": ["export default { $0 }", ""],
    "description": ["导出/暴露 模块 [ESM]"]
  }
