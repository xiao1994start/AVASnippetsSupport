{
  "function () {}": {
    "prefix": ["new_def_function"],
    "body": ["function ${1:name}(${2:params}) {$0}"],
    "description": ["function () {}"]
  },
  "() => return": {
    "prefix": ["new_lambda_return"],
    "body": ["(${1:params}) => $0"],
    "description": ["() => return"]
  },
  "() => {}": {
    "prefix": ["new_lambda"],
    "body": ["(${1:params}) => {$0}"],
    "description": ["() => {}"]
  },
  "const () => {}": {
    "prefix": ["new_arrow_lambda"],
    "body": ["const ${1:name} = (${2:params}) => {$0}"],
    "description": ["const () => {}"]
  },
  "导出 声明": {
    "prefix": ["ept_", "export_"],
    "body": ["export {$0}"],
    "description": ["导出 声明"]
  },
  "导出 函数声明": {
    "prefix": ["ept_def_function", "export_def_function"],
    "body": ["export function ${1:name}(${2:params}) {$0}"],
    "description": ["导出 函数声明"]
  },
  "导出 模块 [CommonJS]": {
    "prefix": ["module_exports"],
    "body": ["module.exports = {$0}"],
    "description": ["导出 模块 [CommonJS]"]
  },
  "导出 模块 [ESM]": {
    "prefix": ["export_default"],
    "body": ["export default {$0}"],
    "description": ["导出 模块 [ESM]"]
  },
  "导入依赖 const ... = require('...') [CommonJS]": {
    "prefix": ["new_require"],
    "body": ["const ${2:name} = require('${1:JS_path}')"],
    "description": ["导入依赖 const ... = require('...') [CommonJS]"]
  },
  "import 导入依赖 [ESM]": {
    "prefix": ["imp_"],
    "body": ["import ${2:module_name} from '${1:module}'"],
    "description": ["import 导入依赖 [ESM]"]
  },
  "throw 抛出异常": {
    "prefix": ["throw_err"],
    "body": ["throw ${1:err}"],
    "description": ["throw 抛出异常"]
  },
  "throw 抛出自定义异常": {
    "prefix": ["throw_new_Error"],
    "body": ["throw new Error(`${1:example_Err}`)"],
    "description": ["throw 抛出自定义异常"]
  }
}
