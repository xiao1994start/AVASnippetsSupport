{
  "创建 function 函数": {
    "prefix": ["new_def_function"],
    "body": ["function ${1:name}(${2:params}) {$0}"],
    "description": ["创建 function 函数"]
  },
  "创建 箭头函数": {
    "prefix": ["new_lambda"],
    "body": ["(${1:params}) => {$0}"],
    "description": ["创建 箭头函数"]
  },
  "声明 箭头函数": {
    "prefix": ["new_arrow_lambda"],
    "body": ["const ${1:name} = (${2:params}) => {$0}"],
    "description": ["声明 箭头函数"]
  },
  "导出 声明": {
    "prefix": ["export_"],
    "body": ["export {$0}"],
    "description": ["导出 声明"]
  },
  "导出 函数方法 声明": {
    "prefix": ["export_def_function"],
    "body": ["export function ${1:name}(${2:params}) {$0}"],
    "description": ["导出 函数方法 声明"]
  },
  "导出 模块 [CommonJS]": {
    "prefix": ["module_exports"],
    "body": ["module.exports = {$0}"],
    "description": ["导出 模块 [CommonJS]"]
  },
  "导出 模块 [ESM]": {
    "prefix": ["export_default"],
    "body": ["export default {$0}"],
    "description": ["导出 模块 [ESM]"]
  },
  "引入模块 const ... = require('...') [CommonJS]": {
    "prefix": ["new_require"],
    "body": ["const ${2:name} = require('${1:JS_path}')"],
    "description": ["引入模块 const ... = require('...') [CommonJS]"]
  },
  "import 导入依赖 [ESM]": {
    "prefix": ["imp"],
    "body": ["import ${2:module_name} from '${1:module}'"],
    "description": ["import 导入依赖 [ESM]"]
  }
}
