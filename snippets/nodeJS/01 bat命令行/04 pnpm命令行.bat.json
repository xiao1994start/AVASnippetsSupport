{
  "npm 安装 pnpm": {
    "prefix": ["npm_install_pnpm"],
    "body": ["ECHO.= 安装 pnpm", "call npm i pnpm -g --registry https://registry.npmmirror.com/", ""],
    "description": ["npm 安装 pnpm"]
  },
  "pnpm 版本号": {
    "prefix": ["pnpm_version"],
    "body": ["ECHO.= 检查 pnpm 版本号:", "call pnpm --version", ""],
    "description": ["pnpm 版本号"]
  },
  "pnpm 配置国内源": {
    "prefix": ["pnpm_config_set_registry"],
    "body": ["ECHO.* 配置 pnpm 国内源", "call pnpm config set registry https://registry.npmmirror.com", ""],
    "description": ["pnpm 配置国内源"]
  },
  "pnpm 初始化新项目": {
    "prefix": ["pnpm_init"],
    "body": ["pnpm init", ""],
    "description": ["pnpm 初始化新项目"]
  },
  "pnpm 初始化新项目(默认配置)": {
    "prefix": ["pnpm_init_y"],
    "body": ["pnpm init -y", ""],
    "description": ["pnpm 初始化新项目(默认配置)"]
  },
  "pnpm 根据package.json安装所有依赖": {
    "prefix": ["pnpm_install"],
    "body": ["pnpm install", ""],
    "description": "pnpm 根据package.json安装所有依赖"
  },
  "pnpm 添加依赖包": {
    "prefix": ["pnpm_add"],
    "body": ["pnpm add ${1:package_name}", ""],
    "description": ["pnpm 添加依赖包"]
  },
  "pnpm 添加开发依赖": {
    "prefix": ["pnpm_add_D"],
    "body": ["pnpm add -D ${1:package_name}", ""],
    "description": ["pnpm 添加开发依赖"]
  },
  "pnpm 添加全局包": {
    "prefix": ["pnpm_add_g"],
    "body": ["pnpm add -g ${1:package_name}", ""],
    "description": ["pnpm 添加全局包"]
  },
  "pnpm 更新所有依赖": {
    "prefix": ["pnpm_update"],
    "body": ["pnpm update", ""],
    "description": ["pnpm 更新所有依赖"]
  },
  "pnpm 更新指定包": {
    "prefix": ["pnpm_update_"],
    "body": ["pnpm update ${1:package_name}"],
    "description": ["pnpm 更新指定包"]
  },
  "pnpm 删除依赖": {
    "prefix": ["pnpm_remove"],
    "body": ["pnpm remove ${1:package_name}"],
    "description": ["pnpm 删除依赖"]
  },
  "pnpm 清理未使用的包": {
    "prefix": ["pnpm_store_prune"],
    "body": ["pnpm store prune", ""],
    "description": ["pnpm 清理未使用的包"]
  },
  "pnpm 查看存储位置": {
    "prefix": ["pnpm_store_path"],
    "body": ["pnpm store path", ""],
    "description": ["pnpm 查看存储位置"]
  },
  "pnpm 查看存储状态": {
    "prefix": ["pnpm_store_status"],
    "body": ["pnpm store status", ""],
    "description": ["pnpm 查看存储状态"]
  }
}
