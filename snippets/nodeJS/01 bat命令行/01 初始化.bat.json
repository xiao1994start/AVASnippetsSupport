{
  "node.js 临时环境初始化": {
    "prefix": ["init_node_Portable"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "",
      "",
      "@REM  * 初始化 node 环境变量",
      "if not exist \".\\node\" ( for /D %%i in (\"*node*\") do ( if /I \"%%~nxi\" NEQ \"node_modules\" ( ren \"%%i\" \"node\" ) ) )",
      "",
      "@REM  * 定义 node 环境变量",
      "set \"local_node=.\\node\"",
      "",
      "@REM  * 设置临时系统环境变量",
      "set \"NODE_PATH=!local_node!;!local_node!\\node_modules;\"",
      "set \"XPATH=%PATH%\"",
      "set \"PATH=%NODE_PATH%;%XPATH%;\"",
      "",
      "ECHO.= node 版本号:",
      "call node -v",
      "ECHO.= npm 版本号:",
      "call npm -v",
      "ECHO.",
      "",
      "ECHO.- 清理 npm 缓存（禁用：推荐的保护功能）",
      "call npm cache clean --force",
      "ECHO.+ 升级 npm",
      "call npm i npm -g --registry https://registry.npmmirror.com/",
      "ECHO.= 检查 软件仓库位置:",
      "call npm root -g",
      "",
      "if exist \".\\package.json\" ( ECHO.* 重置 package.json 配置文件 && del /F /Q \".\\package.json\" && if exist \".\\package-lock.json\" ( del /F /Q \".\\package-lock.json\" ) )",
      "ECHO.* 自动初始化 npm 项目",
      "call npm init -y",
      "ECHO.* npm 设置模块类型为 module （推荐）",
      "call npm pkg set type=\"module\"",
      "",
      "ECHO.+ 安装 typescript 全局命令",
      "call npm i typescript -g --registry https://registry.npmmirror.com/",
      "ECHO.= 生成 typescript 配置文件",
      "call tsc --init",
      "",
      "@REM  修复 tsconfig.json 配置文件",
      "@REM    ./tsconfig.json 配置文件：",
      "@REM    # 正常使用 node 内置模块",
      "@REM        取消注释 // For nodejs: 下方代码",
      "@REM          \"lib\": [\"esnext\"],",
      "@REM          \"types\": [\"node\"],",
      "@REM    # 解决相对导入 .ts 扩展名问题",
      "@REM        // 解决相对导入 .ts 扩展名问题",
      "@REM          \"rewriteRelativeImportExtensions\": true,",
      "@REM          \"allowImportingTsExtensions\": true",
      "@REM    ./package.json 配置文件：",
      "@REM     \"type\": \"module:推荐/commonjs:旧版\" ",
      "",
      "ECHO.+ 【本地开发必装】安装 @types/node 类型定义",
      "call npm i @types/node -g --registry https://registry.npmmirror.com/",
      "",
      "ECHO.+ 安装 nodemon 监听文件变化",
      "call npm i nodemon -g --registry https://registry.npmmirror.com/",
      "@REM  * 嵌入式安装位置：./node_modules/.bin/nodemon",
      "",
      "ECHO.+ 安装 inquirer 终端交互模块",
      "call npm i inquirer -g --registry https://registry.npmmirror.com/",
      "",
      "ECHO.",
      "",
      "@REM  ====================== ** npm ** ======================",
      "",
      "",
      "$0",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "endlocal",
      ""
    ],
    "description": ["node.js 临时环境初始化"]
  },
  "tsdown 构建node项目": {
    "prefix": ["init_tsdown_node"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "",
      "@REM  * 初始化 node 环境变量",
      "if not exist \".\\node\" ( for /D %%i in (\"*node*\") do ( if /I \"%%~nxi\" NEQ \"node_modules\" ( ren \"%%i\" \"node\" ) ) )",
      "",
      "@REM  * 定义 node 环境变量",
      "set \"local_node=.\\node\"",
      "",
      "@REM  * 设置临时系统环境变量",
      "set \"NODE_PATH=!local_node!;!local_node!\\node_modules;\"",
      "set \"XPATH=%PATH%\"",
      "set \"PATH=%NODE_PATH%;%XPATH%;\"",
      "",
      "ECHO.= node 版本号:",
      "call node -v",
      "ECHO.= npm 版本号:",
      "call npm -v",
      "ECHO.",
      "",
      "ECHO.- 清理 npm 缓存（禁用：推荐的保护功能）",
      "call npm cache clean --force",
      "ECHO.+ 升级 npm",
      "call npm i npm -g --registry https://registry.npmmirror.com/",
      "ECHO.= 检查 软件仓库位置:",
      "call npm root -g",
      "",
      "ECHO.+ tsdown 构建工具 【https://github.com/rolldown/tsdown】",
      "call npm i tsdown -g --registry https://registry.npmmirror.com/",
      "goto :set_tsdown_project",
      ":init_tsdown",
      "ECHO.= tsdown 创建项目模板 （ fetch failed ：不要开代理）",
      "call npm create tsdown@latest \"!tsdown_project!\"",
      "CD \"!tsdown_project!\"",
      "set \"NODE_PATH=.\\..\\node;.\\..\\node\\node_modules;.\\node_modules;\"",
      "set \"XPATH=%PATH%\"",
      "set \"PATH=%NODE_PATH%;%XPATH%;\"",
      "call npm i --registry https://registry.npmmirror.com/",
      "",
      "ECHO.+ 安装 typescript 全局命令",
      "call npm i typescript -g --registry https://registry.npmmirror.com/",
      "",
      "@REM  修复 tsconfig.json 配置文件",
      "@REM    ./tsconfig.json 配置文件：",
      "@REM    # 正常使用 node 内置模块",
      "@REM        取消注释 // For nodejs: 下方代码：",
      "@REM          \"lib\": [\"esnext\"],",
      "@REM          \"types\": [\"node\"],",
      "@REM    # 解决相对导入 .ts 扩展名问题",
      "@REM        // 解决相对导入 .ts 扩展名问题",
      "@REM          \"rewriteRelativeImportExtensions\": true,",
      "@REM          \"allowImportingTsExtensions\": true",
      "@REM    ./package.json 配置文件：",
      "@REM      \"type\": \"module:推荐/commonjs:旧版\"",
      "",
      "ECHO.+ 【本地开发必装】安装 @types/node 类型定义",
      "call npm i @types/node -g --registry https://registry.npmmirror.com/",
      "",
      "ECHO.+ 安装 inquirer 终端交互模块",
      "call npm i inquirer -g --registry https://registry.npmmirror.com/",
      "",
      "goto :call_npm",
      ":set_tsdown_project",
      "",
      "",
      "set \"tsdown_project=.\\_aaa -tsdown\"",
      "",
      "",
      "if exist \"%~dp0!tsdown_project!\\\" ( goto :call_npm )",
      "goto :init_tsdown",
      ":call_npm",
      "if not exist \"%~dp0!tsdown_project!\\#npm_package.cmd\" (",
      "    ECHO.写入 tsdown 项目依赖管理文件",
      "    (",
      "        ECHO.@ECHO OFF",
      "        ECHO.setlocal EnableDelayedExpansion",
      "        ECHO.CD /D \"%%~dp0\"",
      "        ECHO.@REM * 设置环境变量",
      "        ECHO.if not exist \".\\..\\node\" ECHO.请先配置 nodeJS 环境 ^&^& EXIT /B",
      "        ECHO.set \"local_node=.\\..\\node\"",
      "        ECHO.",
      "        ECHO.@REM * 设置临时系统环境变量",
      "        ECHO.set \"NODE_PATH=^!local_node^!\\;^!local_node^!\\node_modules\\;.\\node_modules;.\\node_modules\\.bin;\"",
      "        ECHO.set \"PATH=^!NODE_PATH^!;%%PATH%%;\"",
      "        ECHO.",
      "        ECHO.@REM  ====================== ** npm ** ======================",
      "        ECHO.",
      "        ECHO.",
      "        ECHO.",
      "        ECHO.endlocal",
      "    )>\"%~dp0!tsdown_project!\\#npm_package.cmd\"",
      ")",
      "if not exist \"%~dp0!tsdown_project!\\#npm_build.cmd\" (",
      "    ECHO.写入 tsdown 项目构建文件",
      "    (",
      "        ECHO.@ECHO OFF",
      "        ECHO.setlocal EnableDelayedExpansion",
      "        ECHO.CD /D \"%%~dp0\"",
      "        ECHO.@REM * 设置环境变量",
      "        ECHO.if not exist \".\\..\\node\" ECHO.请先配置 nodeJS 环境 ^&^& EXIT /B",
      "        ECHO.set \"local_node=.\\..\\node\"",
      "        ECHO.",
      "        ECHO.@REM * 设置临时系统环境变量",
      "        ECHO.set \"NODE_PATH=^!local_node^!\\;^!local_node^!\\node_modules\\;.\\node_modules;.\\node_modules\\.bin;\"",
      "        ECHO.set \"PATH=^!NODE_PATH^!;%%PATH%%;\"",
      "        ECHO.",
      "        ECHO.@REM * 构建 可执行文件",
      "        ECHO.call npm run build",
      "        ECHO.",
      "        ECHO.",
      "        ECHO.endlocal",
      "    )>\"%~dp0!tsdown_project!\\#npm_build.cmd\"",
      ")",
      "if not exist \"%~dp0!tsdown_project!\\tsdown.config_build.ts\" (",
      "    set \"TARGET_FILE=%~dp0!tsdown_project!\\tsdown.config_build.ts\"",
      "    ECHO.写入 tsdown 项目构建配置文件",
      "    powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "        \"$$lines = @(\" ^",
      "        \"  'import { defineConfig } from ''tsdown''',\" ^",
      "        \"  '',\" ^",
      "        \"  'export default defineConfig({',\" ^",
      "        \"  '  // ...config options',\" ^",
      "        \"  '  entry: [''./src/cli.ts''],',\" ^",
      "        \"  '  exe: {',\" ^",
      "        \"  '    fileName: ''my_tool'',',\" ^",
      "        \"  '    seaConfig: {',\" ^",
      "        \"  '      // * 禁用实验性警告 (默认: true)',\" ^",
      "        \"  '      disableExperimentalSEAWarning: true,',\" ^",
      "        \"  '      // * 使用 V8 快照加速启动 (默认: false) 建议`关闭`',\" ^",
      "        \"  '      useSnapshot: false,',\" ^",
      "        \"  '      // * 使用 V8 代码缓存加速启动 (默认: false) 建议`开启`',\" ^",
      "        \"  '      useCodeCache: true,',\" ^",
      "        \"  '      // * 运行时如何扩展 execArgv (默认: ''env'') [''none'' | ''env'' | ''cli'']',\" ^",
      "        \"  '      execArgvExtension: ''env'',',\" ^",
      "        \"  '    },',\" ^",
      "        \"  '  },',\" ^",
      "        \"  '  // * 复制文件到可执行文件目录',\" ^",
      "        \"  '  /**',\" ^",
      "        \"  '   * ? from: string | string[] (默认: 必填) 源路径或 glob 模式。数组中可以包含否定模式',\" ^",
      "        \"  '   * ? to: string (默认: outDir) 目标路径，基于项目根目录解析',\" ^",
      "        \"  '   * ? flatten: boolean (默认: true, 建议: false) 是否扁平化目录结构（将匹配的文件直接放入 to）设为 false 时，会保留第一个路径段之后的目录结构',\" ^",
      "        \"  '   */',\" ^",
      "        \"  '  copy: [{ from: ''./src/snippets'', to: ''./build'', flatten: false }],',\" ^",
      "        \"  '})'\" ^",
      "        \");\" ^",
      "        \"$$content =$$lines -join [Environment]::NewLine;\" ^",
      "        \"[System.IO.File]::WriteAllText('!TARGET_FILE!', $$content, [System.Text.Encoding]::UTF8)\"",
      ")",
      "",
      "",
      "endlocal",
      ""
    ],
    "description": ["tsdown 构建node项目"]
  },
  "tsdown 项目打包": {
    "prefix": ["tsdown_build"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "",
      "@REM  * 设置临时系统环境变量",
      "set \"NODE_PATH=.\\..\\node;.\\..\\node\\node_modules;.\\node_modules;\"",
      "set \"XPATH=%PATH%\"",
      "set \"PATH=%NODE_PATH%;%XPATH%;\"",
      "",
      "goto :run_build",
      "./tsdown.config.ts 配置项：",
      "  // ...config options",
      "  entry: ['src/_test.ts'],",
      "  exe: {",
      "    fileName: 'py_test',",
      "    seaConfig: {",
      "      disableExperimentalSEAWarning: true, //禁用实验性警告(默认:true)",
      "      useSnapshot: false, //使用 V8 快照加速启动(默认:false)",
      "      useCodeCache: true, //使用 V8 代码缓存加速启动(默认:false)",
      "      execArgvExtension: 'env', //添加环境变量(默认:'env')",
      "      // * assets: Record<string, string> 嵌入到可执行文件中的资产",
      "      // ? {键(内部虚拟路径): 值(实际打包文件路径)}",
      "    },",
      "  },",
      "  // ? from: 打包目录实际路径",
      "  // ? to: './build' 目标目录(默认:./dist)",
      "  // ? flatten: false(必须设置)",
      "  copy: [{ from: './from', to: './build', flatten: false }],",
      ":run_build",
      "@REM  * 运行构建",
      "call npm run build",
      "",
      "",
      "endlocal",
      ""
    ],
    "description": ["tsdown 项目打包"]
  }
}
