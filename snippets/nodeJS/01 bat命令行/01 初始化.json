{
  "node.js 临时环境设置": {
    "prefix": ["init node --Portable"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "",
      "",
      "@REM  * 初始化 node 环境变量",
      "for /D %%i in (\"node*\") do ( ren \"%%i\" \"_node\" )",
      "",
      "@REM  * 定义 node 环境变量",
      "set \"local_node=%~dp0_node\"",
      "",
      "@REM  * 添加临时系统环境变量",
      "set \"NODE_PATH=!local_node!\\;!local_node!\\node_modules\\;\"",
      "set \"PATH=%NODE_PATH%;%PATH%;\"",
      "",
      "ECHO.= node 版本号:",
      "call node -v",
      "ECHO.= npm 版本号:",
      "call npm -v",
      "",
      "ECHO.- 清理 npm 缓存",
      "call npm cache clean --force",
      "ECHO.+ 升级 npm",
      "call npm i -g npm --registry https://registry.npmmirror.com/",
      "",
      "ECHO.= 检查 软件仓库位置:",
      "call npm root -g",
      "",
      "ECHO.= 安装 pnpm",
      "call npm i -g pnpm --registry https://registry.npmmirror.com/",
      "ECHO.= 检查 pnpm 版本号:",
      "call pnpm --version",
      "ECHO.* 配置 pnpm 国内源",
      "call pnpm config set registry https://registry.npmmirror.com",
      "ECHO.* 初始化 pnpm 项目",
      "if not exist \"%~dp0package.json\" ( call pnpm init -y )",
      "",
      "ECHO.+ (本地开发必装)安装 @types/node 类型定义",
      "@REM  call npm i --save @types/node --registry https://registry.npmmirror.com/",
      "call pnpm add @types/node",
      "",
      "ECHO.+ 安装 nodemon 监听文件变化（便携式环境：不要使用全局安装）",
      "@REM  call npm i --save nodemon --registry https://registry.npmmirror.com/",
      "call pnpm add nodemon",
      "@REM  * 嵌入式安装位置：./node_modules/.bin/nodemon",
      "",
      "",
      "",
      "@REM  ====================== pnpm 操作 ======================",
      "",
      "",
      "$0",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "endlocal",
      ""
    ],
    "description": ["node.js 临时环境设置"]
  }
}
