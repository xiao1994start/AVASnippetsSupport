{
  "node.js 临时环境初始化": {
    "prefix": ["init_nodeJS_Portable"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "",
      "",
      "@REM  * 初始化 node 环境变量",
      "if not exist \".\\node\" ( for /D %%i in (\"*node*\") do ( if /I \"%%~nxi\" NEQ \"node_modules\" ( ren \"%%i\" \"node\" ) ) )",
      "",
      "@REM  * 定义 node 环境变量",
      "set \"local_node=.\\node\"",
      "",
      "@REM  * 添加临时系统环境变量",
      "set \"NODE_PATH=!local_node!;!local_node!\\node_modules;\"",
      "set \"XPATH=%PATH%\"",
      "set \"PATH=%NODE_PATH%;%XPATH%;\"",
      "",
      "ECHO.= node 版本号:",
      "call node -v",
      "ECHO.= npm 版本号:",
      "call npm -v",
      "ECHO.",
      "",
      "ECHO.- 清理 npm 缓存（禁用：推荐的保护功能）",
      "call npm cache clean --force",
      "ECHO.+ 升级 npm",
      "call npm i npm -g --registry https://registry.npmmirror.com/",
      "",
      "ECHO.= 检查 软件仓库位置:",
      "call npm root -g",
      "",
      "if exist \".\\package.json\" ( ECHO.* 重置 package.json 配置文件 && del /F /Q \".\\package.json\" && if exist \".\\package-lock.json\" ( del /F /Q \".\\package-lock.json\" ) )",
      "ECHO.* 自动初始化 npm 项目",
      "call npm init -y",
      "ECHO.* npm 设置模块类型为 module （推荐）",
      "call npm pkg set type=\"module\"",
      "",
      "ECHO.+ 安装 typescript 全局命令",
      "call npm i typescript -g --registry https://registry.npmmirror.com/",
      "ECHO.= 生成 typescript 配置文件",
      "call tsc --init",
      "@REM  修复 tsconfig.json 配置文件",
      "@REM    ./tsconfig.json 配置文件：",
      "@REM    # 正常使用 node 内置模块",
      "@REM        取消注释 // For nodejs: 下方代码",
      "@REM    # 解决相对导入 .ts 扩展名问题",
      "@REM        // 解决相对导入 .ts 扩展名问题",
      "@REM        \"rewriteRelativeImportExtensions\": true,",
      "@REM        \"allowImportingTsExtensions\": true",
      "@REM    ./package.json 配置文件：",
      "@REM     \"type\": \"module:推荐/commonjs:旧版\" ",
      "",
      "ECHO.+ 【本地开发必装】安装 @types/node 类型定义",
      "call npm i -D @types/node --registry https://registry.npmmirror.com/",
      "",
      "ECHO.+ 安装 nodemon 监听文件变化",
      "call npm i nodemon -g --registry https://registry.npmmirror.com/",
      "@REM  * 嵌入式安装位置：./node_modules/.bin/nodemon",
      "",
      "ECHO.",
      "",
      "@REM  ====================== ** npm ** ======================",
      "",
      "",
      "$0",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "endlocal",
      ""
    ],
    "description": ["node.js 临时环境初始化"]
  }
}
