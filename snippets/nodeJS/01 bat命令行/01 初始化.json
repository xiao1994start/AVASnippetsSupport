{
  "node.js 临时环境初始化": {
    "prefix": ["init node --Portable"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "",
      "",
      "@REM  * 初始化 node 环境变量",
      "if not exist \".\\node\" ( for /D %%i in (\"*node*\") do ( if /I \"%%~nxi\" NEQ \"node_modules\" ( ren \"%%i\" \"node\" ) ) )",
      "",
      "@REM  * 定义 node 环境变量",
      "set \"local_node=.\\node\"",
      "",
      "@REM  * 添加临时系统环境变量",
      "set \"NODE_PATH=!local_node!;!local_node!\\node_modules;\"",
      "set \"XPATH=%PATH%\"",
      "set \"PATH=%NODE_PATH%;%XPATH%;\"",
      "",
      "ECHO.= node 版本号:",
      "call node -v",
      "ECHO.= npm 版本号:",
      "call npm -v",
      "ECHO.",
      "",
      "ECHO.- 清理 npm 缓存（禁用：推荐的保护功能）",
      "call npm cache clean --force",
      "ECHO.+ 升级 npm",
      "call npm i -g npm --registry https://registry.npmmirror.com/",
      "",
      "ECHO.= 检查 软件仓库位置:",
      "call npm root -g",
      "",
      "if exist \".\\package.json\" ( ECHO.* 重置 package.json 配置文件 && del /F /Q \".\\package.json\" && if exist \".\\package-lock.json\" ( del /F /Q \".\\package-lock.json\" ) )",
      "ECHO.* 自动初始化 npm 项目",
      "call npm init -y",
      "",
      "ECHO.+ 【本地开发必装】安装 @types/node 类型定义",
      "call npm i @types/node --registry https://registry.npmmirror.com/",
      "",
      "ECHO.+ 安装 nodemon 监听文件变化",
      "call npm i -g nodemon --registry https://registry.npmmirror.com/",
      "@REM  * 嵌入式安装位置：./node_modules/.bin/nodemon",
      "",
      "ECHO.+ 安装 typescript TypeScript编译器",
      "call npm i -g typescript --registry https://registry.npmmirror.com/",
      "ECHO.= typescript 版本号:",
      "call tsc --version",
      "if exist \".\\tsconfig.json\" ( ECHO.* 重置 tsconfig.json 配置文件 && del /F /Q \".\\tsconfig.json\")",
      "call tsc --init",
      "@REM  * 嵌入式安装位置：./node_modules/.bin/typescript",
      "",
      "ECHO.",
      "",
      "@REM  ====================== ** npm ** ======================",
      "",
      "",
      "$0",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "endlocal",
      ""
    ],
    "description": ["node.js 临时环境初始化"]
  }
}
