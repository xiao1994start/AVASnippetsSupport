{
  "Electron Forge 构建 Electron - Vite 项目": {
    "prefix": ["init_electron_vite_-Electron_Forge"],
    "body": [
      "@ECHO OFF",
      "setlocal EnableDelayedExpansion",
      "CD /D \"%~dp0\"",
      "",
      "@REM ====================== 基础环境配置 ======================",
      "@REM * 标化 node 环境目录",
      "if not exist \"%~dp0node\" ( for /D %%i in (\"*node*\") do ( if /I \"%%~nxi\" NEQ \"node_modules\" ( ren \"%%i\" \"node\" ) ) )",
      "@REM * 定义 node 环境变量",
      "set \"local_node=%~dp0node\"",
      "@REM * 设置临时系统环境变量",
      "set \"NODE_PATH=!local_node!;!local_node!\\node_modules;\"",
      "set \"PATH=!NODE_PATH!;%PATH%;\"",
      "",
      "@REM  ECHO.= node 版本号: && call node -v",
      "@REM  ECHO.= npm 版本号: && call npm -v",
      "",
      "@REM  ECHO.- 清理 npm 缓存（禁用：推荐的保护功能）",
      "@REM  call npm cache clean --force",
      "@REM  ECHO.+ 升级 npm",
      "@REM  call npm i npm -g --registry https://registry.npmmirror.com/",
      "@REM  ECHO.= 检查 软件仓库位置:",
      "@REM  call npm root -g",
      "",
      "@REM  @REM * 替换 npm 国内镜像源（全局）",
      "@REM  ECHO.npm 设置为淘宝镜像源",
      "@REM  call npm config set registry https://registry.npmmirror.com/",
      "@REM  @REM  ! npm approve-scripts::https://npm.nodejs.cn/cli/v12/commands/npm-approve-scripts",
      "@REM  @REM  ? --all 一次性批准每个带有未经审核安装脚本的软件包",
      "@REM  @REM  ? --allow-scripts-pending 允许批准带有未经审核安装脚本的软件包",
      "@REM  call npm approve-scripts --allow-scripts-pending && call npm install-scripts approve --all",
      "",
      "@REM ====================== Forge 构建 Electron 项目 ======================",
      "",
      "set \"project_name=electron-vite-${1:ts}\"",
      "",
      "if not exist \"%~dp0%project_name%\\\" (",
      "  @REM  = 配置 Electron 镜像源",
      "  set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/",
      "  ECHO.Forge 构建 Electron 项目",
      "  @REM  中文官网::https://www.electronjs.org/zh/",
      "  @REM  帮助文档::https://www.electronforge.io/",
      "  ECHO.* 项目创建建议：",
      "  ECHO.*  Ok to proceed? ^(y^) :  Yes/y/Enter",
      "  ECHO.*  ? Select a package manager  npm",
      "  ECHO.*  ? Select a bundler  Vite",
      "  ECHO.*  ? Select a programming language  TypeScript",
      "  ECHO.*  ? Select an Electron release  electron@latest",
      "  ECHO.*  ? Would you like to initialize Git in your new project?  n",
      "  @REM  ? 模板配置项: --template vite --typescript",
      "  call npx create-electron-app@latest %project_name%",
      "  @REM * 进入项目目录安装必备依赖",
      "  CD \"%~dp0%project_name%\"",
      "  set \"NODE_PATH=%~dp0node;%~dp0node\\node_modules;%~dp0node_modules;%~dp0node_modules\\.bin;%~dp0%project_name%\\node_modules;%~dp0%project_name%\\node_modules\\.bin;\"",
      "  set \"PATH=!NODE_PATH!;%PATH%;\"",
      "  ECHO.* 安装 项目依赖",
      "  call npm i --registry https://registry.npmmirror.com/",
      "  ECHO.+ 【本地开发必装】安装 @types/node 类型定义",
      "  call npm i @types/node -D --registry https://registry.npmmirror.com/",
      "  ECHO.+ 【TypeScript】安装 tsx 运行时加速器",
      "  call npm i tsx -g --registry https://registry.npmmirror.com/",
      "  call npm i tsx --registry https://registry.npmmirror.com/",
      "  @REM  * vite_vue 依赖项",
      "  ECHO.* 安装 vite_vue 依赖项",
      "  call npm i vue --registry https://registry.npmmirror.com/",
      "  call npm i @vitejs/plugin-vue -D --registry https://registry.npmmirror.com/",
      "  call npm i @electron-forge/plugin-vite -D --registry https://registry.npmmirror.com/",
      "  @REM  * axios 请求库",
      "  ECHO.* 安装 axios 请求库 :: https://www.axios-http.cn/",
      "  call npm i axios --registry https://registry.npmmirror.com/",
      "  @REM  * VueUse 组合式工具集",
      "  ECHO.* 安装 VueUse 组合式工具集 :: https://vueuse.org/ - https://vueuse.nodejs.cn/",
      "  call npm i @vueuse/core --registry https://registry.npmmirror.com/",
      "  @REM  * vue-router 渐进式路由库",
      "  ECHO.* 安装 vue-router 渐进式路由库 :: https://router.vuejs.org/zh/",
      "  call npm i vue-router --registry https://registry.npmmirror.com/",
      "  @REM  * pinia 全局数据存储集中管理库",
      "  ECHO.* 安装 pinia 全局数据存储集中管理库 :: https://pinia.vuejs.ac.cn/",
      "  call npm i pinia --registry https://registry.npmmirror.com/",
      "  @REM  * ElementPlus 组件库",
      "  ECHO.* 安装 ElementPlus 组件库 :: https://element-plus.org/zh-CN/guide/installation",
      "  call npm i element-plus --registry https://registry.npmmirror.com/",
      "  ECHO.* 安装 @element-plus/icons-vue 图标包管理器 :: https://element-plus.org/zh-CN/component/icon",
      "  call npm i @element-plus/icons-vue --registry https://registry.npmmirror.com/",
      "  @REM  * vite-plugin-inspect 快速插件检查",
      "  ECHO.* 安装 vite-plugin-inspect 快速插件检查 :: https://www.npmjs.com/package/vite-plugin-inspect",
      "  call npm i vite-plugin-inspect --registry https://registry.npmmirror.com/",
      "  @REM  * unplugin-vue-components unplugin-auto-import 自动导入插件",
      "  ECHO.* 安装 unplugin-vue-components unplugin-auto-import 自动导入插件 :: https://element-plus.org/zh-CN/guide/quickstart#%E8%87%AA%E5%8A%A8%E5%AF%BC%E5%85%A5-%E6%8E%A8%E8%8D%90",
      "  call npm i unplugin-vue-components unplugin-auto-import -D --registry https://registry.npmmirror.com/",
      "  @REM  * unplugin-icons 图标组件",
      "  ECHO.* 安装 unplugin-icons 图标组件 :: https://unplugin.unjs.io/showcase/unplugin-icons.html",
      "  call npm i unplugin-icons -D --registry https://registry.npmmirror.com/",
      "  @REM  * iconify-json/ep 开源图标集",
      "  ECHO.* 安装 iconify-json/ep 开源图标集 :: https://icon-sets.iconify.design/ep/",
      "  call npm i @iconify-json/ep -D --registry https://registry.npmmirror.com/",
      "  @REM  * vite-plugin-vue-devtools 开发调试插件",
      "  ECHO.* 安装 vite-plugin-vue-devtools 开发调试插件",
      "  call npm i vite-plugin-vue-devtools -D --registry https://registry.npmmirror.com/",
      "  CD /D \"%~dp0\"",
      ")",
      "if not exist \"%~dp0%project_name%\\vite.renderer.config.unplugin.ts\" (",
      "  setlocal DisableDelayedExpansion",
      "  set \"TARGET_FILE=%~dp0%project_name%\\vite.renderer.config.unplugin.ts\"",
      "  ECHO.写入 unplugin 自动导入插件配置文件",
      "  powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "  \"\\$lines = @(\" ^",
      "  \"  '/**',\" ^",
      "  \"  ' * # unplugin 自动导入插件配置文件',\" ^",
      "  \"  ' * @use vite.renderer.config.mts 中引入 =>',\" ^",
      "  \"  '     import unplugin_Config from ''./vite.renderer.config.unplugin.ts''',\" ^",
      "  \"  ' *   export default defineConfig({',\" ^",
      "  \"  '       plugins: [vue(), ...unplugin_Config.plugins], // 解构导入',\" ^",
      "  \"  ' *   })',\" ^",
      "  \"  ' * ! 注意：./src/main.ts 中需要手动引入 element-plus 中文语言包 主题样式',\" ^",
      "  \"  '   import ElementPlus from ''element-plus''',\" ^",
      "  \"  '   import ''element-plus/dist/index.css'' // * 引入 element-plus 默认样式',\" ^",
      "  \"  '   import ''element-plus/theme-chalk/dark/css-vars.css'' // * 引入 element-plus 暗黑主题样式',\" ^",
      "  \"  '   import zhCn from ''element-plus/es/locale/lang/zh-cn'' // * 国际化: 中文语言包',\" ^",
      "  \"  ' * const app = createApp(App)',\" ^",
      "  \"  '   app.use(ElementPlus, { locale: zhCn })',\" ^",
      "  \"  ' * app.mount(''#app'')',\" ^",
      "  \"  ' */',\" ^",
      "  \"  'import AutoImport from ''unplugin-auto-import/vite'' // * 引入 AutoImport 插件',\" ^",
      "  \"  'import Components from ''unplugin-vue-components/vite'' // * 引入 Components 插件',\" ^",
      "  \"  'import { ElementPlusResolver } from ''unplugin-vue-components/resolvers'' // * 引入 ElementPlusResolver 解析器',\" ^",
      "  \"  'import Icons from ''unplugin-icons/vite''',\" ^",
      "  \"  'import IconsResolver from ''unplugin-icons/resolver''',\" ^",
      "  \"  'import Inspect from ''vite-plugin-inspect''',\" ^",
      "  \"  'const unplugin_Config = {',\" ^",
      "  \"  '  plugins: [',\" ^",
      "  \"  '    AutoImport({',\" ^",
      "  \"  '      imports: [''vue'', ''vue-router'', ''pinia'', ''@vueuse/core''], // 自动导入相关函数',\" ^",
      "  \"  '      resolvers: [',\" ^",
      "  \"  '        ElementPlusResolver(), // 自动导入 Element Plus 相关函数，如：ElMessage, ElMessageBox... (带样式)',\" ^",
      "  \"  '        IconsResolver({ prefix: ''Icon'' }), // 自动导入图标组件',\" ^",
      "  \"  '      ],',\" ^",
      "  \"  '      vueTemplate: true, // 是否在 Vue 模板中自动导入',\" ^",
      "  \"  '      dts: ''src/types/auto-imports.d.ts'', // 生成函数类型声明文件',\" ^",
      "  \"  '    }),',\" ^",
      "  \"  '    Components({',\" ^",
      "  \"  '      dirs: [''src/**'', ''src/components'', ''src/**/components''], // 指定组件扫描目录',\" ^",
      "  \"  '      deep: true, // 是否递归扫描子目录',\" ^",
      "  \"  '      extensions: [''vue''], // 组件文件扩展名',\" ^",
      "  \"  '      resolvers: [',\" ^",
      "  \"  '        ElementPlusResolver(), // 自动导入 Element Plus 相关函数',\" ^",
      "  \"  '        IconsResolver({ enabledCollections: [''ep''] }), // 自动注册图标组件',\" ^",
      "  \"  '      ],',\" ^",
      "  \"  '      dts: ''src/types/components.d.ts'', // 生成组件类型声明文件',\" ^",
      "  \"  '    }),',\" ^",
      "  \"  '    Icons({ autoInstall: true }), // * 挂载 Icons 插件',\" ^",
      "  \"  '    Inspect(), // * 挂载 Inspect 插件',\" ^",
      "  \"  '  ],',\" ^",
      "  \"  '}',\" ^",
      "  \"  'export default unplugin_Config',\" ^",
      "  \"  ''\" ^",
      "  \") -join [Environment]::NewLine;\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$filePath, [string]\\$lines, \\$utf8NoBom)\"",
      "  setlocal EnableDelayedExpansion",
      ")",
      "if not exist \"%~dp0%project_name%\\vite.renderer.config.proxy.ts\" (",
      "  setlocal DisableDelayedExpansion",
      "  set \"TARGET_FILE=%~dp0%project_name%\\vite.renderer.config.proxy.ts\"",
      "  ECHO.写入 vite 代理跨域配置文件",
      "  powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "  \"\\$lines = @(\" ^",
      "  \"  '/**',\" ^",
      "  \"  ' * # 代理配置',\" ^",
      "  \"  ' * @type {server: {proxy: {''/代理地址标识'': {target: ''目标服务器地址'', changeOrigin: true, rewrite: (path: string) => path.replace(/^^\\/正则匹配代理地址标识重写路径/, '''')}}}}',\" ^",
      "  \"  ' * @use vite.renderer.config.mts 中引入 =>',\" ^",
      "  \"  '     import server_proxy_Config from ''./vite.renderer.config.proxy.ts''',\" ^",
      "  \"  ' *   export default defineConfig({',\" ^",
      "  \"  '       server: {,',\" ^",
      "  \"  '         proxy: server_proxy_Config.server.proxy,',\" ^",
      "  \"  '       },',\" ^",
      "  \"  ' *   })',\" ^",
      "  \"  ' */',\" ^",
      "  \"  'type ProxyConfig = {',\" ^",
      "  \"  '  server: {',\" ^",
      "  \"  '    proxy: {',\" ^",
      "  \"  '      [key: string]: {',\" ^",
      "  \"  '        target: string',\" ^",
      "  \"  '        changeOrigin: boolean',\" ^",
      "  \"  '        rewrite: (path: string) => string',\" ^",
      "  \"  '      }',\" ^",
      "  \"  '    }',\" ^",
      "  \"  '  }',\" ^",
      "  \"  '}',\" ^",
      "  \"  'const server_proxy_Config: ProxyConfig = {',\" ^",
      "  \"  '  server: {',\" ^",
      "  \"  '    // * 开发服务器选项:https://cn.vitejs.dev/config/server-options',\" ^",
      "  \"  '    // host: true, // - true=监听本机所有网卡IP地址，允许局域网内访问',\" ^",
      "  \"  '    // strictPort: false, // - true=端口被占用时直接报错退出，不会自动跳到下一个空闲端口; false=自动跳到下一个空闲端口',\" ^",
      "  \"  '    // allowedHosts: [''vite.dev''], // - 允许响应的主机名: true=允许所有主机名响应',\" ^",
      "  \"  '    proxy: {',\" ^",
      "  \"  '      // ''/定义代理地址标识'': {',\" ^",
      "  \"  '      //   target: ''https://api.com'', // * 目标服务器地址',\" ^",
      "  \"  '      //   changeOrigin: true, // - 核心：修改请求头host，开启代理',\" ^",
      "  \"  '      //   rewrite: (path: string) => path.replace(/^^\\/正则匹配代理地址标识重写路径/, ''''),',\" ^",
      "  \"  '      // },',\" ^",
      "  \"  '    },',\" ^",
      "  \"  '  },',\" ^",
      "  \"  '}',\" ^",
      "  \"  'export default server_proxy_Config'\" ^",
      "  \") -join [Environment]::NewLine;\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$filePath, [string]\\$lines, \\$utf8NoBom)\"",
      "  setlocal EnableDelayedExpansion",
      ")",
      "if not exist \"%~dp0%project_name%\\vite.renderer.config.resolve.ts\" (",
      "  setlocal DisableDelayedExpansion",
      "  set \"TARGET_FILE=%~dp0%project_name%\\vite.renderer.config.resolve.ts\"",
      "  ECHO.写入 vite 路径别名配置文件",
      "  powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "  \"\\$lines = @(\" ^",
      "  \"  '/**',\" ^",
      "  \"  ' * # 配置 @ 路径别名',\" ^",
      "  \"  ' * @type {resolve: {alias: {''@'': {fileURLToPath(new URL(''./src'', import.meta.url))}}}}',\" ^",
      "  \"  ' * @use vite.renderer.config.mts 中引入 =>',\" ^",
      "  \"  '      import resolve_Config from ''./vite.renderer.config.resolve.ts''',\" ^",
      "  \"  '      export default defineConfig({',\" ^",
      "  \"  '        resolve: {alias: resolve_Config.resolve.alias},',\" ^",
      "  \"  '      })',\" ^",
      "  \"  '   @配置 tsconfig.json =>',\" ^",
      "  \"  '    \\\"compilerOptions\\\": {',\" ^",
      "  \"  '      \\\"types\\\": [\\\"node\\\", \\\"vite/client\\\"],',\" ^",
      "  \"  '      \\\"paths\\\": {',\" ^",
      "  \"  '        \\\"@/*\\\": [\\\"./src/*\\\"]',\" ^",
      "  \"  '      },',\" ^",
      "  \"  '   @配置 tsconfig.app.json && tsconfig.node.json =>',\" ^",
      "  \"  '      \\\"compilerOptions\\\": {',\" ^",
      "  \"  '        \\\"paths\\\": {',\" ^",
      "  \"  '          \\\"@/*\\\": [\\\"./src/*\\\"]',\" ^",
      "  \"  '        },',\" ^",
      "  \"  '      },',\" ^",
      "  \"  ' */',\" ^",
      "  \"  'import { fileURLToPath, URL } from ''node:url''',\" ^",
      "  \"  'const resolve_Config = {',\" ^",
      "  \"  '  resolve: {',\" ^",
      "  \"  '    alias: {',\" ^",
      "  \"  '      // * 配置import路径别名: @ => ./src',\" ^",
      "  \"  '      ''@'': fileURLToPath(new URL(''./src'', import.meta.url)),',\" ^",
      "  \"  '    },',\" ^",
      "  \"  '  },',\" ^",
      "  \"  '}',\" ^",
      "  \"  'export default resolve_Config',\" ^",
      "  \"  ''\" ^",
      "  \") -join [Environment]::NewLine;\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$filePath, [string]\\$lines, \\$utf8NoBom)\"",
      "  setlocal EnableDelayedExpansion",
      ")",
      "if not exist \"%~dp0%project_name%\\vite.renderer.config.vueDevTools.ts\" (",
      "  setlocal DisableDelayedExpansion",
      "  set \"TARGET_FILE=%~dp0%project_name%\\vite.renderer.config.vueDevTools.ts\"",
      "  ECHO.写入 vueDevTools 插件配置文件",
      "  powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "  \"\\$lines = @(\" ^",
      "  \"  '/**',\" ^",
      "  \"  ' * @use vite.renderer.config.mts 中引入 =>',\" ^",
      "  \"  '     import devTools from ''./vite.renderer.config.vueDevTools.ts'' ',\" ^",
      "  \"  ' *   export default defineConfig({',\" ^",
      "  \"  '       plugins: [devTools],',\" ^",
      "  \"  ' *   })',\" ^",
      "  \"  ' */',\" ^",
      "  \"  'import vueDevTools from ''vite-plugin-vue-devtools'' // * 引入 vueDevTools 插件',\" ^",
      "  \"  '/**',\" ^",
      "  \"  ' * # vueDevTools 配置文件 => vite.renderer.config.mts',\" ^",
      "  \"  ' * export default defineConfig({',\" ^",
      "  \"  ' *   plugins: [',\" ^",
      "  \"  ' *     vue(),',\" ^",
      "  \"  ' *     ...,',\" ^",
      "  \"  ' *     vueDevTools(), // * 挂载 vueDevTools 插件',\" ^",
      "  \"  ' *   ],',\" ^",
      "  \"  ' * })',\" ^",
      "  \"  ' */',\" ^",
      "  \"  'const devTools = vueDevTools()',\" ^",
      "  \"  'export default devTools',\" ^",
      "  \"  ''\" ^",
      "  \") -join [Environment]::NewLine;\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$filePath, [string]\\$lines, \\$utf8NoBom)\"",
      "  setlocal EnableDelayedExpansion",
      ")",
      "if exist \"%~dp0%project_name%\\\" (",
      "  if not exist \"%~dp0%project_name%\\#run_dev.cmd\" (",
      "    ECHO.* 写入启动脚本",
      "    (  ECHO.@ECHO OFF",
      "    ECHO.setlocal EnableDelayedExpansion",
      "    ECHO.@REM  = 配置 Electron 镜像源",
      "    ECHO.set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/",
      "    ECHO.CD /D \"%%~dp0\"",
      "    ECHO.@REM * 设置环境变量",
      "    ECHO.if not exist \"%%~dp0..\\node\" ECHO.请先配置 nodeJS 环境 ^&^& EXIT /B",
      "    ECHO.set \"local_node=%%~dp0..\\node\"",
      "    ECHO.@REM * 添加临时系统环境变量",
      "    ECHO.set \"NODE_PATH=^!local_node^!\\;^!local_node^!\\node_modules\\;%%~dp0node_modules;%%~dp0node_modules\\.bin;\"",
      "    ECHO.set \"PATH=^!NODE_PATH^!;%%PATH%%;\"",
      "    ECHO.@REM * dev 运行Electron Forge项目",
      "    ECHO.call npm start",
      "    ECHO.endlocal",
      "    )>\"%~dp0%project_name%\\#run_dev.cmd\"",
      "  )",
      "  if not exist \"%~dp0%project_name%\\#npm_package.cmd\" (",
      "    ECHO.* 写入项目依赖管理脚本",
      "    (  ECHO.@ECHO OFF",
      "    ECHO.setlocal EnableDelayedExpansion",
      "    ECHO.@REM  = 配置 Electron 镜像源",
      "    ECHO.set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/",
      "    ECHO.CD /D \"%%~dp0\"",
      "    ECHO.@REM * 设置环境变量",
      "    ECHO.if not exist \"%%~dp0..\\node\" ECHO.请先配置 nodeJS 环境 ^&^& EXIT /B",
      "    ECHO.set \"local_node=%%~dp0..\\node\"",
      "    ECHO.@REM * 添加临时系统环境变量",
      "    ECHO.set \"NODE_PATH=^!local_node^!\\;^!local_node^!\\node_modules\\;%%~dp0node_modules;%%~dp0node_modules\\.bin;\"",
      "    ECHO.set \"PATH=^!NODE_PATH^!;%%PATH%%;\"",
      "    ECHO.call npm i --registry https://registry.npmmirror.com/",
      "    ECHO.@REM * ====================== ** npm ** ======================",
      "    ECHO.",
      "    ECHO.endlocal",
      "    )>\"%~dp0%project_name%\\#npm_package.cmd\"",
      "  )",
      "  CD /D \"%~dp0\"",
      ")",
      "",
      "@REM  ===  集成配置 ===",
      "if exist \"%~dp0%project_name%\\index.html\" (",
      "  ECHO.重写 index.html 文件",
      "  setlocal DisableDelayedExpansion",
