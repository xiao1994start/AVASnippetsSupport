{
  "element-plus 侧边栏路由导航": {
    "prefix": ["aaa_app_el_aside_router_-vue"],
    "body": [
      "<template>",
      "  <el-container class=\"window\">",
      "    <el-header class=\"window-header\">",
      "      <div class=\"header-content\">Vite Application</div>",
      "      <div class=\"window-control\">",
      "        <el-button class=\"theme-btn\" :type=\"''\" @click=\"toggleThemeWithAnimation\" :round=\"true\" v-show=\"isDark\">",
      "          <el-icon :color=\"''\" :size=\"18\"><i-ep-Sunny /></el-icon></el-button>",
      "        <el-button class=\"theme-btn\" :type=\"''\" @click=\"toggleThemeWithAnimation\" :round=\"true\" v-show=\"!isDark\">",
      "          <el-icon :color=\"''\" :size=\"18\"><i-ep-Moon /></el-icon></el-button>",
      "        <el-switch class=\"theme-switch\" :model-value=\"isDark\" @click=\"toggleThemeWithAnimation\" size=\"large\"",
      "          inline-prompt active-text=\"暗黑\" inactive-text=\"明亮\">",
      "          <template #active-action>",
      "            <el-icon :color=\"''\" :size=\"18\">",
      "              <i-ep-Moon /> </el-icon>",
      "          </template>",
      "          <template #inactive-action>",
      "            <el-icon :color=\"''\" :size=\"18\">",
      "              <i-ep-Sunny /> </el-icon>",
      "          </template>",
      "        </el-switch>",
      "      </div>",
      "    </el-header>",
      "    <el-container class=\"window-content\" :direction=\"'horizontal'\">",
      "      <el-aside :width=\"true ? '128px' : '192px'\">",
      "        <el-menu router :default-active=\"\\$route.path ?? '/'\">",
      "          <el-menu-item v-for=\"routes in routers\" :index=\"routes.path\" :key=\"routes.path\">",
      "            {{ routes.name }}</el-menu-item></el-menu></el-aside>",
      "      <el-container><el-main><router-view></router-view></el-main>",
      "        <el-footer>",
      "          <div>状态栏</div>",
      "        </el-footer></el-container></el-container>",
      "  </el-container>",
      "</template>",
      "${0}",
      "<script setup lang=\"ts\">",
      "  import { useDark, useToggle } from '@vueuse/core'",
      "  const isDark = useDark() // ? 响应式数据 v-model 绑定: isDark",
      "  const toggleDark = useToggle(isDark)",
      "  function toggleThemeWithAnimation(event: MouseEvent) {",
      "    // = el-switch 组件属性 :model-value 绑定状态仅展示值，不触发实际切换事件；v-model 会对绑定状态进行切换",
      "    // * 检查浏览器是否支持 View Transitions API ",
      "    if (!document.startViewTransition) {",
      "      // 浏览器不支持 View Transitions API 则直接降级切换 ",
      "      toggleDark()",
      "      return",
      "    }",
      "    // * 启动视图过渡",
      "    const transition = document.startViewTransition(() => {",
      "      toggleDark() // 在回调中执行实际的主题切换 ",
      "    })",
      "    // * 过渡准备就绪后，执行自定义动画 ",
      "    transition.ready.then(() => {",
      "      const { clientX, clientY } = event",
      "      // 计算从点击位置到窗口最远角的距离，作为圆形动画的半径 ",
      "      const radius = Math.hypot(",
      "        Math.max(clientX, window.innerWidth - clientY),",
      "        Math.max(clientY, window.innerHeight - clientX)",
      "      )",
      "      const clipPath = [",
      "        `circle(0px at \\${clientX}px \\${clientY}px)`,",
      "        `circle(\\${radius}px at \\${clientX}px \\${clientY}px)`,",
      "      ]",
      "      // 使用 Web Animations API 在伪元素上执行裁剪动画 ",
      "      document.documentElement.animate(",
      "        { clipPath: clipPath, },",
      "        {",
      "          duration: 300,",
      "          pseudoElement: '::view-transition-new(root)',",
      "        }",
      "      )",
      "    })",
      "  }",
      "  import { router_Map } from '@/router/index.ts'",
      "  const routers = router_Map.length ? ref(router_Map) : [{ path: '/', name: '首页' }, { path: '/abuot', name: '关于' }]",
      "</script>",
      "",
      "<style>",
      "  * {",
      "    /* 为 Electron/Chrome 等 WebKit 内核兼容 */",
      "    -webkit-user-select: none;",
      "    /* 为 Firefox 兼容 */",
      "    -moz-user-select: none;",
      "    /* 为 IE/Edge 兼容 */",
      "    -ms-user-select: none;",
      "    /* 标准属性 */",
      "    user-select: none;",
      "    /* height/width 不受 padding/border 影响 */",
      "    box-sizing: border-box;",
      "  }",
      "",
      "  html,",
      "  body {",
      "    padding: 0;",
      "    margin: 0;",
      "    height: 100%;",
      "    width: 100%;",
      "    overflow: hidden;",
      "  }",
      "",
      "  ::view-transition-old(root),",
      "  ::view-transition-new(root) {",
      "    /* 禁用默认动画 */",
      "    animation: none;",
      "  }",
      "</style>",
      "<style scoped>",
      "  .window {",
      "    display: flex;",
      "    flex-direction: column;",
      "    height: 100vh;",
      "    width: 100vw;",
      "    border: 2px solid #4A4F5580;",
      "    border-radius: 8px;",
      "  }",
      "",
      "  .window-header {",
      "    -webkit-app-region: drag;",
      "    display: flex;",
      "    justify-content: space-between;",
      "    padding: 5px;",
      "    height: auto;",
      "    font-size: large;",
      "    font-weight: bold;",
      "    border-bottom: 1px solid #4A4F5580;",
      "",
      "    .window-control {",
      "      -webkit-app-region: no-drag;",
      "",
      "      .state-btn,",
      "      .theme-btn,",
      "      .close-btn {",
      "        padding: 5px;",
      "        margin: 0;",
      "        background-color: transparent;",
      "        --el-border-color: transparent;",
      "      }",
      "",
      "      .theme-btn:hover,",
      "      .theme-btn:active,",
      "      .state-btn:hover,",
      "      .state-btn:active {",
      "        background-color: #6C727540;",
      "        box-shadow: 0 0 5px #6C727580;",
      "        --el-button-hover-border-color: transparent;",
      "        --el-button-active-border-color: transparent;",
      "      }",
      "",
      "      .close-btn:hover,",
      "      .close-btn:active {",
      "        background-color: #C3272B40;",
      "        box-shadow: 0 0 5px #C3272B80;",
      "        --el-button-hover-border-color: transparent;",
      "        --el-button-active-border-color: transparent;",
      "      }",
      "",
      "      .theme-switch {",
      "        --el-switch-on-color: #2A2A2C;",
      "        --el-switch-off-color: #2A2A2C;",
      "      }",
      "    }",
      "  }",
      "",
      "  .window-content {",
      "    display: flex;",
      "    overflow: auto;",
      "",
      "    .el-aside {",
      "      border-right: 1px solid #4A4F5580;",
      "      scrollbar-width: thin;",
      "",
      "      .el-menu {",
      "        --el-menu-active-color: #D93829;",
      "        font-weight: normal;",
      "        border: 0;",
      "",
      "        .el-menu-item {",
      "          /* 仅在必要时（无其他断点可用时）允许在任意点断行 */",
      "          overflow-wrap: anywhere;",
      "          /* 强制换行 word-break: break-all; */",
      "          word-break: normal;",
      "          white-space: normal;",
      "          line-height: normal;",
      "          flex-shrink: 0;",
      "          height: auto;",
      "          /* * 容器随内容自适应换行自动调整高度 * */",
      "          padding: 8px;",
      "          margin: 4px;",
      "          border-radius: 8px;",
      "        }",
      "",
      "        .el-menu-item:hover {",
      "          font-weight: bold;",
      "          background-color: #6C727540;",
      "        }",
      "",
      "        .el-menu-item.is-active {",
      "          font-weight: bold;",
      "          background-color: #C62D2D20;",
      "        }",
      "      }",
      "    }",
      "",
      "    .el-main {",
      "      scrollbar-width: thin;",
      "      padding: 8px;",
      "    }",
      "",
      "    .el-footer {",
      "      height: auto;",
      "      padding: 8px;",
      "      border-top: 1px solid #4A4F5580;",
      "      font-size: smaller;",
      "      text-align: end;",
      "    }",
      "  }",
      "</style>"
    ],
    "description": ["element-plus 侧边栏路由导航"]
  },
  "element-plus 弹窗模板": {
    "prefix": ["aaa_el_dialog_-vue"],
    "body": [
      "<template>",
      "  <el-dialog class=\"task_dialog\" v-model=\"visible\" :title=\"dialogTitle\" :align-center=\"align_center\"",
      "    :show-close=\"show_close\" :destroy-on-close=\"destroy_on_close\" :close-on-click-modal=\"close_on_click_modal\"",
      "    :close-on-press-escape=\"close_on_press_escape\">",
      "    <div class=\"task_body\">",
      "      <el-progress :percentage=\"percent\" :stroke-width=\"stroke_width\" :text-inside=\"text_inside\" :status=\"status\"",
      "        indeterminate striped striped-flow />",
      "      <div class=\"task_message\">",
      "        <span>{{ currentMessage }}</span>",
      "      </div>",
      "      <div class=\"task_counter\">{{ currentIndex }} / {{ total }}</div>",
      "    </div>",
      "  </el-dialog>",
      "</template>",
      "",
      "<script setup lang='ts'>",
      "  import { onUnmounted } from 'vue'",
      "  // * 弹窗状态",
      "  const visible = ref(false) // 是否显示弹窗",
      "  const running = ref(false) // 是否有任务在运行",
      "  const aborted = ref(false) // 是否被中断",
      "  // * 弹窗属性",
      "  const dialogTitle = ref('') // 弹窗标题",
      "  const align_center = ref(true) // 是否居中显示弹窗",
      "  const show_close = ref(false) // 是否显示关闭按钮",
      "  const destroy_on_close = ref(true) // 是否在关闭弹窗时销毁组件",
      "  const close_on_click_modal = ref(false) // 是否点击弹窗外部关闭弹窗",
      "  const close_on_press_escape = ref(false) // 是否按下 ESC 键关闭弹窗",
      "  // * 进度条属性",
      "  const percent = ref(0) // 进度条百分比",
      "  const status = ref('') // 进度条状态",
      "  const stroke_width = ref(8) // 进度条宽度",
      "  const text_inside = ref(false) // 是否在进度条内部显示文本",
      "  // * 当前任务消息",
      "  const currentMessage = ref('')",
      "  // * 当前任务索引",
      "  const currentIndex = ref(0)",
      "  // * 总任务数",
      "  const total = ref(0)",
      "  /** * * 可被中断的 sleep: 模拟异步函数，返回一个 Promise，并在卸载时能及时结束 */",
      "  const sleep = (ms: any = 2000) => {",
      "    if (typeof ms !== 'number') ms = 2000",
      "    return new Promise<void>((resolve) => setTimeout(resolve, ms))",
      "  }",
      "  /**",
      "   * #运行任务进度弹窗",
      "   * @param title 弹窗标题",
      "   * @param async_function 异步函数，用于执行任务",
      "   * @param successMsg? 任务执行成功后的提示信息",
      "   * @param after_async_function? 任务执行成功后执行的异步函数",
      "   */",
      "  async function run_Dialog(title: string, successMsg: string, async_function?: { fn: (param?: any) => Promise<any>, args?: any[], loop_Count?: number }, after_async_function?: { fn: (param?: any) => Promise<any>, args?: any[], arg?: any }) {",
      "    if (running.value) return console.warn('[TaskProgressDialog] 已有任务在执行，忽略本次调用')",
      "    dialogTitle.value = title",
      "    if (!successMsg) successMsg = '任务执行完毕'",
      "    const taskFn = async_function ? async_function.fn : sleep // 当 fn 为 undefined 或 null 时，默认执行 模拟异步函数",
      "    const taskArgs = async_function ? async_function.args ?? ['模拟参数1', '模拟参数2', '模拟参数3'] : ['模拟参数1', '模拟参数2', '模拟参数3']",
      "    const taskLoopCount = async_function ? async_function.loop_Count ?? taskArgs.length : taskArgs.length",
      "    // * 初始化状态",
      "    visible.value = true",
      "    running.value = true",
      "    aborted.value = false",
      "    percent.value = 0",
      "    total.value = taskLoopCount",
      "    status.value = ''",
      "    close_on_click_modal.value = false",
      "    close_on_press_escape.value = false",
      "    currentMessage.value = ''",
      "    currentIndex.value = 0",
      "    try {",
      "      for (let i = 0; i < taskLoopCount; i++) {",
      "        if (aborted.value) return",
      "        let arg = taskArgs[i]",
      "        currentMessage.value = String(arg)",
      "        currentIndex.value = i + 1",
      "        // - 执行 异步函数",
      "        await taskFn(arg)",
      "        if (aborted.value) return console.warn('[TaskProgressDialog] 任务被中断，忽略本次调用')",
      "        percent.value = Math.round(((i + 1) / taskLoopCount) * 100)",
      "      }",
      "      // * 任务执行完毕，显示执行结果信息",
      "      status.value = 'success'",
      "      currentMessage.value = successMsg",
      "      close_on_click_modal.value = true",
      "      close_on_press_escape.value = true",
      "      // * 重置弹窗任务运行状态，防止阻塞后续任务执行",
      "      running.value = false",
      "      // * 执行任务执行成功后执行的异步函数",
      "      if (after_async_function) {",
      "        if (after_async_function.args) { after_async_function.args.forEach(async (i) => await after_async_function.fn(i)) }",
      "        else if (after_async_function.arg) { await after_async_function.fn(after_async_function.arg) }",
      "        else { await after_async_function.fn() }",
      "      }",
      "      // * 执行结果显示时长",
      "      await sleep()",
      "    } finally {",
      "      // * 检查是否被中断，未被中断则重置弹窗状态",
      "      running.value = false",
      "      if (!aborted.value) visible.value = false",
      "    }",
      "  }",
      "  /** * * 组件卸载时，取消所有任务，打断循环，避免内存泄漏 / 对已卸载状态赋值 */",
      "  onUnmounted(() => {",
      "    aborted.value = true",
      "  })",
      "  /**",
      "   * * 暴露 run_Dialog 方法 ",
      "   * @父组件引入 import TaskProgressDialog from '@/components/TaskProgressDialog.vue'",
      "   * @父组件template <TaskProgressDialog ref=\"taskDialogRef\" /> 引入组件实例引用，使用 ref 定义响应式引用",
      "   * @父组件script const taskDialogRef = ref<InstanceType<typeof TaskProgressDialog>>() 加入InstanceType类型，确保类型安全",
      "   * @父组件调用 await taskDialogRef.value!.run_Dialog(...)",
      "   * */",
      "  defineExpose({ run_Dialog });",
      "</script>",
      "",
      "<style scoped>",
      "  .task_dialog :deep(.el-dialog__headerbtn) {",
      "    display: none;",
      "  }",
      "",
      "  .el-progress :deep(.el-progress__text) {",
      "    margin: 0;",
      "    text-align: end;",
      "    justify-items: end;",
      "  }",
      "",
      "  .task_body {",
      "    display: flex;",
      "    flex-direction: column;",
      "    gap: 12px;",
      "  }",
      "",
      "  .task_message {",
      "    display: flex;",
      "    align-items: center;",
      "    gap: 8px;",
      "    padding: 8px 10px;",
      "    background: var(--el-fill-color-light);",
      "    border-radius: 6px;",
      "    font-size: 14px;",
      "    word-break: break-all;",
      "  }",
      "",
      "  .task_counter {",
      "    text-align: right;",
      "    font-size: 14px;",
      "    color: var(--el-text-color-secondary);",
      "  }",
      "</style>",
      ""
    ],
    "description": ["element-plus 弹窗模板"]
  }
}
