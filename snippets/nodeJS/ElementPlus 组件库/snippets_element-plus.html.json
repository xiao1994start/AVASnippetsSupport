{
  "element-plus 侧边栏路由导航": {
    "prefix": ["aaa_el_aside_router_"],
    "body": [
      "<template>",
      "  <div class=\"main-content\">",
      "    <el-container>",
      "      <el-aside :width=\"true ? '128px' : '192px'\">",
      "        <el-menu router :default-active=\"\\$route.path || '/'\">",
      "          <el-menu-item v-for=\"routes in routers\" :index=\"routes.path\" :key=\"routes.path\">",
      "            {{ routes.name }}",
      "          </el-menu-item>",
      "        </el-menu>",
      "        <el-footer style=\"padding: 4px;text-align: center;--el-footer-height: normal;\">",
      "          <el-switch :model-value=\"isDark\" @click=\"toggleThemeWithAnimation\" size=\"large\" inline-prompt active-text=\"暗黑\"",
      "            inactive-text=\"明亮\" style=\"--el-switch-on-color: #2A2A2C; --el-switch-off-color: #2A2A2C;\">",
      "            <template #active-action>",
      "              <!-- <svg viewBox=\"0 0 24 24\" style=\"color: #F3B940;background-color: #2A2A2C;border-radius: 50%;\">",
      "                <path",
      "                  d=\"M11.01 3.05C6.51 3.54 3 7.36 3 12a9 9 0 0 0 9 9c4.63 0 8.45-3.5 8.95-8c.09-.79-.78-1.42-1.54-.95A5.403 5.403 0 0 1 11.1 7.5c0-1.06.31-2.06.84-2.89c.45-.67-.04-1.63-.93-1.56z\"",
      "                  fill=\"currentColor\"></path>",
      "              </svg> -->",
      "              <el-icon :color=\"''\" :size=\"18\">",
      "                <i-ep-Moon />",
      "              </el-icon>",
      "            </template>",
      "            <template #inactive-action>",
      "              <!-- <svg viewBox=\"0 0 24 24\" style=\"color: #EDF05C;background-color: #1E90FF;border-radius: 50%;\">",
      "                <path",
      "                  d=\"M6.05 4.14l-.39-.39a.993.993 0 0 0-1.4 0l-.01.01a.984.984 0 0 0 0 1.4l.39.39c.39.39 1.01.39 1.4 0l.01-.01a.984.984 0 0 0 0-1.4zM3.01 10.5H1.99c-.55 0-.99.44-.99.99v.01c0 .55.44.99.99.99H3c.56.01 1-.43 1-.98v-.01c0-.56-.44-1-.99-1zm9-9.95H12c-.56 0-1 .44-1 .99v.96c0 .55.44.99.99.99H12c.56.01 1-.43 1-.98v-.97c0-.55-.44-.99-.99-.99zm7.74 3.21c-.39-.39-1.02-.39-1.41-.01l-.39.39a.984.984 0 0 0 0 1.4l.01.01c.39.39 1.02.39 1.4 0l.39-.39a.984.984 0 0 0 0-1.4zm-1.81 15.1l.39.39a.996.996 0 1 0 1.41-1.41l-.39-.39a.993.993 0 0 0-1.4 0c-.4.4-.4 1.02-.01 1.41zM20 11.49v.01c0 .55.44.99.99.99H22c.55 0 .99-.44.99-.99v-.01c0-.55-.44-.99-.99-.99h-1.01c-.55 0-.99.44-.99.99zM12 5.5c-3.31 0-6 2.69-6 6s2.69 6 6 6s6-2.69 6-6s-2.69-6-6-6zm-.01 16.95H12c.55 0 .99-.44.99-.99v-.96c0-.55-.44-.99-.99-.99h-.01c-.55 0-.99.44-.99.99v.96c0 .55.44.99.99.99zm-7.74-3.21c.39.39 1.02.39 1.41 0l.39-.39a.993.993 0 0 0 0-1.4l-.01-.01a.996.996 0 0 0-1.41 0l-.39.39c-.38.4-.38 1.02.01 1.41z\"",
      "                  fill=\"currentColor\"></path>",
      "              </svg> -->",
      "              <el-icon :color=\"''\" :size=\"18\">",
      "                <i-ep-Sunny />",
      "              </el-icon>",
      "            </template>",
      "          </el-switch>",
      "        </el-footer>",
      "      </el-aside>",
      "      <el-container>",
      "        <el-header style=\"padding: 8px;text-align: center;--el-header-height: normal;\">",
      "          <h1 style=\"padding: 0;margin: 0;\">好好学习！天天向上！</h1>",
      "        </el-header>",
      "        <el-main style=\"padding: 8px;\"> <router-view></router-view> </el-main>",
      "        <el-footer style=\"padding: 8px;text-align: center;--el-footer-height: normal;\">",
      "          <h5 style=\"padding: 0;margin: 0;\">想成功，先发疯，不顾一切往前冲。</h5>",
      "        </el-footer>",
      "      </el-container>",
      "    </el-container>",
      "  </div>",
      "</template>",
      "",
      "<script setup lang='ts'>",
      "  import { useDark, useToggle } from '@vueuse/core'",
      "  const isDark = useDark() // ? 响应式数据 v-model 绑定: isDark",
      "  const toggleDark = useToggle(isDark)",
      "  function toggleThemeWithAnimation(event: MouseEvent) {",
      "    // = el-switch 组件属性 :model-value 绑定状态仅展示值，不触发实际切换事件；v-model 会对绑定状态进行切换",
      "    // * 检查浏览器是否支持 View Transitions API ",
      "    if (!document.startViewTransition) {",
      "      // 浏览器不支持 View Transitions API 则直接降级切换 ",
      "      toggleDark()",
      "      return",
      "    }",
      "    // * 启动视图过渡",
      "    const transition = document.startViewTransition(() => {",
      "      toggleDark() // 在回调中执行实际的主题切换 ",
      "    })",
      "    // * 过渡准备就绪后，执行自定义动画 ",
      "    transition.ready.then(() => {",
      "      const { clientX, clientY } = event",
      "      // 计算从点击位置到窗口最远角的距离，作为圆形动画的半径 ",
      "      const radius = Math.hypot(",
      "        Math.max(clientX, window.innerWidth - clientY),",
      "        Math.max(clientY, window.innerHeight - clientX)",
      "      )",
      "      const clipPath = [",
      "        `circle(0px at \\${clientX}px \\${clientY}px)`,",
      "        `circle(\\${radius}px at \\${clientX}px \\${clientY}px)`,",
      "      ]",
      "      // 使用 Web Animations API 在伪元素上执行裁剪动画 ",
      "      document.documentElement.animate(",
      "        { clipPath: clipPath, },",
      "        {",
      "          duration: 300,",
      "          pseudoElement: '::view-transition-new(root)',",
      "        }",
      "      )",
      "    })",
      "  }",
      "  import { router_Map } from '@/router/index.ts'",
      "  const routers = router_Map.length ? ref(router_Map) : [{ path: '/', name: '首页' }, { path: '/abuot', name: '关于' }]",
      "</script>",
      "<style>",
      "",
      "  ::view-transition-old(root),",
      "  ::view-transition-new(root) {",
      "    /* 禁用默认动画 */",
      "    animation: none;",
      "  }",
      "</style>",
      "<style scoped>",
      "  .main-content {",
      "    padding: 0;",
      "    margin: 0;",
      "    display: flex;",
      "    height: 100vh;",
      "",
      "    .el-aside {",
      "      display: flex;",
      "      flex-direction: column;",
      "      border: 1px solid #777777;",
      "      border-radius: 4px;",
      "",
      "      .el-menu {",
      "        flex: 1;",
      "        overflow: auto;",
      "        scrollbar-width: thin;",
      "        font-weight: normal;",
      "        --el-menu-active-color: #FC0FC0;",
      "",
      "        .el-menu-item {",
      "          height: auto;",
      "          padding: 8px;",
      "          margin: 4px;",
      "          border-radius: 8px;",
      "          white-space: normal;",
      "          line-height: normal;",
      "          word-break: break-word;",
      "        }",
      "",
      "        .el-menu-item:hover {",
      "          font-weight: bold;",
      "          background-color: #77777720;",
      "        }",
      "",
      "        .el-menu-item.is-active {",
      "          font-weight: bold;",
      "          background-color: #FC0FC020;",
      "        }",
      "      }",
      "    }",
      "",
      "",
      "  }",
      "</style>",
      ""
    ],
    "description": ["element-plus 侧边栏路由导航"]
  },
  "el-menu 路由菜单": {
    "prefix": ["el_menu_-router"],
    "body": [
      "<el-menu router",
      "  style=\"flex: 1;overflow: auto;scrollbar-width: thin;font-weight: bold;--el-menu-active-color:#41BC6C;\"",
      "  :default-active=\"\\$route.path || '/'\">",
      "  <el-menu-item index=\"/${1:路由地址}\"",
      "    style=\"height: auto;white-space: normal;line-height: normal;word-break: break-word;padding: 8px;\">",
      "    ${2:路由标签}",
      "  </el-menu-item>",
      "",
      "</el-menu>",
      ""
    ],
    "description": ["el-menu 路由菜单"]
  },
  "el-menu-item 路由菜单选项": {
