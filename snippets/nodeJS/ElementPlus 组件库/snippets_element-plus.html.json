{
  "el-menu 路由菜单": {
    "prefix": ["el_menu_-router"],
    "body": [
      "<el-menu router",
      "  style=\"flex: 1;overflow: auto;scrollbar-width: thin;font-weight: bold;--el-menu-active-color:#41BC6C;\"",
      "  :default-active=\"\\$route.path || '/'\">",
      "  <el-menu-item index=\"/${1:路由地址}\"",
      "    style=\"height: auto;white-space: normal;line-height: normal;word-break: break-word;padding: 8px;\">",
      "    ${2:路由标签}",
      "  </el-menu-item>",
      "",
      "</el-menu>",
      ""
    ],
    "description": ["el-menu 路由菜单"]
  },
  "el-menu-item 路由菜单选项": {
    "prefix": ["el_menu_item_-index_router"],
    "body": [
      "<el-menu-item index=\"/${1:路由地址}\"",
      "  style=\"height: auto;white-space: normal;line-height: normal;word-break: break-word;padding: 8px;\">",
      "  ${2:路由标签}",
      "</el-menu-item>",
      ""
    ],
    "description": ["el-menu-item 路由菜单选项"]
  },
  "el-image 开启图片预览功能": {
    "prefix": ["el_image_-preview"],
    "body": [
      "<el-image style=\"width: 100%;height: 100%;border-radius: 8px;justify-content: center;display: flex;\" loading=\"lazy\" lazy",
      "  show-progress fit='cover' :initial-index=\"4\" :zoom-rate=\"1.2\" :max-scale=\"7\" :hide-on-click-modal=\"true\"",
      "  :src=\"${1:URL_图片地址}\" :preview-src-list=\"[${1:URL_图片地址}]\" v-loading=\"ref_加载状态\" @load=\"${1:加载成功回调}\">",
      "  <template #error>",
      "    <i-ep-picture style=\"height: 100%;\" />",
      "  </template>",
      "</el-image>",
      ""
    ],
    "description": ["el-image 开启图片预览功能"]
  }
}
