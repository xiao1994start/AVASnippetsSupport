{
  "PortableGit 临时环境设置": {
    "prefix": ["init git --Portable"],
    "body": [
      "@REM * 定义 git 环境变量",
      "set \"local_git=%~dp0PortableGit\"",
      "",
      "@REM * 添加临时系统环境变量",
      "set \"GIT_PATH=!local_git!;!local_git!\\cmd;!local_git!\\bin;!local_git!\\usr\\bin;\"",
      "@REM set \"XPATH=%CommonProgramFiles(x86)%\\Intel\\Shared Libraries\\bin32;%CommonProgramFiles(x86)%\\Intel\\Shared Libraries\\bin;%SystemRoot%;%SystemRoot%\\system32;%SystemRoot%\\System32\\Wbem;%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\;%SystemRoot%\\System32\\OpenSSH\\\"",
      "set \"XPATH=%PATH%\"",
      "set \"PATH=%GIT_PATH%;%XPATH%;\"",
      "ECHO Git 版本号:",
      "call git -v",
      ""
    ],
    "description": ["PortableGit 临时环境设置"]
  }
}
