  "构建rpa归档文件": {
    "prefix": ["init python build class"],
    "body": [
      "init python:",
      "    # * python语句块*",
      "    # - 定义归档文件 构建文件路径(建议不要使用):build.destination",
      "    build.archive('archive', 'all')",
      "    build.archive('scripts', 'all')",
      "    build.archive('images', 'all')",
      "    build.archive('audio', 'all')",
      "    build.archive('video', 'all')",
      "    build.archive('fonts', 'all')",
      "",
      "    # ! 排除归档文件 将文件分类为“无”以将其从构建的分发中 None",
