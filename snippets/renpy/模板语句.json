{
  "自动添加语言按钮入口": {
    "prefix": ["textbutton _schinese =-action Language"],
    "body": ["textbutton _(\"中文\") text_font \"tl/schinese/fonts/${1:MiSans-Bold.ttf}\" action Language(\"schinese\")", ""],
    "description": ["自动添加语言按钮入口"]
  },
  "默认语言入口": {
    "prefix": ["define config language", "config language"],
    "body": ["# *-默认语言-*", "define config.language = \"${1:schinese}\"", ""],
    "description": ["默认语言入口"]
  },
  "游戏窗口的图标": {
    "prefix": ["define config window_icon", "config window_icon"],
    "body": ["define config.window_icon = \"gui/window_icon.png\""],
    "description": "游戏窗口的图标"
  },
  "定义固定样式": {
    "prefix": ["init python style color"],
    "body": [
      "init python:",
      "    # * 样式模板语句块",
      "    # ; 样式 调用方法: \"[样式名称]会话内容\"",
      "",
      "    gre = \"{color=#0f0}\"  # 绿色",
      "    red = \"{color=#ff0f00}\"  # 红色",
      "    dp = \"{color=#FF1493}\"  # 深粉红",
      "",
      "    # ; 提示 调用方法: \"会话内容[样式名称]\"",
      "    gre_info = \"{color=#00c000}(固定提示内容)\"",
      ""
    ],
    "description": ["定义固定样式"]
  },
  "构建rpa归档文件": {
    "prefix": ["init python build archive"],
    "body": [
      "init python:",
      "    # * 配置：构建发行版 *",
      "    # ! 排除无用文件（通用排除） build.classify('*', None)",
      "    build.classify('**~', None)",
      "    build.classify('**.bak', None)",
      "    build.classify('**/.**', None)",
      "    build.classify('**/#**', None)",
      "    build.classify('**/thumbs.db', None)",
      "    build.classify('**/desktop.ini', None)",
      "    build.classify('**/*.tmp', None)",
      "    build.classify('**/*.swp', None)",
      "    # build.classify('**/*.rpa', None)  # 防止把已有的 rpa 再打包进去",
      "",
      "    # - 定义归档文件 构建文件路径(建议：不要定义 build.destination)",
      "    build.archive('archive', 'all')",
      "    build.archive('scripts', 'all')",
      "    build.archive('images', 'all')",
      "    build.archive('audio', 'all')",
      "    build.archive('video', 'all')",
      "    build.archive('fonts', 'all')",
      "",
      "    # - 分类归档",
      "    build.classify('game/**.rpyc', 'scripts')",
      "    build.classify('game/**.rpymc', 'scripts')",
      "",
      "    build.classify('game/**.png', 'images')",
      "    build.classify('game/**.jpg', 'images')",
      "    build.classify('game/**.jpeg', 'images')",
      "    build.classify('game/**.webp', 'images')",
      "    build.classify('game/**.gif', 'images')",
      "    build.classify('game/**.bmp', 'images')",
      "    build.classify('game/**.avif', 'images')",
      "",
      "    build.classify('game/**.ogg', 'audio')",
      "    build.classify('game/**.mp3', 'audio')",
      "    build.classify('game/**.wav', 'audio')",
      "    build.classify('game/**.opus', 'audio')",
      "    build.classify('game/**.flac', 'audio')",
      "",
      "    build.classify('game/**.webm', 'video')",
      "    build.classify('game/**.mp4', 'video')",
      "    build.classify('game/**.mkv', 'video')",
      "    build.classify('game/**.avi', 'video')",
      "",
      "    build.classify('game/**.ttf', 'fonts')",
      "    build.classify('game/**.otf', 'fonts')",
      "    build.classify('game/**.ttc', 'fonts')",
      "",
      "    build.classify('game/**.rpy', 'archive')  # 源码是否归档看你需求（一般不归档源码）",
      "    build.classify('game/**.rpym', 'archive')",
      "    build.classify('game/**.rpyb', 'archive')",
      "    build.classify('game/**.bak', 'archive')",
      "    build.classify('game/**.md', 'archive')",
      "    build.classify('game/**.txt', 'archive')",
      "    build.classify('game/**.ini', 'archive')",
      "    build.classify('game/**.log', 'archive')",
      "    build.classify('game/**.ps1', 'archive')",
      "    build.classify('game/**.py', 'archive')",
      "    build.classify('game/**.blen_tc', 'archive')",
      "    build.classify('game/**.csv', 'archive')",
      "    build.classify('game/**.json', 'archive')",
      "    build.classify('game/**.save', 'archive')",
      "    build.classify('game/cache/**', 'archive')",
      "    build.classify('game/saves/**', 'archive')",
      "    build.classify('game/atlas/tools/**', 'archive')",
      "    build.classify('game/libs/**', 'archive')",
      "    build.classify('game/**/roadmap/**', 'archive')",
      "    build.classify('game/**.log', 'archive')",
      "",
      "    # ! 不需要更新器就关掉",
      "    build.include_old_themes = False",
      "    # ! 文档文件（会在 Mac 包里同时出现在 app 内外）",
      "    build.documentation('*.html')",
      "    build.documentation('*.txt')",
      "    build.documentation('*.md')",
      "    build.documentation('*.pdf')",
      ""
    ],
    "description": ["构建rpa归档文件"]
  },
  "自定义光标": {
    "prefix": ["define config mouse_displayable", "config mouse_displayable"],
    "body": [
      "# *-自定义光标-*",
      "image mouseCursor:",
      "    zoom 0.2",
      "    \"gui/cursors/Cursor.png\"",
      "define config.mouse_displayable = MouseDisplayable(\"mouseCursor\", 0, 0)",
      ""
    ],
    "description": ["自定义光标"]
  },
  "刷新当前界面": {
    "prefix": ["flush", "renpy restart_interaction"],
    "body": ["renpy.restart_interaction() # 刷新当前界面", ""],
    "description": ["刷新当前界面"]
  }
}
