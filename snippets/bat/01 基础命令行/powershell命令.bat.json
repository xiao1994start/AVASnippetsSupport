{
  "powershell定义变量": {
    "prefix": ["ps_let_", "ps_nc_", "ps_var_"],
    "body": ["\\$${1:val} = $0"],
    "description": ["powershell定义变量"]
  },
  "powershell-false": {
    "prefix": ["ps_ff_false"],
    "body": ["\\$false"],
    "description": ["powershell-false"]
  },
  "powershell-true": {
    "prefix": ["ps_tt_true"],
    "body": ["\\$true"],
    "description": ["powershell-true"]
  },
  "powershell-数组": {
    "prefix": ["ps_array_", "ps_list_"],
    "body": ["@($0)"],
    "description": ["powershell-数组"]
  },
  "powershell-对象": {
    "prefix": ["ps_object_", "ps_dict_"],
    "body": ["[pscustomobject]@{'${1:属性名}'='${2:属性值}'}"],
    "description": ["powershell-对象"]
  },
  "powershell写入文本": {
    "prefix": ["powershell_write_text", "ps_w_text"],
    "body": [
      "setlocal DisableDelayedExpansion",
      "@REM  * 临时禁用延迟扩展-避免感叹号被展开为环境变量",
      "@REM  = 转义符: 当写入内容中存在单引号时''...''; 当写入内容中存在双引号时\\\"...\\\"",
      "set \"TARGET_FILE=${1:写入文件路径_后缀}\"",
      "powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "  \"<# \\$lines = @('写入文件内容') #>\" ^",
      "  \"\\$lines = @(\" ^",
      "  \"  '${2:写入文件内容} ',\" ^",
      "  \"  ''\" ^",
      "  \") -join [Environment]::NewLine;\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$filePath, \\$lines, [System.Text.Encoding]::UTF8)\"",
      "setlocal EnableDelayedExpansion",
      ""
    ],
    "description": ["powershell写入文本"]
  },
  "powershell写入JSON": {
    "prefix": ["powershell_write_json", "ps_w_json"],
    "body": [
      "setlocal DisableDelayedExpansion",
      "set \"JSON_FILE=${1:JSON_文件路径}\"",
      "@REM  ? 变量\\$json获取JSON内容:  \\$json = Get-Content -Raw -Encoding UTF8 \\$path | ConvertFrom-Json;",
      "@REM  ? 如果 '属性名' 不存在 :  if (-not \\$json[.二级属性名].PSObject.Properties['属性名']) {};",
      "@REM  ? 添加属性:   \\$json[.二级属性名] | Add-Member -MemberType NoteProperty -Name \"属性名\" -Value \"属性值\"",
      "@REM  * -Value ::字符串='content'  数字=0  布尔值=\\$false/\\$true",
      "@REM  * -Value （建议括号）::空数组=(@())/@()  数组=(@('a','b'))/@('a','b')",
      "@REM  * -Value （必须括号）::空对象=([pscustomobject]@{})  复杂对象=([pscustomobject]@{ name='x'; config=[pscustomobject]@{} })",
      "@REM  - 或 \\$ 开头的参数，都可以嵌套在 () 内",
      "powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$path = \\$env:JSON_FILE;\" ^",
      "  \"\\$json = Get-Content -Raw -Encoding UTF8 \\$path | ConvertFrom-Json;\" ^",
      "  \"if (\\$null -eq \\$json) { \\$json = [pscustomobject]@{} };\" ^",
      "  \"if (-not \\$json.PSObject.Properties['属性名']) { Add-Member -InputObject \\$json -MemberType NoteProperty -Name 属性名 -Value ('属性值') };\" ^",
      "  \"\\$json | ConvertTo-Json -Depth 100 | Set-Content -Path \\$path -Encoding UTF8\"",
      "setlocal EnableDelayedExpansion",
      ""
    ],
    "description": ["powershell写入JSON"]
  }
}
