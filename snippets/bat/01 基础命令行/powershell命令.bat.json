{
  "powershell写入文件": {
    "prefix": ["powershell_write_text"],
    "body": [
      "(   setlocal DisableDelayedExpansion",
      "    @REM  setlocal DisableDelayedExpansion::临时禁用延迟扩展-避免感叹号被展开为环境变量",
      "    set \"TARGET_FILE=${1:写入文件路径_后缀}\"",
      "    @REM  = REM  = 转义符: 当写入内容中存在单引号时''...''; 当写入内容中存在双引号时\\\"...\\\"",
      "    powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "        \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "        \"\\$content = @(\" ^",
      "        \"  '${2:内容} ',\" ^",
      "        \"  '${3:内容} ',\" ^",
      "        \"  ''\" ^",
      "        \");\" ^",
      "    \"[System.IO.File]::WriteAllLines(\\$filePath, \\$content, [System.Text.Encoding]::UTF8)\"",
      ") && setlocal EnableDelayedExpansion",
      ""
    ],
    "description": ["powershell写入文件"]
  }
}
