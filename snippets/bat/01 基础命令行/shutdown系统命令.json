{
  "关机": {
    "prefix": ["shutdown_ST"],
    "body": ["shutdown -S -T ${1:10} -F"],
    "description": "关机"
  },
  "重启": {
    "prefix": ["shutdown_RT"],
    "body": ["shutdown -R -T ${1:10}"],
    "description": "重启"
  },
  "注销": {
    "prefix": ["shutdown_LT"],
    "body": ["shutdown -L -T ${1:10}"],
    "description": "注销"
  },
  "定时关机": {
    "prefix": ["shutdown_At"],
    "body": ["at ${1:23:00} shutdown -S"],
    "description": "定时关机"
  },
  "取消所有的shutdown命令": {
    "prefix": ["shutdown_all"],
    "body": ["shutdown -A"],
    "description": "取消所有的shutdown命令"
  }
}
