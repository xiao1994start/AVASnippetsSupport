{
  "python-embed 嵌入式环境启动": {
    "prefix": ["set call python -venv--embed", "set call python -VE--embed"],
    "body": [
      "@REM * 定义 Python 环境变量",
      "set \"local_python=%~dp0_python\"",
      "",
      "set \"SYSTEM_PATH=%PATH%\"",
      "@REM set \"SYSTEM_PATH=%CommonProgramFiles(x86)%\\Intel\\Shared Libraries\\bin32;%CommonProgramFiles(x86)%\\Intel\\Shared Libraries\\bin;%SystemRoot%;%SystemRoot%\\system32;%SystemRoot%\\System32\\Wbem;%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\;%SystemRoot%\\System32\\OpenSSH\\\"",
      "set \"PYTHON_PATH=!local_python!\\;!local_python!\\Scripts\\;\"",
      "set \"PATH=%PYTHON_PATH%;%SYSTEM_PATH%;\"",
      "ECHO python 版本号",
      "call python --version",
      "ECHO pip 版本号",
      "@REM *当提示无法使用 pip 命令时:",
      "@REM *    1.尝试初始化 pip 配置 call python \"!local_python!\\get-pip.py\"",
      "@REM *    2.尝试使用命令 call python -m pip",
      "@REM *    python -m 运行模块 启动虚拟环境",
      "@REM *    python -s 忽略用户 site-packages 避免不同版本的模块冲突",
      "@REM *    python -c 运行指令 ",
      "call python -m pip install \"pip\" --upgrade",
      "call python -m pip --version",
      "",
      "",
      "CALL \"!local_python!\\python.exe\" ${1:py脚本路径} ${2:参数}",
      "",
      ""
    ],
    "description": "python-embed 嵌入式环境启动"
  }
}
