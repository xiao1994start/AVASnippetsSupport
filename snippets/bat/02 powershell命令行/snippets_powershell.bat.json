{
  "powershell 定义变量": {
    "prefix": ["ps_let_"],
    "body": ["\\$${1:val} = ${0}"],
    "description": ["powershell 定义变量"]
  },
  "powershell false": {
    "prefix": ["ps_ff_false"],
    "body": ["\\$false"],
    "description": ["powershell false"]
  },
  "powershell true": {
    "prefix": ["ps_tt_true"],
    "body": ["\\$true"],
    "description": ["powershell true"]
  },
  "powershell 数组": {
    "prefix": ["ps_array_", "ps_list_"],
    "body": ["@(${0})"],
    "description": ["powershell 数组"]
  },
  "powershell 对象": {
    "prefix": ["ps_object_", "ps_dict_"],
    "body": ["[pscustomobject]@{'${1:属性名}'=${2:属性值}}"],
    "description": ["powershell 对象"]
  },
  "powershell 写入文本(UTF8)": {
    "prefix": ["powershell_write_text", "ps_w_text"],
    "body": [
      "setlocal DisableDelayedExpansion",
      "@REM  * 临时禁用延迟扩展-避免感叹号被展开为环境变量",
      "@REM  = 转义符: 当写入内容中存在单引号时''...''; 当写入内容中存在双引号时\\\"...\\\"",
      "set \"TARGET_FILE=${1:写入文件路径_后缀}\"",
      "powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "\"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "\"\\$lines = @(\" ^",
      "\"  '${2:写入文件内容} ',\" ^",
      "\"  ''\" ^",
      "\") -join [Environment]::NewLine;\" ^",
      "\"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "\"[System.IO.File]::WriteAllText(\\$filePath, [string]\\$lines, \\$utf8NoBom)\"",
      "setlocal EnableDelayedExpansion"
    ],
    "description": ["powershell 写入文本(UTF8)"]
  },
  "powershell 增量写入文本(UTF8)": {
    "prefix": ["powershell_appand_text", "ps_a_text"],
    "body": [
      "setlocal DisableDelayedExpansion",
      "set \"TARGET_FILE=${1:增量写入文件路径_后缀}\"",
      "powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "\"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "\"\\$line = '${2:增量写入文件内容}';\" ^",
      "\"\\$nl = [Environment]::NewLine;\" ^",
      "\"\\$content = [System.IO.File]::ReadAllText(\\$filePath);\" ^",
      "\"\\$exists = \\$false;\" ^",
      "\"foreach (\\$l in (\\$content -split '\\r?\\n')) {\" ^",
      "\"  if (\\$l.Trim() -eq \\$line) { \\$exists = \\$true; break; };\" ^",
      "\"};\" ^",
      "\"if (-not \\$exists) {\" ^",
      "\"  \\$prefix = '';\" ^",
      "\"  if (\\$content.Length -gt 0 -and -not \\$content.EndsWith([string][char]10)) { \\$prefix = \\$nl; };\" ^",
      "\"  [System.IO.File]::AppendAllText(\\$filePath, \\$prefix + \\$line + \\$nl, (New-Object System.Text.UTF8Encoding(\\$false)));\" ^",
      "\"}\"",
      "setlocal EnableDelayedExpansion"
    ],
    "description": ["powershell 增量写入文本(UTF8)"]
  },
  "powershell 查找并插入字符串": {
    "prefix": ["powershell_findandinsert_text", "ps_f_text"],
    "body": [
      "setlocal DisableDelayedExpansion",
      "set \"TARGET_FILE=${1:查找并插入字符串文件路径_后缀}\"",
      "powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "\"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "\"\\$importLine = \\\"${2:查找并插入字符串内容}\\\";\" ^",
      "\"\\$content = [System.IO.File]::ReadAllText(\\$filePath);\" ^",
      "\"if (\\$content.Contains(\\$importLine)) { exit 0 };\" ^",
      "\"\\$commented = [regex]::Replace(\\$content, '(?m)^(?=[ \\t]*\\S)', '//');\" ^",
      "\"\\$result = \\$commented.TrimEnd() + [Environment]::NewLine + \\$importLine + [Environment]::NewLine;\" ^",
      "\"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "\"[System.IO.File]::WriteAllText(\\$filePath, [string]\\$result, \\$utf8NoBom)\"",
      "setlocal EnableDelayedExpansion",
      ""
    ],
    "description": "powershell 查找并插入字符串"
  },
  "powershell 写入文本(GBK)": {
    "prefix": ["powershell_write_text-GBK", "ps_w_text-GBK"],
    "body": [
      "setlocal DisableDelayedExpansion",
      "set \"TARGET_FILE=${1:写入文件路径_后缀}\"",
      "powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "\"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "\"\\$lines = @(\" ^",
      "\"  '${2:写入文件内容} ',\" ^",
      "\"  ''\" ^",
      "\") -join [Environment]::NewLine;\" ^",
      "\"\\$gbk = [System.Text.Encoding]::GetEncoding(936);\" ^",
      "\"[System.IO.File]::WriteAllText(\\$filePath, [string]\\$lines, \\$gbk)\"",
      "setlocal EnableDelayedExpansion"
    ],
    "description": ["powershell 写入文本(GBK)"]
  },
  "powershell 写入JSON": {
    "prefix": ["powershell_json", "ps_json"],
    "body": [
      "setlocal DisableDelayedExpansion",
      "set \"JSON_FILE=${1:JSON_文件路径}\"",
      "@REM  ? 变量\\$json获取JSON内容:  \\$json = Get-Content -Raw -Encoding UTF8 \\$path | ConvertFrom-Json;",
      "@REM  ? 如果 '属性名' 不存在 :  if (-not \\$json[.二级属性名].PSObject.Properties['属性名']) {};",
      "@REM  ? 添加属性:  \\$json[.二级属性名] | Add-Member -MemberType NoteProperty -Name \"属性名\" -Value \"属性值\"",
      "@REM  * -Value ::字符串='content'  数字=0  布尔值=\\$false/\\$true",
      "@REM  * -Value （建议括号）::空数组=(@())/@()  数组=(@('a','b'))/@('a','b')",
      "@REM  * -Value （必须括号）::空对象=([pscustomobject]@{})  复杂对象=([pscustomobject]@{ name='x'; config=[pscustomobject]@{} })",
      "@REM  - 或 \\$ 开头的参数，都可以嵌套在 () 内",
      "@REM  * -replace :: 替换字符串中的子字符串",
      "powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "\"\\$path = \\$env:JSON_FILE;\" ^",
      "\"\\$json = Get-Content -Raw -Encoding UTF8 \\$path;\" ^",
      "\"\\$pattern = '(?<s>\\x22(?:\\\\\\.|[^\\x22\\\\])*\\x22)|(?<b>/\\*(?!\\*/)[\\s\\S]*?\\*/)|(?<l>//[^\\r\\n]*)';\" ^",
      "\"\\$evaluator = [System.Text.RegularExpressions.MatchEvaluator]{ param(\\$m) if (\\$m.Groups['s'].Success) { \\$m.Value } else { '' } };\" ^",
      "\"\\$json = [regex]::Replace(\\$json, \\$pattern, \\$evaluator);\" ^",
      "\"\\$json = \\$json | ConvertFrom-Json;\" ^",
      "\"if (\\$null -eq \\$json) { \\$json = [pscustomobject]@{} };\" ^",
      "\"\\$obj = \\$json;\" ^",
      "\"\\$key = '属性名';\" ^",
      "\"\\$val = (属性值);\" ^",
      "\"if (-not \\$obj.PSObject.Properties[\\$key]) { Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force };\" ^",
      "\"\\$obj = \\$json.二级属性名;\" ^",
      "\"\\$key = '属性名';\" ^",
      "\"\\$val = (属性值);\" ^",
      "\"Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force;\" ^",
      "\"\\$json = \\$json | ConvertTo-Json -Depth 100;\" ^",
      "\"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "\"[System.IO.File]::WriteAllText(\\$path, [string]\\$json, \\$utf8NoBom)\"",
      "setlocal EnableDelayedExpansion"
    ],
    "description": ["powershell 写入JSON"]
  }
}
