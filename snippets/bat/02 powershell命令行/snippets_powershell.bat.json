{
  "powershell 定义变量": {
    "prefix": ["ps_let_"],
    "body": ["\\$${1:val} = ${0}"],
    "description": ["powershell 定义变量"]
  },
  "powershell false": {
    "prefix": ["ps_ff_false"],
    "body": ["\\$false"],
    "description": ["powershell false"]
  },
  "powershell true": {
    "prefix": ["ps_tt_true"],
    "body": ["\\$true"],
    "description": ["powershell true"]
  },
  "powershell 数组": {
    "prefix": ["ps_array_", "ps_list_"],
    "body": ["@(${0})"],
    "description": ["powershell 数组"]
  },
  "powershell 对象": {
    "prefix": ["ps_object_", "ps_dict_"],
    "body": ["[pscustomobject]@{'${1:属性名}'=${2:属性值}}"],
    "description": ["powershell 对象"]
  },
  "powershell 写入文本(UTF8)": {
    "prefix": ["ps_w_text"],
    "body": [
      "set \"TARGET_FILE=${1:写入文件路径_后缀}\"",
      "powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$lines = '${2:首行内容} ',\" ^",
      "  \"'${3:多行内容} ',\" ^",
      "  \"'';\" ^",
      "  \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$filePath, (\\$lines -join [Environment]::NewLine), \\$utf8NoBom)\"",
      "@REM  ! powershell 下方代码注意缩进",
      "@REM  * '/\" 转义 ''/\"\"或\\\" ; % 转义 %% ; ! 转义 ^!; !== 转义 ^!^=="
    ],
    "description": ["powershell 写入文本(UTF8)"]
  },
  "powershell 查找并插入字符串": {
    "prefix": ["ps_regex_text"],
    "body": [
      "set \"TARGET_FILE=${1:写入文件路径_后缀}\"",
      "powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$findLine = \\\"${2:查找并插入字符串内容}\\\";\" ^",
      "  \"\\$insertLine = \\\"${3:插入字符串内容}\\\";\" ^",
      "  \"\\$comment = '//';\" ^",
      "  \"\\$filePath = \\$env:TARGET_FILE;\" ^",
      "  \"\\$content = [System.IO.File]::ReadAllText(\\$filePath);\" ^",
      "  \"if (\\$content.Contains(\\$findLine)) { exit 0 };\" ^",
      "  \"\\$commented = [regex]::Replace(\\$content, '(?m)^(?=[ \\t]*\\S)', \\$comment);\" ^",
      "  \"\\$result = \\$commented.TrimEnd() + [Environment]::NewLine + \\$insertLine + [Environment]::NewLine;\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$filePath, \\$result, \\$utf8NoBom)\"",
      "@REM  ! powershell 下方代码注意缩进",
      "@REM  * '/\" 转义 ''/\"\"或\\\" ; % 转义 %% ; ! 转义 ^!; !== 转义 ^!^=="
    ],
    "description": "powershell 查找并插入字符串"
  },
  "powershell 写入JSON": {
    "prefix": ["ps_json"],
    "body": [
      "set \"JSON_FILE=${1:JSON_文件路径}\"",
      "powershell -NoProfile -ExecutionPolicy Bypass -Command ^",
      "  \"\\$path = \\$env:JSON_FILE;\" ^",
      "  \"\\$raw  = Get-Content -Raw -Encoding UTF8 \\$path;\" ^",
      "  \"<#  @REM  *  [char]0x22 ASCII \"\"    #>\" ^",
      "  \"\\$q    = [char]0x22;\" ^",
      "  \"<#  @REM  *  [char]0x5C ASCII \\\\    #>\" ^",
      "  \"\\$s    = [char]0x5C;\" ^",
      "  \"\\$str  = \\$q + '(?:[^' + \\$q + \\$s + \\$s + ']|' + \\$s + \\$s + '.)*' + \\$q;\" ^",
      "  \"\\$commentPat = '(?<s>' + \\$str + ')|//[^\\r\\n]*|/\\*[\\s\\S]*?\\*/';\" ^",
      "  \"\\$commaPat   = '(?<s>' + \\$str + ')|(?<t>,)(?=\\s*[}\\]])';\" ^",
      "  \"\\$dropNonString = [System.Text.RegularExpressions.MatchEvaluator]{ param(\\$m) if (\\$m.Groups['s'].Success) { \\$m.Value } else { '' } };\" ^",
      "  \"\\$clean = [regex]::Replace(\\$raw,   \\$commentPat, \\$dropNonString);\" ^",
      "  \"\\$clean = [regex]::Replace(\\$clean, \\$commaPat,   \\$dropNonString);\" ^",
      "  \"\\$json  = \\$clean | ConvertFrom-Json;\" ^",
      "  \"<#  @REM  -  配置JSON    #>\" ^",
      "  \"\\$obj = \\$json;\" ^",
      "  \"\\$key = '${2:子属性名}';\" ^",
      "  \"\\$val = (${3:[pscustomobject]@{}});\" ^",
      "  \"if (-not \\$obj.PSObject.Properties[\\$key]) { Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force };\" ^",
      "  \"\\$obj = \\$json.${4:子属性名};\" ^",
      "  \"\\$key = '${5:二级属性名}';\" ^",
      "  \"\\$val = (${6:'二级属性值'});\" ^",
      "  \"Add-Member -InputObject \\$obj -MemberType NoteProperty -Name \\$key -Value \\$val -Force;\" ^",
      "  \"<#  @REM  -  写入JSON配置文件    #>\" ^",
      "  \"\\$utf8NoBom = New-Object System.Text.UTF8Encoding(\\$false);\" ^",
      "  \"[System.IO.File]::WriteAllText(\\$path, (\\$json | ConvertTo-Json -Depth 100), \\$utf8NoBom)\"",
      "@REM  ! powershell 下方代码注意缩进",
      "@REM  * '/\" 转义 ''/\"\"或\\\" ; % 转义 %% ; ! 转义 ^!（不生效是尝试 ^^!）",
      "@REM  ? 变量\\$json获取JSON内容:  \\$json = Get-Content -Raw -Encoding UTF8 \\$path | ConvertFrom-Json;",
      "@REM  ? 如果 '属性名' 不存在 :  if (-not \\$json[.二级属性名].PSObject.Properties['属性名']) {};",
      "@REM  ? 添加属性:  \\$json[.二级属性名] | Add-Member -MemberType NoteProperty -Name \"属性名\" -Value \"属性值\"",
      "@REM  * -Value ::字符串='content'  数字=0  布尔值=\\$false/\\$true",
      "@REM  * -Value （建议括号）::空数组=(@())/@()  数组=(@('a','b'))/@('a','b')",
      "@REM  * -Value （必须括号）::空对象=([pscustomobject]@{})  复杂对象=([pscustomobject]@{ name='x'; config=[pscustomobject]@{} })",
      "@REM  - 或 \\$ 开头的参数，都可以嵌套在 () 内",
      "@REM  * -replace :: 替换字符串中的子字符串"
    ],
    "description": ["powershell 写入JSON"]
  }
}
