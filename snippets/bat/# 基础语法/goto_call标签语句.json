{
  "跳转到标签": {
    "prefix": ["goto "],
    "body": ["goto :$0"],
    "description": ["跳转到标签"]
  },
  "临时运行标签": {
    "prefix": ["call label"],
    "body": ["call :$0"],
    "description": [
      "临时运行标签",
      "\t call :label 临时跳转标签代码段需要使用 goto :eof 为结束语句",
      "\t 使用 call :label 的代码上方需要使用 EXIT 或 EXIT /B 0 结束运行"
    ]
  },
  "新建子标签": {
    "prefix": ["new label"],
    "body": [":label", "$0", "goto :eof"],
    "description": ["新建子标签"]
  },
  "从子标签/子程序中返回": {
    "prefix": ["return", "goto eof"],
    "body": ["goto :eof"],
    "description": ["从子标签/子程序中返回"]
  },
  "批量拖入文件处理": {
    "prefix": ["input files"],
    "body": [
      "@REM * 初始化文件标记变量（0 表示尚未处理任何文件）",
      "set \"has_input=0\"",
      "",
      ":process_files",
      "if \"%~1\"==\"\" goto :check_result",
      "",
      "@REM * 只要接收到参数，就将标记设为 1",
      "set \"has_input=1\"",
      "",
      "set \"fullpath=%~f1\"",
      "set \"fullfilename=%~nx1\"",
      "set \"filename=%~n1\"",
      "set \"filepath=%~dp1\"",
      "set \"filesize=%~z1\"",
      "set \"fileext=%~x1\"",
      "",
      "shift",
      "goto :process_files",
      "",
      ":check_result",
      "if \"!has_input!\"==\"1\" ( goto :true_input ) else ( goto :false_input )",
      "",
      ":false_input",
      "ECHO 未检测到拖入文件或文件夹",
      "goto :end_script",
      "",
      ":true_input",
      "ECHO 成功检测并处理拖入的文件/文件夹",
      "ECHO ----------------------------------------",
      "ECHO 完整路径  ~fi  : !fullpath!",
      "ECHO 文件      ~nxi : !fullfilename!",
      "ECHO 仅文件名  ~ni  : !filename!",
      "ECHO 文件目录  ~dpi : !filepath!",
      "ECHO 文件大小  ~zi  : !filesize! 字节",
      "ECHO 扩展名    ~xi  : !fileext!",
      "ECHO ----------------------------------------",
      "",
      "",
      "",
      "",
      "",
      ":end_script",
      "goto :eof",
      ""
    ],
    "description": "批量拖入文件处理"
  }
}
