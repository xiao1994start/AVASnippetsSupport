{
  "node.js 临时环境设置": {
    "prefix": ["init node --Portable"],
    "body": [
      "@REM * 定义 node 环境变量",
      "set \"local_node=%~dp0_node\"",
      "",
      "@REM * 添加临时系统环境变量",
      "set \"SYSTEM_PATH=%PATH%\"",
      "@REM set \"SYSTEM_PATH=%CommonProgramFiles(x86)%\\Intel\\Shared Libraries\\bin32;%CommonProgramFiles(x86)%\\Intel\\Shared Libraries\\bin;%SystemRoot%;%SystemRoot%\\system32;%SystemRoot%\\System32\\Wbem;%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\;%SystemRoot%\\System32\\OpenSSH\\\"",
      "set \"NODE_PATH=!local_node!\\;!local_node!\\node_modules\\;\"",
      "set \"PATH=%NODE_PATH%;%SYSTEM_PATH%;\"",
      "ECHO 环境测试",
      "ECHO = node 版本号:",
      "call node -v",
      "ECHO = npm 版本号:",
      "call npm -v",
      "ECHO - 清理 npm 缓存",
      "call npm cache clean --force",
      "ECHO + 升级 npm",
      "call npm i --global npm --registry https://registry.npmmirror.com/",
      "ECHO = 检查 软件仓库位置:",
      "call npm root -g",
      "",
      ""
    ],
    "description": ["node.js 临时环境设置"]
  }
}
